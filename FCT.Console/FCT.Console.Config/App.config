<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
  </configSections>
  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" />
    <add name="StorageConnectionString" connectionString="UseDevelopmentStorage=true;" />
    <add name="PaymentGenerationDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PaymentManagementPolicyContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="MonitoringDeliverablesDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="ContractManagementDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PerformanceManagementDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="ContractRequestDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="DocumentsDomainDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="OperationsDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
    <contexts>
      <context type="SFA.FCT.AllocationDeliveryDomain.Common.DataStore.MonitoringDeliverablesDbContext, AllocationDeliveryDomain.Common" disableDatabaseInitialization="true" />
      <context type="PaymentGenerationDomain.Integration.DataStore.PaymentGenerationDbContext, PaymentGenerationDomain.Integration.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.PaymentManagementDomain.PolicyCache.DataStore.PaymentManagementPolicyContext, PaymentManagementDomain.PolicyCache.DataStore" disableDatabaseInitialization="true" />
      <context type="ContractManagement.DataStore.ContractManagementDbContext, ContractManagement.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.PerformanceManagementDomain.DataStore.PerformanceManagementDbContext, PerformanceManagementDomain.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.ContractRequestDomain.DataStore.ContractRequestDbContext, ContractRequestDomain.DataStore" disableDatabaseInitialization="true" />
    </contexts>
  </entityFramework>
  <runtime>
