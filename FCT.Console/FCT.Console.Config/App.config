  <appSettings>
	<add key="NServiceBus/License" value="" />
    <add key="StorageTableSuffix" value="DCI" />    
    <add key="ShouldCreateFoldersPastActivityCloseDate" value="true" />
    <add key="ida:ClientId_CrmOnline" value="b2312120-4944-4f8e-8436-d78a19722c1d" />
