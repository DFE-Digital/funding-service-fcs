{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentTag": {
      "type": "string"
    },
    "parentBusinessTag": {
      "type": "string"
    },
    "portfolioTag": {
      "type": "string"
    },
    "productTag": {
      "type": "string"
    },
    "serviceLineTag": {
      "type": "string"
    },
    "appServicePlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared App Service plan for Function Apps"
      }
    },
    "deploymentUrlBase": {
      "type": "string",
      "metadata": {
        "description": "The root url which holds all of the linked templates used by this template, a parameter to ease testing."
      }
    },
    "storageAccount": {
      "type": "string"
    }
  },
  "variables": {
    "environmentShortCode": "[split(resourceGroup().name, '-')[2]]",
    "functionAppName": "[concat('fcs-', variables('subscriptionShortCode'), '-', variables('environmentShortCode'), '-fcsworker-fa')]",
    "sharedRG": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-rg')]",
    "subscriptionShortCode": "[split(resourceGroup().name, '-')[1]]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2017-05-10",
      "name": "Deploy_fcsworker_function_app",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'function-app.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "functionAppName": {
            "value": "[variables('functionAppName')]"
          },
          "appServicePlanName": {
            "value": "[parameters('appServicePlanName')]"
          },
          "appServicePlanResourceGroup": {
            "value": "[variables('sharedRG')]"
          },
          "functionAppAppSettings": {
            "value": [
              {
                "name": "FUNCTIONS_EXTENSION_VERSION",
                "value": "~4"
              },
              {
                "name": "FUNCTIONS_WORKER_RUNTIME",
                "value": "dotnet"
              },
              {
                "name": "FCTOptions:AzureWebJobsStorage",
                "value": "[parameters('storageAccount')]"
              }
            ]
          }
        }
      }
    }
  ]
}