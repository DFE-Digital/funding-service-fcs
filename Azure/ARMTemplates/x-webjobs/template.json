{
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "applicationInsightsName": {
            "type": "string",
            "metadata": {
                "description": "Name of the shared app insights instance"
            }
        },
        "applogToBlob": {
            "type": "string",
            "defaultValue": "Warning",
            "metadata": {
                "description": "Log Application logs to Blob, default is off"
            }
        },
        "appServiceAllMetricsSetting": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "All Metrics diagnostic setting"
            }
        },
        "appServiceAppLogsSetting": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "App Service app logs diagnostic setting"
            }
        },
        "appServiceAuditLogsSetting": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "App Service audit logs diagnostic setting"
            }
        },
        "appServiceConsoleLogsSetting": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "App Service console logs diagnostic setting"
            }
        },
        "appServiceFileAuditLogsSetting": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "App Service file audit logs diagnostic setting"
            }
        },
        "appServiceLogRetentionDays": {
            "type": "string",
            "defaultValue": "30"
        },
        "appServiceLogRetentionMb": {
            "type": "string",
            "defaultValue": "30"
        },
        "appServiceRetentionPolicyDays": {
            "type": "string",
            "defaultValue": "30"
        },
        "appServicePlanName": {
            "type": "string",
            "metadata": {
                "description": "Name of shared api hosting plan"
            }
        },
        "appServiceRetentionPolicyEnabled": {
            "type": "bool",
            "defaultValue": true
        },
        "deploymentUrlBase": {
            "type": "string"
        },
        "http20Enabled": {
            "type": "bool",
            "defaultValue": true
        },
        "ipSecurityRestrictionsSetting": {
            "type": "string",
            "defaultValue": "denyAllInbound",
            "allowedValues": [
                "denyAllInbound",
                "allowAll",
                "allowSNetOnly"
            ],
            "metadata": {
                "description": "one of the properties of the ipSecurityRestrictions variable below (eg denyAllInbound)"
            }
        },
        "logstorageAccountName": {
            "type": "string",
            "metadata": {
                "description": "Name of the local shared storage account for logs"
            }
        },
        "weblogToBlob": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "Log HTTP logs to Blob, default is off"
            }
        }
    },
    "variables": {
        "actionGroupName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-ag')]",
        "applogcontainerName": "[concat(variables('fundingAllocationAppServiceName'),'-application-logs')]",
        "appServicesVNetIntegrationSubnetId": "[resourceId(variables('sharedRG'), 'Microsoft.Network/virtualNetworks/subnets', variables('sharedVNetName'), 'appServiceVNetIntegration' )]",
        "environmentShortCode": "[split(resourceGroup().name, '-')[2]]",
        "fundingAllocationAppServiceName": "[concat('fcs-', variables('subscriptionShortCode'), '-', variables('environmentShortCode'), '-app-x-webjobs')]",
        "ipSecurityRestrictions": {
            "denyAllInbound": [
                {
                    "ipAddress": "0.0.0.0/0",
                    "action": "Deny",
                    "priority": 100,
                    "name": "Deny All Inbound"
                }
            ],
            "allowAll": [],
            "allowSNetOnly": [
                {
                    "vnetSubnetResourceId": "[variables('appServicesVNetIntegrationSubnetId')]",
                    "action": "Allow",
                    "priority": 100,
                    "name": "allow known subnet only"
                }
            ]
        },
        "keyVaultName": "[concat('fcs-', variables('subscriptionShortCode'), '-', variables('environmentShortCode'),'-kv')]",
        "logAnalyticsWorkspaceName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-la')]",
        "sharedRG": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-rg')]",
        "sharedVNetName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-vnet-01')]",
        "sharedWorkspaceID": "[resourceId(variables('sharedRG'),'Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]",
        "subscriptionShortCode": "[split(resourceGroup().name, '-')[1]]",
        "weblogcontainerName": "[concat(variables('fundingAllocationAppServiceName'),'-webserver-logs')]",
        "alertRules": [
            {
                "AlertName": "Average_Response_Time_x_webjobs",
                "MetricName": "HttpResponseTime",
                "Operator": "GreaterThan",
                "Description": "[concat('Average Response Time gt dynamic threshold on ', variables('fundingAllocationAppServiceName'))]",
                "Aggregation": "Average",
                "ResourceType": "Microsoft.Web/sites",
                "ResourceName": "[variables('fundingAllocationAppServiceName')]",
                "WindowSize": "PT5M"
            },
            {
                "AlertName": "Alerts_http_server_errors_x_webjobs",
                "MetricName": "Http5xx",
                "Operator": "GreaterThan",
                "Description": "[concat('Average https server errors gt dynamic threshold on ', variables('fundingAllocationAppServiceName'))]",
                "Threshold": "0",
                "Aggregation": "Average",
                "ResourceType": "Microsoft.Web/sites",
                "ResourceName": "[variables('fundingAllocationAppServiceName')]",
                "WindowSize": "PT5M"
            }
        ]
    },
    "resources": [
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2017-05-10",
            "name": "Deploy_webjobs_appservice",
            "dependsOn": [],
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('deploymentUrlBase'),'app-service.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "appServiceName": {
                        "value": "[variables('fundingAllocationAppServiceName')]"
                    },
                    "appServicePlanName": {
                        "value": "[parameters('appServicePlanName')]"
                    },
                    "appServicePlanResourceGroup": {
                        "value": "[variables('sharedRG')]"
                    },
                    "deployStagingSlot": {
                        "value": false
                    },
                    "ipSecurityRestrictions": {
                        "value": "[variables('ipSecurityRestrictions')[parameters('ipSecurityRestrictionsSetting')]]"
                    },
                    "subnetResourceId": {
                        "value": "[variables('appServicesVNetIntegrationSubnetId')]"
                    },
                    "appServiceAppSettings": {
                        "value": [
                            {
                                "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                                "value": "[reference(resourceId('Microsoft.Insights/components', parameters('applicationInsightsName')), '2015-05-01').InstrumentationKey]"
                            },
                            {
                                "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                                "value": "[concat('InstrumentationKey=', reference(resourceId('Microsoft.Insights/components', parameters('applicationInsightsName')), '2015-05-01').InstrumentationKey)]"
                            },
                            {
                                "name": "WEBSITE_LOAD_CERTIFICATES",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', variables('keyVaultName'), ';SecretName=fcscpdscertthumbprint)')]"
                            },
                            {
                                "name": "Graph:Scope",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', variables('keyVaultName'), ';SecretName=GraphScope)')]"
                            },
                            {
                                "name": "WEBSITE_NODE_DEFAULT_VERSION",
                                "value": "0.10.32",
                                "slotSetting": false
                            },
                            {
                                "name": "DIAGNOSTICS_AZUREBLOBCONTAINERSASURL",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', variables('keyVaultName'), ';SecretName=DIAGNOSTICSAZUREBLOBCONTAINERSASURL)')]",
                                "slotSetting": false
                            },
                            {
                                "name": "DIAGNOSTICS_AZUREBLOBRETENTIONINDAYS",
                                "value": "30",
                                "slotSetting": false
                            },
                            {
                                "name": "WEBSITE_HTTPLOGGING_CONTAINER_URL",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', variables('keyVaultName'), ';SecretName=WEBSITEHTTPLOGGINGCONTAINERURL)')]",
                                "slotSetting": false
                            },
                            {
                                "name": "WEBSITE_HTTPLOGGING_RETENTION_DAYS",
                                "value": "30",
                                "slotSetting": false
                            }
                        ]
                    },
                    "workspaceId": {
                        "value": "[variables('sharedWorkspaceID')]"
                    },
                    "appServiceConsoleLogsSetting": {
                        "value": "[parameters('appServiceConsoleLogsSetting')]"
                    },
                    "appServiceAppLogsSetting": {
                        "value": "[parameters('appServiceAppLogsSetting')]"
                    },
                    "appServiceFileAuditLogsSetting": {
                        "value": "[parameters('appServiceFileAuditLogsSetting')]"
                    },
                    "appServiceAuditLogsSetting": {
                        "value": "[parameters('appServiceAuditLogsSetting')]"
                    },
                    "allMetricsSetting": {
                        "value": "[parameters('appServiceAllMetricsSetting')]"
                    },
                    "retentionPolicyEnabled": {
                        "value": "[parameters('appServiceRetentionPolicyEnabled')]"
                    },
                    "retentionPolicyDays": {
                        "value": "[parameters('appServiceRetentionPolicyDays')]"
                    },
                    "http20Enabled": {
                        "value": "[parameters('http20Enabled')]"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2017-05-10",
            "name": "Deploy_webjobs_appservice_Identity_To_EnvKeyVault",
            "dependsOn": [
                "Deploy_webjobs_appservice"
            ],
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('deploymentUrlBase'),'keyvault-accesspolicies.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "keyVaultName": {
                        "value": "[variables('keyVaultName')]"
                    },
                    "accessPolicies": {
                        "value": [
                            {
                                "tenantId": "[reference(concat('Deploy_webjobs_appservice')).outputs.managedServiceIdentity.value.tenantId]",
                                "objectId": "[reference(concat('Deploy_webjobs_appservice')).outputs.managedServiceIdentity.value.principalId]",
                                "permissions": {
                                    "secrets": [
                                        "get"
                                    ]
                                }
                            }
                        ]
                    }
                }
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2017-05-10",
            "name": "Deploy_applicationlog_blob_container",
            "dependsOn": [],
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('deploymentUrlBase'),'storage-container.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "storageAccountName": {
                        "value": "[parameters('logstorageAccountName')]"
                    },
                    "containerName": {
                        "value": "[variables('applogcontainerName')]"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2017-05-10",
            "name": "Deploy_weblog_blob_container",
            "dependsOn": [],
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('deploymentUrlBase'),'storage-container.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "storageAccountName": {
                        "value": "[parameters('logstorageAccountName')]"
                    },
                    "containerName": {
                        "value": "[variables('weblogcontainerName')]"
                    }
                }
            }
        },
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2017-05-10",
            "name": "Deploy_App_Service_classic_logging",
            "dependsOn": [
                "Deploy_webjobs_appservice"
            ],
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(parameters('deploymentUrlBase'),'app-service-logging.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "appServiceResourceName": {
                        "value": "[variables('fundingAllocationAppServiceName')]"
                    },
                    "appServiceLogRetentionDays": {
                        "value": "[parameters('appServiceLogRetentionDays')]"
                    },
                    "appServiceLogRetentionMb": {
                        "value": "[parameters('appServiceLogRetentionMb')]"
                    },
                    "applogToBlob": {
                        "value": "[parameters('applogToBlob')]"
                    },
                    "weblogToBlob": {
                        "value": "[parameters('weblogToBlob')]"
                    },
                    "sharedLogStorageAccount": {
                        "value": "[parameters('logstorageAccountName')]"
                    }
                }
            }
        },
        {
            "type": "microsoft.insights/metricAlerts",
            "apiVersion": "2018-03-01",
            "name": "[variables('alertRules')[copyIndex()].AlertName]",
            "dependsOn": [
                "Deploy_webjobs_appservice"
            ],
            "location": "global",
            "properties": {
                "description": "[variables('alertRules')[copyIndex()].Description]",
                "severity": 2,
                "enabled": true,
                "scopes": [
                    "[resourceId(resourceGroup().name, 'Microsoft.Web/sites', variables('fundingAllocationAppServiceName'))]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT5M",
                "criteria": {
                    "allOf": [
                        {
                            "alertSensitivity": "Medium",
                            "failingPeriods": {
                                "numberOfEvaluationPeriods": 4,
                                "minFailingPeriodsToAlert": 4
                            },
                            "name": "Metric1",
                            "metricNamespace": "Microsoft.Web/sites",
                            "metricName": "[variables('alertRules')[copyIndex()].MetricName]",
                            "dimensions": [],
                            "operator": "[variables('alertRules')[copyIndex()].Operator]",
                            "timeAggregation": "[variables('alertRules')[copyIndex()].Aggregation]",
                            "criterionType": "DynamicThresholdCriterion"
                        }
                    ],
                    "odata.type": "Microsoft.Azure.Monitor.MultipleResourceMultipleMetricCriteria"
                },
                "autoMitigate": true,
                "targetResourceType": "Microsoft.Web/sites",
                "targetResourceRegion": "[resourceGroup().location]",
                "actions": [
                    {
                        "actionGroupId": "[resourceId(variables('sharedRG'), 'Microsoft.Insights/actiongroups', variables('actionGroupName')) ]",
                        "webHookProperties": {}
                    }
                ]
            },
            "copy": {
                "name": "AlertRulesCopy",
                "count": "[length(variables('alertRules'))]"
            }
        }
    ]
}