{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentTag": {
      "type": "string"
    },
    "parentBusinessTag": {
      "type": "string"
    },
    "portfolioTag": {
      "type": "string"
    },
    "productTag": {
      "type": "string"
    },
    "serviceLineTag": {
      "type": "string"
    },
    "appServicecustomHostName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "the custom hostname or blank if one is not used"
      }
    },
    "appServicecertificateName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "the certificate Name"
      }
    },
    "allowedAudiences": {
      "type": "array",
      "metadata": {
        "description": "(array of string) the allowed audiences"
      }
    },
    "issuer": {
      "type": "string",
      "metadata": {
        "description": "the issuer of the clientId"
      }
    },
    "clientID": {
      "type": "string",
      "metadata": {
        "description": "(string) the clientId of the app registration in AAD"
      }
    },
    "authEnabled": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Is Auth enabled"
      }
    },
    "applicationInsightsName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared app insights instance"
      }
    },
    "appServiceAllMetricsSetting": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "All Metrics diagnostic setting"
      }
    },
    "appServiceAppLogsSetting": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "App Service app logs diagnostic setting"
      }
    },
    "appServiceAuditLogsSetting": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "App Service audit logs diagnostic setting"
      }
    },
    "appServiceConsoleLogsSetting": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "App Service console logs diagnostic setting"
      }
    },
    "appServiceFileAuditLogsSetting": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "App Service file audit logs diagnostic setting"
      }
    },
    "appServiceRetentionPolicyDays": {
      "type": "string",
      "defaultValue": "30"
    },
    "appServicePlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of shared api hosting plan"
      }
    },
    "appServiceRetentionPolicyEnabled": {
      "type": "bool",
      "defaultValue": true
    },
    "deploymentUrlBase": {
      "type": "string",
      "metadata": {
        "description": "The root url which holds all of the linked templates used by this template, a parameter to ease testing."
      }
    },
    "http20Enabled": {
      "type": "bool",
      "defaultValue": true
    },
    "appServiceHTTPLogsSetting": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "App Service http logs diagnostic setting"
      }
    }
  },
  "variables": {
    "actionGroupName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-ag')]",
    "appServicesVNetIntegrationSubnetId": "[resourceId(variables('sharedRG'), 'Microsoft.Network/virtualNetworks/subnets', variables('sharedVNetName'), 'appServiceVNetIntegration' )]",
    "environmentShortCode": "[split(resourceGroup().name, '-')[2]]",
    "orgwebapiAppServiceName": "[concat('fcs-', variables('subscriptionShortCode'), '-', variables('environmentShortCode'), '-app-org-webapi')]",
    "keyVaultName": "[concat('fcs-', variables('subscriptionShortCode'), '-', variables('environmentShortCode'),'-kv')]",
    "logAnalyticsWorkspaceName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-la')]",
    "sharedRG": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-rg')]",
    "sharedVNetName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-vnet-01')]",
    "sharedWorkspaceID": "[resourceId(variables('sharedRG'),'Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]",
    "subscriptionShortCode": "[split(resourceGroup().name, '-')[1]]",
    "alertRules": [
      {
        "AlertName": "Average_Response_Time_org_webapi",
        "MetricName": "HttpResponseTime",
        "Operator": "GreaterThan",
        "Description": "[concat('Average Response Time gt dynamic threshold on ', variables('orgwebapiAppServiceName'))]",
        "Aggregation": "Average",
        "ResourceType": "Microsoft.Web/sites",
        "ResourceName": "[variables('orgwebapiAppServiceName')]",
        "WindowSize": "PT5M",
        "Scopes": "[resourceId(resourceGroup().name, 'Microsoft.Web/sites', variables('orgwebapiAppServiceName'))]"
      },
      {
        "AlertName": "Alerts_http_server_errors_org_webapi",
        "MetricName": "Http5xx",
        "Operator": "GreaterThan",
        "Description": "[concat('Average https server errors gt dynamic threshold on ', variables('orgwebapiAppServiceName'))]",
        "Threshold": "0",
        "Aggregation": "Average",
        "ResourceType": "Microsoft.Web/sites",
        "ResourceName": "[variables('orgwebapiAppServiceName')]",
        "WindowSize": "PT5M",
        "Scopes": "[resourceId(resourceGroup().name, 'Microsoft.Web/sites', variables('orgwebapiAppServiceName'))]"
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2017-05-10",
      "name": "Deploy_org_webapi_appservice",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'app-service-premium.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "appServiceName": {
            "value": "[variables('orgwebapiAppServiceName')]"
          },
          "customHostName": {
            "value": "[parameters('appServicecustomHostName')]"
          },
          "certificateThumbprint": {
            "value": "[if(greater(length(parameters('appServicecertificateName')),0), reference(resourceId(variables('sharedRG'), 'Microsoft.Web/certificates', parameters('appServicecertificateName')), '2016-03-01').Thumbprint, 'placeholder')]"
          },
          "appServicePlanName": {
            "value": "[parameters('appServicePlanName')]"
          },
          "appServicePlanResourceGroup": {
            "value": "[variables('sharedRG')]"
          },
          "deployStagingSlot": {
            "value": false
          },
          "subnetResourceId": {
            "value": "[variables('appServicesVNetIntegrationSubnetId')]"
          },
          "appServiceAppSettings": {
            "value": [
              {
                "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                "value": "[reference(resourceId('Microsoft.Insights/components', parameters('applicationInsightsName')), '2015-05-01').InstrumentationKey]"
              },
              {
                "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                "value": "[concat('InstrumentationKey=', reference(resourceId('Microsoft.Insights/components', parameters('applicationInsightsName')), '2015-05-01').InstrumentationKey)]"
              },
              {
                "name": "APPINSIGHTS_PROFILERFEATURE_VERSION",
                "value": "1.0.0"
              },
              {
                "name": "APPINSIGHTS_SNAPSHOTFEATURE_VERSION",
                "value": "1.0.0"
              },
              {
                "name": "ApplicationInsightsAgent_EXTENSION_VERSION",
                "value": "~2"
              },
              {
                "name": "DiagnosticServices_EXTENSION_VERSION",
                "value": "~3"
              },
              {
                "name": "InstrumentationEngine_EXTENSION_VERSION",
                "value": "disabled"
              },
              {
                "name": "SnapshotDebugger_EXTENSION_VERSION",
                "value": "disabled"
              },
              {
                "name": "XDT_MicrosoftApplicationInsights_BaseExtensions",
                "value": "disabled"
              },
              {
                "name": "XDT_MicrosoftApplicationInsights_Java",
                "value": "1"
              },
              {
                "name": "XDT_MicrosoftApplicationInsights_Mode",
                "value": "recommended"
              },
              {
                "name": "XDT_MicrosoftApplicationInsights_NodeJS",
                "value": "1"
              },
              {
                "name": "XDT_MicrosoftApplicationInsights_PreemptSdk",
                "value": "disabled"
              }
            ]
          },
          "appServiceConnectionStrings": {
            "value": [
              {
                "name": "NServiceBus/Transport",
                "connectionString": "[concat('@Microsoft.KeyVault(VaultName=', variables('keyVaultName'), ';SecretName=NServiceBusTransport)')]",
                "type": "Custom"
              },
              {
                "name": "NServiceBus/Persistence",
                "connectionString": "[concat('@Microsoft.KeyVault(VaultName=', variables('keyVaultName'), ';SecretName=fcsPaaSDBConnectionstring)')]",
                "type": "Custom"
              }
            ]
          },
          "workspaceId": {
            "value": "[variables('sharedWorkspaceID')]"
          },
          "appServiceConsoleLogsSetting": {
            "value": "[parameters('appServiceConsoleLogsSetting')]"
          },
          "appServiceAppLogsSetting": {
            "value": "[parameters('appServiceAppLogsSetting')]"
          },
          "appServiceFileAuditLogsSetting": {
            "value": "[parameters('appServiceFileAuditLogsSetting')]"
          },
          "appServiceAuditLogsSetting": {
            "value": "[parameters('appServiceAuditLogsSetting')]"
          },
          "allMetricsSetting": {
            "value": "[parameters('appServiceAllMetricsSetting')]"
          },
          "retentionPolicyEnabled": {
            "value": "[parameters('appServiceRetentionPolicyEnabled')]"
          },
          "retentionPolicyDays": {
            "value": "[parameters('appServiceRetentionPolicyDays')]"
          },
          "http20Enabled": {
            "value": "[parameters('http20Enabled')]"
          },
          "appServiceHTTPLogsSetting": {
            "value": "[parameters('appServiceHTTPLogsSetting')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2017-05-10",
      "name": "Deploy_APP_org_webapi_auth_settings",
      "dependsOn": [ "Deploy_org_webapi_appservice" ],
      "condition": "[parameters('authEnabled')]",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'app-service-auth-settings.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "appServiceName": {
            "value": "[variables('orgwebapiAppServiceName')]"
          },
          "authSettings": {
            "value": {
              "enabled": "[parameters('authEnabled')]",
              "unauthenticatedClientAction": "RedirectToLoginPage",
              "tokenStoreEnabled": false,
              "defaultProvider": "AzureActiveDirectory",
              "clientId": "[parameters('clientID')]",
              "issuer": "[parameters('issuer')]",
              "allowedAudiences": "[parameters('allowedAudiences')]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2017-05-10",
      "name": "Deploy_org_webapi_appservice_Identity_To_EnvKeyVault",
      "dependsOn": [ "Deploy_org_webapi_appservice" ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'keyvault-accesspolicies.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "keyVaultName": {
            "value": "[variables('keyVaultName')]"
          },
          "accessPolicies": {
            "value": [
              {
                "tenantId": "[reference(concat('Deploy_org_webapi_appservice')).outputs.managedServiceIdentity.value.tenantId]",
                "objectId": "[reference(concat('Deploy_org_webapi_appservice')).outputs.managedServiceIdentity.value.principalId]",
                "permissions": {
                  "secrets": [ "get" ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "type": "microsoft.insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[variables('alertRules')[copyIndex()].AlertName]",
      "dependsOn": [
        "Deploy_org_webapi_appservice"
      ],
      "location": "global",
      "tags": {
        "Environment": "[parameters('environmentTag')]",
        "Parent Business": "[parameters('parentBusinessTag')]",
        "Portfolio": "[parameters('portfolioTag')]",
        "Product": "[parameters('productTag')]",
        "Service": "[parameters('productTag')]",
        "Service Line": "[parameters('serviceLineTag')]",
        "Service Offering": "[parameters('productTag')]"
      },
      "properties": {
        "description": "[variables('alertRules')[copyIndex()].Description]",
        "severity": 2,
        "enabled": true,
        "scopes": [ "[variables('alertRules')[copyIndex()].Scopes]" ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "criteria": {
          "allOf": [
            {
              "alertSensitivity": "Medium",
              "failingPeriods": {
                "numberOfEvaluationPeriods": 4,
                "minFailingPeriodsToAlert": 4
              },
              "name": "Metric1",
              "metricNamespace": "Microsoft.Web/sites",
              "metricName": "[variables('alertRules')[copyIndex()].MetricName]",
              "dimensions": [],
              "operator": "[variables('alertRules')[copyIndex()].Operator]",
              "timeAggregation": "[variables('alertRules')[copyIndex()].Aggregation]",
              "criterionType": "DynamicThresholdCriterion"
            }
          ],
          "odata.type": "Microsoft.Azure.Monitor.MultipleResourceMultipleMetricCriteria"
        },
        "autoMitigate": true,
        "targetResourceType": "Microsoft.Web/sites",
        "targetResourceRegion": "[resourceGroup().location]",
        "actions": [
          {
            "actionGroupId": "[resourceId(variables('sharedRG'), 'Microsoft.Insights/actiongroups', variables('actionGroupName')) ]",
            "webHookProperties": {}
          }
        ]
      },
      "copy": {
        "name": "AlertRulesCopy",
        "count": "[length(variables('alertRules'))]"
      }
    }
  ]
}
