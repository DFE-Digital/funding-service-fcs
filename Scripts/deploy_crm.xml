<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build" ToolsVersion="12.0">
  <PropertyGroup>
    <PackageScriptLocation Condition=" '$(PackageScriptLocation)'=='' ">$(MSBuildProjectDirectory)\..\FCTCrmConfig.ConfigPackage\FCTCrmConfig.ConfigPackage\PackageSolution.ps1</PackageScriptLocation>
  </PropertyGroup>
  <PropertyGroup>
    <DeployScriptLocation Condition=" '$(DeployScriptLocation)'=='' ">$(MSBuildProjectDirectory)\Deploy\Import-CrmOrganization-$(Configuration).ps1</DeployScriptLocation>
  </PropertyGroup>

  <Target Name="Build">
    <Exec Command="PowerShell -executionpolicy Unrestricted -command &quot;&amp; { . &apos;$(PackageScriptLocation)&apos; } &quot;" />
    <Exec Command="PowerShell -executionpolicy Unrestricted -command &quot;&amp; { . &apos;$(DeployScriptLocation)&apos; } &quot;" />
  </Target>
</Project>