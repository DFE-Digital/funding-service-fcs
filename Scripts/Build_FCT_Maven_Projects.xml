<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build" ToolsVersion="12.0">
  <PropertyGroup>
    <InstallAndConfigureJBOSS Condition=" '$(InstallAndConfigureJBOSS)'=='' ">$(MSBuildProjectDirectory)\Setup\JavaMSBuildScripts\Install-Jboss.ps1</InstallAndConfigureJBOSS>
  </PropertyGroup>
  <PropertyGroup>
    <ConfigureJBOSSAsService Condition=" '$(ConfigureJBOSSAsService)'=='' ">$(MSBuildProjectDirectory)\Setup\JavaMSBuildScripts\Setup-JBOSS-AsService.ps1</ConfigureJBOSSAsService>
  </PropertyGroup>
  <PropertyGroup>
    <SettingJbossFabric Condition=" '$(SettingJbossFabric)'=='' ">$(MSBuildProjectDirectory)\Setup\JavaMSBuildScripts\Setup-Jboss-Fabric.ps1</SettingJbossFabric>
  </PropertyGroup>

  <Target Name="Build">
   <Exec Command="PowerShell -executionpolicy Unrestricted -command &quot;&amp; { . &apos;$(InstallAndConfigureJBOSS)&apos; $(MSBuildProjectDirectory) } &quot;" />
    
<!--   <Exec Command="PowerShell -executionpolicy Unrestricted -command &quot;&amp; { . &apos;$(ConfigureJBOSSAsService)&apos; $(MSBuildProjectDirectory) } &quot;" />
    
    <Exec Command="PowerShell -executionpolicy Unrestricted -command &quot;&amp; { . &apos;$(SettingJbossFabric)&apos; $(MSBuildProjectDirectory) } &quot;" />-->
  </Target>
</Project>