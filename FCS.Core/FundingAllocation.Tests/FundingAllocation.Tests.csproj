<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <Configurations>Debug;Release;DCI;CI</Configurations>
  </PropertyGroup>
	<PropertyGroup>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DCI|AnyCPU'">
    <DefineConstants>TRACE;DCI</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='CI|AnyCPU'">
    <DefineConstants>TRACE;CI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\CfsAtomNotificationPage.json" />
    <None Remove="Resources\CfsProvider.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\CfsAtomNotificationPage.json" />
    <EmbeddedResource Include="Resources\CfsProvider.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoFixture" Version="4.17.0" />
    <PackageReference Include="FluentAssertions" Version="5.10.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.7.1" />
    <PackageReference Include="Moq" Version="4.15.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="2.1.1" />
    <PackageReference Include="coverlet.collector" Version="1.3.0" />
    <PackageReference Include="NServiceBus.Testing" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FundingAllocation\FundingAllocation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ContractCreateDomain.Implementation">
      <HintPath>..\..\CrossDomain.Integration\ContractCreateDomain.Implementation\bin\Debug\ContractCreateDomain.Implementation.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.CI.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.DCI.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
