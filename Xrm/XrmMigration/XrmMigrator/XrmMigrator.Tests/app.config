  <connectionStrings>
    <clear />
    <add name="CrmConnectionString" connectionString="" />
    <add name="CrmConnectionString_CRMIntegration" connectionString="" />
    <add name="StorageConnectionString" connectionString="UseDevelopmentStorage=true;" />
    <add name="CrmConnectionString_SarahSmith" connectionString="" />
    <add name="CrmConnectionString_GraceGreen" connectionString="" />
    <add name="CrmConnectionString_AntonDavies" connectionString="" />
    <add name="CrmConnectionString_ZoeFoster" connectionString="" />
    <add name="CrmConnectionString_HelenBose" connectionString="" />
    <add name="CrmConnectionString_GregoryShaw" connectionString="" />
   <add name="PaymentSchedulePolicyContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PaymentManagementPolicyContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
