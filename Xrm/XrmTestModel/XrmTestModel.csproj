<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Library</OutputType>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<AssemblyTitle>XrmTestModel</AssemblyTitle>
		<Product>XrmTestModel</Product>

		<Configurations>
			Debug;Release;AT;CI;DAT;DCI;DebugCI;DEV;DMO;DOAT;MO;OAT;PP-OAT;PS;PUB
		</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='CI|AnyCPU'">
		<OutputPath>bin\CI\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='PS|AnyCPU'">
		<OutputPath>bin\PS\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='AT|AnyCPU'">
		<OutputPath>bin\AT\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DEV|AnyCPU'">
		<OutputPath>bin\DEV\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='MO|AnyCPU'">
		<OutputPath>bin\MO\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='OAT|AnyCPU'">
		<OutputPath>bin\OAT\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DAT|AnyCPU'">
		<OutputPath>bin\DAT\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DCI|AnyCPU'">
		<OutputPath>bin\DCI\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DMO|AnyCPU'">
		<OutputPath>bin\DMO\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DOAT|AnyCPU'">
		<OutputPath>bin\DOAT\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DebugCI|AnyCPU'">
		<OutputPath>bin\DebugCI\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.42" />
		<PackageReference Include="Microsoft.IdentityModel" Version="7.0.0" />
		<PackageReference Include="Microsoft.VisualStudio.SlowCheetah" Version="4.0.50">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.WindowsAzure.ConfigurationManager" Version="3.2.3" />
		<PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.10" />


		<PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />


		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
		<PackageReference Include="System.DirectoryServices" Version="10.0.9" />
		<PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.9" />
		<PackageReference Include="System.Runtime.Caching" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Common\Tests\Tests.Common\UnitTests.Common.csproj" />
		<ProjectReference Include="..\..\CrossDomain.Integration\CrossDomain.Integration.Entities\CrossDomain.Integration.Entities.csproj" />
	</ItemGroup>

</Project>
