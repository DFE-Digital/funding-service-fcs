<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentGenerationDbContext" providerName="System.Data.SqlClient" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Persist Security Info=True;Integrated Security=SSPI" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentManagementPolicyContext" providerName="System.Data.SqlClient" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Persist Security Info=True;Integrated Security=SSPI" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="MonitoringDeliverablesDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Persist Security Info=True;Integrated Security=SSPI" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractManagementDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Persist Security Info=True;Integrated Security=SSPI" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PerformanceManagementDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Persist Security Info=True;Integrated Security=SSPI" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractRequestDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Persist Security Info=True;Integrated Security=SSPI" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="DocumentsDomainDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Persist Security Info=True;Integrated Security=SSPI" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="OperationsDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Persist Security Info=True;Integrated Security=SSPI" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
</configuration>