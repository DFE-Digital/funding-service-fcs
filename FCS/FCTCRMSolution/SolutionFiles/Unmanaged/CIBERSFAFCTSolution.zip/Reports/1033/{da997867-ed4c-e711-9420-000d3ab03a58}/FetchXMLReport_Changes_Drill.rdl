><LeftMargin>2cm</LeftMargin><RightMargin>2cm</RightMargin><TopMargin>2cm</TopMargin><BottomMargin>2cm</BottomMargin><ColumnSpacing>0.13cm</ColumnSpacing><Style /></Page><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="CRMDataSource"><ConnectionProperties><DataProvider>MSCRMFETCH</DataProvider><ConnectString>https://fcs-pp-crmw.preprod.fcs.sfa.bis.gov.uk;skillsfundingagencydoat</ConnectString></ConnectionProperties><rd:SecurityType>DataBase</rd:SecurityType><rd:DataSourceID>ceb01f29-89ff-4a7b-9e17-d67d2d422339</rd:DataSourceID></DataSource></DataSources><DataSets><DataSet Name="CensusDateFilteredFSPDataSet"><Query><DataSourceName>CRMDataSource</DataSourceName><QueryParameters><QueryParameter Name="@CensusDatePicker"><Value>=Format(Parameters!CensusDatePicker.Value,"yyyy-MM-dd")</Value></QueryParameter><QueryParameter Name="@DistinctPeriods"><Value>=Parameters!DistinctPeriods.Value</Value></QueryParameter></QueryParameters><CommandText>&lt;fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false"&gt;
  &lt;entity name="sfa_paymenttimetable"&gt;
    &lt;attribute name="sfa_fundingstreamperiod" /&gt;
    &lt;filter type="and"&gt;
      &lt;condition attribute="statecode" operator="eq" value="0" /&gt;
      &lt;condition attribute="sfa_censusenddate" operator="on" value="@CensusDatePicker" /&gt;
      &lt;condition attribute="sfa_period" operator="eq" value="@DistinctPeriods" /&gt;
    &lt;/filter&gt;
  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText></Query><Fields><Field Name="sfa_fundingstreamperiod"><DataField>sfa_fundingstreamperiod</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="sfa_fundingstreamperiodValue"><DataField>sfa_fundingstreamperiodValue</DataField><rd:TypeName>System.Guid</rd:TypeName></Field><Field Name="sfa_fundingstreamperiodEntityName"><DataField>sfa_fundingstreamperiodEntityName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SubnominalFilteredDataSet"><Query><DataSourceName>CRMDataSource</DataSourceName><QueryParameters><QueryParameter Name="@DistinctPeriods"><Value>=Parameters!DistinctPeriods.Value</Value></QueryParameter><QueryParameter Name="@CensusFilteredFSP"><Value>=Parameters!CensusFilteredFSP.Value</Value></QueryParameter></QueryParameters><CommandText>&lt;fetch aggregate="true" &gt;
  &lt;entity name="sfa_subnominalaggregation" &gt;
    &lt;attribute name="sfa_aggregatedvalue" alias="AV" aggregate="sum" /&gt;
    &lt;attribute name="sfa_paymenttype" alias="PT" groupby="true" /&gt;
    &lt;attribute name="sfa_period" alias="PD" groupby="true" /&gt;
    &lt;attribute name="sfa_fundingstreamperiod" alias="FSP" groupby="true" /&gt;
    &lt;filter type="and" &gt;
      &lt;condition attribute="sfa_period" operator="eq" value="@DistinctPeriods" /&gt;
      &lt;condition attribute="sfa_fundingstreamperiodname" operator="in" value="@CensusFilteredFSP" /&gt;
    &lt;/filter&gt;
    &lt;link-entity name="sfa_fundingstreamperiod" from="sfa_fundingstreamperiodid" to="sfa_fundingstreamperiod" &gt;
      &lt;attribute name="sfa_fundingstreamperiodname" alias="FSPName" groupby="true" /&gt;
    &lt;/link-entity&gt;
  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText></Query><Fields><Field Name="AV"><DataField>AV</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AVValue"><DataField>AVValue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="PT"><DataField>PT</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PTValue"><DataField>PTValue</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="PD"><DataField>PD</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="FSP"><DataField>FSP</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SortOrder"><Value>=switch(Fields!PT.Value="Profile","A",Fields!PT.Value="Reconciliation","B",Fields!PT.Value="Capping","C")</Value></Field><Field Name="FSPValue"><DataField>FSPValue</DataField><rd:TypeName>System.Guid</rd:TypeName></Field><Field Name="FSPEntityName"><DataField>FSPEntityName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="FSPName"><DataField>FSPName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="DistinctPeriodsForCensus"><Query><DataSourceName>CRMDataSource</DataSourceName><QueryParameters><QueryParameter Name="@CensusDatePicker"><Value>=Format(Parameters!CensusDatePicker.Value,"yyyy-MM-dd")</Value></QueryParameter></QueryParameters><CommandText>&lt;fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="true" &gt;
  &lt;entity name="sfa_paymenttimetable" &gt;
    &lt;attribute name="sfa_period" /&gt;
    &lt;attribute name="sfa_periodstartdate" /&gt;
    &lt;attribute name="sfa_calendarperiod" /&gt;
    &lt;order attribute="sfa_calendarperiod" descending="false" /&gt;
    &lt;filter type="and" &gt;
      &lt;condition attribute="sfa_censusenddate" operator="on" value="@CensusDatePicker" /&gt;
    &lt;/filter&gt;
  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText></Query><Fields><Field Name="sfa_period"><DataField>sfa_period</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="sfa_periodstartdate"><DataField>sfa_periodstartdate</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="sfa_periodstartdateValue"><DataField>sfa_periodstartdateValue</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="sfa_calendarperiod"><DataField>sfa_calendarperiod</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="sfa_calendarperiodValue"><DataField>sfa_calendarperiodValue</DataField><rd:TypeName>System.Int32</rd:TypeName></Field></Fields></DataSet><DataSet Name="CensusEndDateTime"><Query><DataSourceName>CRMDataSource</DataSourceName><QueryParameters><QueryParameter Name="@CensusDatePicker"><Value>=Format(Parameters!CensusDatePicker.Value,"yyyy-MM-dd")</Value></QueryParameter><QueryParameter Name="@DistinctPeriods"><Value>=Parameters!DistinctPeriods.Value</Value></QueryParameter></QueryParameters><CommandText>&lt;fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="true" &gt;
  &lt;entity name="sfa_paymenttimetable" &gt;
    &lt;attribute name="sfa_censusenddate" /&gt;
    &lt;filter type="and" &gt;
      &lt;condition attribute="sfa_censusenddate" operator="on" value="@CensusDatePicker" /&gt;
      &lt;condition attribute="sfa_period" operator="eq" value="@DistinctPeriods" /&gt;
