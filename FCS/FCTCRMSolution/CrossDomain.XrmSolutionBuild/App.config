  <appSettings>
    <add key="ConfigurationUserDataPath" value="ConfigData.xml" />
    <add key="ManagedSolution" value="Unmanaged" />
    <add key="DeploymentServiceUrl" value="http://fct-ci-crm-01.cloudapp.net/xrmdeployment/2011/deployment.svc" />
