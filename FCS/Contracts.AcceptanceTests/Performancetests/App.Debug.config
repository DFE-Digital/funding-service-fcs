<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add xdt:Transform="Replace" xdt:Locator="Match(key)" key="Microsoft.ServiceBus.ConnectionString" value="=" />
    <add key="RolesMappingDoc" value="ConfigurationFiles\RoleMapping.xml" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrgServiceFileShare" value="\\server\share" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUploadFolder" value="bulkupload-in" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUploadOutputFolder" value="bulkupload-out" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganisationServiceUri" value="http://fct-orgservice-ci.cloudapp.net/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DownloadSolution" value="False" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="InitOrganisationUpdateQueue" value="OrgService.Main" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Office365BulkUploadFolder" value="Input" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Office365BulkUploadOutputFolder" value="Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseAzureStorageForDocuments" value="true" />
    <add key="UseAzureStorageBulkUpload" value="true" />
  </appSettings>
  <connectionStrings>
    <add name="CrmConnectionString" connectionString="Url=http://fct-crm-dev-01.cloudapp.net/FCTDevR2; Domain=FCTDEV; Username=dev-crmintegration; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="StorageConnectionString" connectionString="UseDevelopmentStorage=true;" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString_SarahSmith" connectionString="Url=http://fct-crm-dev-01.cloudapp.net/FCTDevR2; Timeout=00:10:00; Domain=fctdev; Username=test-sarah; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString_GraceGreen" connectionString="Url=http://fct-crm-dev-01.cloudapp.net/FCTDevR2; Timeout=00:10:00; Domain=fctdev; Username=test-grace; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString_AntonDavies" connectionString="Url=http://fct-crm-dev-01.cloudapp.net/FCTDevR2; Timeout=00:10:00; Domain=fctdev; Username=DaviesA; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString_ZoeFoster" connectionString="Url=http://fct-crm-dev-01.cloudapp.net/FCTDevR2; Timeout=00:10:00; Domain=fctdev; Username=FosterZ; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString_HelenBose" connectionString="Url=http://fct-crm-dev-01.cloudapp.net/FCTDevR2; Timeout=00:10:00; Domain=fctdev; Username=BoseH; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString_GregoryShaw" connectionString="Url=http://fct-crm-dev-01.cloudapp.net/FCTDevR2; Timeout=00:10:00; Domain=fctdev; Username=ShawG; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Insert" />
  </connectionStrings>
</configuration>