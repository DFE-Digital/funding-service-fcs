<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add xdt:Transform="Replace" xdt:Locator="Match(key)" key="Microsoft.ServiceBus.ConnectionString" value="=" />
    <add key="FileWatcher.DownloadBufferSize" value="200000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:TenantID" value="eadfe063-8622-4d8a-a23d-379e25f91341" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ClientID" value="e67db973-9c36-45db-9e27-8a9ec73e3a80" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct-ci/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:ClientId" value="47ce313e-46de-4042-bcd8-3cb9ea581d25" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:Principle" value="00000003-0000-0ff1-ce00-000000000000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseAzureStorageForDocuments" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseAzureStorageBulkUpload" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add xdt:Transform="Replace" xdt:Locator="Match(key)" key="Microsoft.ServiceBus.ConnectionString" value="=" />
    <add key="DocumentGeneration.TargetContainer" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="NServiceBus.UseTransport" value="AzureServiceBus" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FscEnrichmentUrl" value="https://services-ci.fct-sfa.com/rest/referencedatalookup" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrgServiceFileShare" value="\\server\share" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUploadFolder" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="BulkUploadOutputFolder" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="OrganisationServiceUri" value="http://fct-orgservice-ci.fctdev.local/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DownloadSolution" value="True" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="InitOrganisationUpdateQueue" value="OrgService.Main" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Office365BulkUploadFolder" value="Input" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Office365BulkUploadOutputFolder" value="Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="PaymentGateway.FileSharePath" value="\\10.1.1.40\PTSShare\CI\" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractManagementServiceUrl" value="https://services-ci.fct-sfa.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="StorageTableSuffix" value="CI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FscAtomFeedHost" value="https://fsc-ci.fct-sfa.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ReportViewerUrl" value="http://fct-ci-crm-01.fctdev.local/ReportServer/Pages/ReportViewer.aspx?" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ReportDelivery.ReportName" value="CDAExtract" />
  </appSettings>
  <connectionStrings>
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentGenerationDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentSchedulePolicyContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="OverrideDateDBContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="MonitoringDeliverablesDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractManagementDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PerformanceManagementDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractRequestDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="AllocationDeliveryMonitoringDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="DocumentsDomainDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="OperationsDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmDatabaseConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentManagementPolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
  <TransportConfig xdt:Transform="Remove" match="XPath(/configuration/TransportConfig)" />
  <SecondLevelRetriesConfig xdt:Transform="Remove" match="XPath(/configuration/SecondLevelRetriesConfig)" />
  <UnicastBusConfig>
    <MessageEndpointMappings>
      <add Assembly="CrossDomain.Integration.Messages" Type="SFA.FCT.CrossDomain.Integration.Messages.Commands.DocumentGenerationCommand" Endpoint="DocumentsDomain.GenerateDocument" xdt:Transform="Replace" xdt:Locator="Match(Type)" />
    </MessageEndpointMappings>
  </UnicastBusConfig>
</configuration>