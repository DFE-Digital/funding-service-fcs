<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <applicationSettings>
    <SFA.FCT.Xrm.Configuration.Tests.Properties.Settings>
      <setting name="SolutionPackagePath" serializeAs="String"
               xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value>.\CIBERSFAFCTSolution.zip\</value>
      </setting>
    </SFA.FCT.Xrm.Configuration.Tests.Properties.Settings>
  </applicationSettings>
  <connectionStrings>
    <add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString_CRMIntegration" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    </connectionStrings>
</configuration>