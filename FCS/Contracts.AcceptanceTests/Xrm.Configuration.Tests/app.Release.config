<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <applicationSettings>
    <SFA.FCT.Xrm.Configuration.Tests.Properties.Settings>
      <setting name="CrmConnectionString" serializeAs="String"
               xdt:Transform="Replace" xdt:Locator="Match(name)">>
        <value>Url=SOMETHING ELSE !!!</value>
      </setting>
      <setting name="SolutionPackagePath" serializeAs="String"
               xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value >SOMETHING ELSE !!!</value>
      </setting>
    </SFA.FCT.Xrm.Configuration.Tests.Properties.Settings>
  </applicationSettings>
</configuration>