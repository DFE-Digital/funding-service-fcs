<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="NServiceBus/Persistence" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentSchedulePolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString" connectionString="Url=http://fct-ci-crm-01.fctdev.local/ContinuousIntegrationDevR2; Domain=fctdev; Username=ci-crmintegration; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="MonitoringDeliverablesDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentGenerationDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="OperationsDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmDatabaseConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="IntegrityCheckerContainer" value="integrity-check-dci" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="StorageTableSuffix" value="DCI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ResourceId_CrmOnline" value="https://fcs-dev-ci.crm4.dynamics.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>