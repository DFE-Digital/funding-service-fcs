          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PaymentGenerationDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='CodaAdapterDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='ContractCreateDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='WorkerRole']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='FileWatcher']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='BulkUpload']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='XrmService']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PaymentManagementDomainStartup']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PaymentManagementDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PerformanceManagementDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
