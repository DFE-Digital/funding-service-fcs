<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" /> /&gt;
    <add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" /></connectionStrings>
  <appSettings>
    <add key="testTargetContainer" value="document-template-dmo" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct-dmo/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:ClientId" value="6e0fefe9-ff8e-4138-806c-a7f1ff88f2ac" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:Principle" value="00000003-0000-0ff1-ce00-000000000000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>