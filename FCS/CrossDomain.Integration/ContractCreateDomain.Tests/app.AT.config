<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="OrgServiceUrl" value="https://fct-orgservice-at.fct-sfa.com/api/v1/organisations/ukprn/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="StorageTableSuffix" value="AT" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ResourceId_CrmOnline" value="https://fcs-at.crm4.dynamics.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
  <connectionStrings>
    <add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
</configuration>