<?xml version="1.0" encoding="utf-8"?>
<ServiceDefinition name="NSBMultipleHosts.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceDefinition" schemaVersion="2015-04.2.6">
  <WorkerRole name="XDomain.Worker" vmsize="Large">
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="CPDSAuth" storeLocation="LocalMachine" storeName="My" />
      <Certificate name="DedsAuth" storeLocation="LocalMachine" storeName="My" />
    </Certificates>
    <Endpoints>
      <InputEndpoint name="Fake" protocol="tcp" port="50123" />
    </Endpoints>
    <Imports>
      <Import moduleName="RemoteForwarder" />
    </Imports>
  </WorkerRole>
</ServiceDefinition>