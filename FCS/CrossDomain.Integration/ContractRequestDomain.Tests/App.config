<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
  </configSections>
  <appSettings>
    <add key="FscEnrichmentUrl" value="http://localhost/FundingStreamConfigDomain/rest/referencedatalookup" />
    <!--File Validation Messages-->
    <add key="FundingTypeCodeInvalidMessage" value="Funding type specified is not a valid funding type." />
    <add key="PeriodTypeCodeInvalidMessage" value="Period type specified is not a valid Period type." />
    <add key="PeriodInvalidMessage" value="Period specified is not a valid Period." />
    <add key="FileTypeInvalidMessage" value="File type is not as expected. \n Expected file type is .xlsx" />
    <add key="FileNameInvalidMessage" value="File name is not as expected" />
    <add key="FileStructureInvalidMessage" value="File structure is not as expected. File structure expected as per 'Bulk Import File Specification'" />
    <add key="TypeCombinationInvalidMessage" value="The combination of Funding Type, Period Type and Period is not a valid combination" />
    <add key="FileNameFundingTypeInvalidMessage" value="Funding type code in file name should match the funding type code in the 'Control Sheet' tab" />
    <add key="FileNamePeriodTypeInvalidMessage" value="Period type code in file name should match the Period type code in the 'Control Sheet' tab" />
    <add key="FileNamePeriodInvalidMessage" value="Period in file name should match the Period in the 'Control Sheet' tab" />
    <add key="FileWatcher.DownloadBufferSize" value="200000" />
    <add key="CrmConnectionString" value="" />
    <add key="ida:Resource" value="https://dhays.sharepoint.com/" />
    <add key="FileWatcher.InputFolderO365" value="Input" />
    <add key="FileWatcher.ProcessingFolderO365" value="Processing" />
    <add key="FileWatcher.ProcessedFolderO365" value="Processed" />
    <add key="FileWatcher.ReportsFolderO365" value="Reports" />
    <add key="BulkUpdate.LocationMappingTable" value="BulkUpdateLocationMappingDebug" />
    <add key="BulkUpdate.ProcessingTable" value="BulkUpdateProcessingDebug" />
    <add key="UseRealDate" value="true" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="StorageConnectionString" connectionString="UseDevelopmentStorage=true;" />
    <add name="ContractManagementDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="ContractRequestDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <runtime>
