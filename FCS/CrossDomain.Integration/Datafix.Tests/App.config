  </system.serviceModel>
  <appSettings>
    <add key="OrgServiceUrl" value="http://localhost:4240/api/v1/organisations/ukprn/" />
    <add key="StorageTableSuffix" value="LOCAL" />
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" /></startup></configuration>
