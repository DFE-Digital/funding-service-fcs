  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
    <contexts>
      <context type="ADMonitoringDomain.DataStore.AllocationDeliveryMonitoringDbContext, ADMonitoringDomain.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.AllocationDelivery.DataStore.AllocationDeliveryDbContext, AllocationDelivery.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.AllocationDeliveryDomain.Common.DataStore.MonitoringDeliverablesDbContext, AllocationDeliveryDomain.Common" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.CrossDomain.Integration.OverrideDate.OverrideDateDBContext, CrossDomain.Integration.OverrideDate.DataStore" disableDatabaseInitialization="true" />
      <context type="PaymentGenerationDomain.Integration.DataStore.PaymentGenerationDbContext, PaymentGenerationDomain.Integration.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.PaymentManagementDomain.PaymentSchedule.DataStore.PaymentSchedulePolicyContext, PaymentManagementDomain.PaymentSchedule.DataStore" disableDatabaseInitialization="true" />
      <!--<context type="SFA.FCT.PaymentManagementDomain.PolicyCache.DataStore.PaymentManagementPolicyContext, PaymentManagementDomain.PolicyCache.DataStore" disableDatabaseInitialization="true" />-->
      <!--<context type="SFA.FCT.PMD.PaymentManagment.DataStore.PaymentManagementDBContext, PMD.PaymentManagement.DataStore" disableDatabaseInitialization="true" />-->
    </contexts>
  </entityFramework>
  <connectionStrings>
    <add name="PaymentSchedulePolicyContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="AllocationDeliveryDbContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PaymentManagementPolicyContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="AllocationDeliveryMonitoringDbContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="MonitoringDeliverablesDbContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="OverrideDateDBContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PaymentGenerationDbContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="ContractManagementDbContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
	<appSettings>
		<add key="KeyVault:Uri" value="https://fcs-dev-dci-kv.vault.azure.net/" />
	</appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup></configuration>
