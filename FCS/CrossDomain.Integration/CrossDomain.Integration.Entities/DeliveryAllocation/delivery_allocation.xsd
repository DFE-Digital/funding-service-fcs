<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2015 rel. 4 (http://www.altova.com) by Nigel Hamer (Capgemini) -->
<xs:schema xmlns:ctr="urn:sfa:schemas:contract" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" targetNamespace="urn:sfa:schemas:contract" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.8">
	<xs:attributeGroup name="SchemaVersionAttribute">
		<xs:attribute name="schemaVersion" use="required" fixed="1.8">
			<xs:annotation>
				<xs:documentation>Version of the schema in use</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:decimal">
					<xs:totalDigits value="3"/>
					<xs:fractionDigits value="2"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:attributeGroup>
	<xs:simpleType name="periodTypeCodeType">
		<xs:annotation>
			<xs:documentation>
        A code used to describe a type of period of time
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AY"/>
			<xs:enumeration value="FY"/>
			<xs:enumeration value="CY"/>
			<xs:enumeration value="CM"/>
			<xs:enumeration value="CQ"/>
			<xs:enumeration value="ESF"/>
			<xs:enumeration value="EOF"/>
			<xs:enumeration value="EOP"/>
			<xs:enumeration value="LEVY"/>
			<xs:enumeration value="NONLEVY"/>
            <xs:enumeration value="NCS"/>
			<xs:enumeration value="SB"/>
			<xs:enumeration value="HTES"/>
			<xs:enumeration value="HTES2"/>
			<xs:enumeration value="CTEC"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="periodTypeNameType">
		<xs:annotation>
			<xs:documentation>
        A name used to describe a type of period of time
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACADEMIC YEAR"/>
			<xs:enumeration value="FINANCIAL YEAR"/>
			<xs:enumeration value="CALENDAR YEAR"/>
			<xs:enumeration value="CALENDAR MONTH"/>
			<xs:enumeration value="CALENDAR QUARTER"/>
			<xs:enumeration value="EUROPEAN SOCIAL FUND"/>
			<xs:enumeration value="EMPLOYER OWNERSHIP FUND"/>
			<xs:enumeration value="EMPLOYER OWNERSHIP PILOT"/>
			<xs:enumeration value="APPRENTICESHIP LEVY"/>
			<xs:enumeration value="NON-LEVY APPRENTICESHIPS"/>
            <xs:enumeration value="NATIONAL CAREERS SERVICE"/>
			<xs:enumeration value="SKILLS BOOTCAMPS"/>
			<xs:enumeration value="HIGHER TECHNICAL EDUCATION SKILLS"/>
			<xs:enumeration value="HIGHER TECHNICAL EDUCATION SKILLS 2"/>
			<xs:enumeration value="CONSTRUCTION TECHNICAL EXCELLENCE COLLEGES"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="description">
		<xs:annotation>
			<xs:documentation>The description or title of the Contract/Contract Allocation</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="periodTypeType">
		<xs:annotation>
			<xs:documentation>
        A reference of possible types of Period.
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="periodTypeCode" type="ctr:periodTypeCodeType"/>
			<xs:element name="periodTypeName" type="ctr:periodTypeNameType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="deliverableType">
		<xs:annotation>
			<xs:documentation>A reference list of each deliverable</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="deliverableCode" type="xs:int" minOccurs="1" maxOccurs="1"/>
			<xs:element name="deliverableName" minOccurs="1" maxOccurs="1">
				<xs:simpleType>
					<xs:annotation>
						<xs:documentation>
              A description or name of the Deliverable
            </xs:documentation>
					</xs:annotation>
					<xs:restriction base="xs:string">
						<xs:maxLength value="120"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="isLegal" type="xs:boolean"/>
			<xs:element name="isMonitoring" type="xs:boolean"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractDeliverablesType">
		<xs:annotation>
			<xs:documentation>
        Essentially an intersection between a Contract and Deliverables - so the Deliverables that apply to the Contract.
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="contractDeliverable" type="ctr:contractDeliverableType" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractDeliverablePeriodsType">
		<xs:annotation>
			<xs:documentation>
        The planned delivery against periods of time
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="contractDeliverablePeriod" minOccurs="1" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="period" type="ctr:periodType"/>
						<xs:element name="plannedVolume" type="xs:int" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>
                  The volume of the Deliverable that has to be delivered. This is not a summary, rather it enables a single volume to be allocated across all periods.
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="plannedValue" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>
                  The planned value (equals Unit Cost x Planned Volume if both are populated) of what has to be delivered.  This is not a summary, rather it enables a single value to be allocated across all periods.
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:totalDigits value="13"/>
									<xs:fractionDigits value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="allocationType">
		<xs:sequence>
			<xs:element name="contractDeliverables" type="ctr:contractDeliverablesType"/>
			<xs:element name="contractAllocationNumber">
				<xs:annotation>
					<xs:documentation>
                  The unique identifier of a Contract Allocation (along with Contract Allocation Version Number)
                </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="contractorReference" type="ctr:organisationReferenceType">
				<xs:annotation>
					<xs:documentation>This is a reference to the contractor of the containing contract</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="contractReference" type="ctr:contractReferenceType"/>
			<xs:element name="description" type="ctr:description" minOccurs="0"/>
      <xs:element name="startDate" type="xs:date">
        <xs:annotation>
          <xs:documentation>
            The date from which the Contract Allocation is valid. Although in most cases the start and end date will be defined in the Contract (Hierarchy Type = 'CONTRACT'), there remains the possibility that in some circumstances it will need to be recorded at this level.

            The implementation must apply to start and end date from the containing contract if the allocation has not provided overrides.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="endDate" type="xs:date" minOccurs="0" nillable="true">
        <xs:annotation>
          <xs:documentation>
            The date after which the Contract Allocation is no longer valid

            The implementation must apply to start and end date from the containing contract if the allocation has not provided overrides.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
			<xs:element name="fundingStreamPeriod">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="fundingStreamPeriodCode" minOccurs="0">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="20"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="period" type="ctr:periodType"/>
						<xs:element name="startDate" type="xs:date">
							<xs:annotation>
								<xs:documentation>
                  The date from which the Funding Stream Period is valid.
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="endDate" type="xs:date">
							<xs:annotation>
								<xs:documentation>
                  The date after which the Funding Stream Period is no longer valid
                </xs:documentation>
							</xs:annotation>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
      <xs:element name="uopCode" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            A code used to identify the OLASS Unit of Procurement to which this Contract Allocation relates
          </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="20"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
			<xs:element name="maximumContractValue" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
                  An upper limit to the value of the Contract Allocation
                </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:totalDigits value="13"/>
						<xs:fractionDigits value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="lastModifiedDate" type="xs:int" minOccurs="0"/>
			<xs:element name="lastModifiedContractVersion" type="xs:string" minOccurs="0"/>
		</xs:sequence>
    <xs:attributeGroup ref="ctr:SchemaVersionAttribute"/>
	</xs:complexType>
	<xs:complexType name="contractDeliverableType">
		<xs:sequence>
			<xs:element name="contractDeliverables" type="ctr:contractDeliverablesType" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="deliverable" type="ctr:deliverableType"/>
			<xs:element name="contractDeliverablePeriods" type="ctr:contractDeliverablePeriodsType" minOccurs="0"/>
			<xs:element name="deliverableDescription" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
                  The description of the Deliverable as entered by the business in relation to this Contract. This may differ from the description found in Funding Stream Configuration.
                </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="255"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="plannedVolume" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
                  The volume of the Deliverable that has to be delivered. This is not a summary, rather it enables a single volume to be allocated across all periods.
                </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="plannedValue" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
                  The planned value (equals Unit Cost x Planned Volume if both are populated) of what has to be delivered.  This is not a summary, rather it enables a single value to be allocated across all periods.
                </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:totalDigits value="13"/>
						<xs:fractionDigits value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractReferenceType">
		<xs:annotation>
			<xs:documentation>Models a reference to a contract</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="contractNumber">
				<xs:annotation>
					<xs:documentation>
              The unique identifier of a Contract (along with Contract Version Number)
            </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="contractVersionNumber" type="xs:int">
				<xs:annotation>
					<xs:documentation>
              An identifier used to differentiate the different versions of a Contract.
            </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="contractSubVersionNumber" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>An identifier used to allow a Contract Version to be amended without incrementing the Contract Version Number, for example, when updates are made to draft contracts.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationReferenceType">
		<xs:annotation>
			<xs:documentation>Models a reference to an organisation</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisationIdentifier">
				<xs:annotation>
					<xs:documentation>The identifier of the Organisation </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="alternativeOrganisationIdentifiers" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="AlternativeOrganisationIdentifier" type="ctr:alternativeOrganisationIdentifierType" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="alternativeOrganisationIdentifierType">
		<xs:sequence>
			<xs:element name="OrganisationIdentifier">
				<xs:annotation>
					<xs:documentation>An alternative identifier used to uniquely identify this Organisation</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="OrganisationIdentifierName">
				<xs:annotation>
					<xs:documentation>The commonly used name used to describe what the Organisation Identifier is</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
						<xs:enumeration value="UK PROVIDER REFERENCE NUMBER"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="deliveryAllocation" type="ctr:allocationType">
		<xs:annotation>
			<xs:documentation>Variations from Contract corporate schema

Removed the Contract Structure and related types not applicable to allocations.
Created Contract Reference structure and added to Allocation to link back to owning contract
Created Organisation Reference structure and added as Contractor Reference to Allocation to link back to the Contract Contractor
Made Start and End Date under allocation mandatory - If not specified for an allocation then they should contain the values held at contract level
Removed LastModifiedContractVersion - Handled by ContractReference
Removed ESF related fields - Can be handled by versioning in the future when required.
Removed all dimension relationship extension points. Better handled by versioning.
Removed "Actuals" fields from deliverable - handle in alternative messages
Removed "Payment" fields from deliverable - handle in alternative messages
</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="periodType">
		<xs:sequence>
			<xs:element name="periodType" type="ctr:periodTypeType"/>
			<xs:element name="periodValue">
        <xs:annotation>
          <xs:documentation>
            The period (eg a calendar month, a calendar quarter, a calendar year but usually calendar month) of the Period
          </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
