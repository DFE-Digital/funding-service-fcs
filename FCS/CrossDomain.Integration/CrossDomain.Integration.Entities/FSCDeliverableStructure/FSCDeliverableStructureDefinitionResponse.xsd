<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:simpleType name="DeliverableParentRelationshipType" final="restriction">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Aggregate"/>
			<xs:enumeration value="Linked"/>
			<xs:enumeration value="OfWhich"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="FSCDeliverableStructureDefinitionResponse">
		<xs:annotation>
			<xs:documentation>Comment describing your root element</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="DeliverableStructureList">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="DeliverableConfiguration" type="DeliverableConfigurationType" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="DeliverableConfigurationType">
		<xs:sequence>
			<xs:element name="DeliverableCode" type="xs:int"/>
			<xs:element name="DeliverableName" type="xs:string"/>
			<xs:element name="ParentDetails" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="ParentRelationship" type="DeliverableParentRelationshipType" nillable="true"/>
						<xs:element name="ParentDeliverableCode" type="xs:int" nillable="true"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Settings" type="DeliverableSettingsType" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DeliverableSettingsType">
		<xs:sequence>
			<xs:element name="SettingCode" type="xs:string"/>
			<xs:element name="SettingValue" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
