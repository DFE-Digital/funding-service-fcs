<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="CrmConnectionString_CRMIntegration" connectionString="Url=http://fct-ci-crm-01.fctdev.local/ContinuousIntegrationDevR2; Domain=fctdev; Username=ci-crmintegration; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
  </connectionStrings>
  <appSettings>
    <add key="FscEnrichmentUrl" value="https://services-dci.fct-sfa.com/rest/referencedatalookup" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
   </appSettings>
</configuration>