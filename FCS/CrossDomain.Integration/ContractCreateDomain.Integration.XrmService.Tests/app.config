  </system.serviceModel>
  <appSettings>
    <!-- Service Bus specific app setings for messaging connections -->
    <add key="Microsoft.ServiceBus.ConnectionString" value="Endpoint=sb://[your namespace].servicebus.windows.net;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=" />
    <add key="FscEnrichmentUrl" value="http://localhost/FundingStreamConfigDomain/rest/referencedatalookup" />
    <add key="ida:Tenant_FundingStreamConfig" value="fcsazuresfabisgov.onmicrosoft.com" />
    <add key="ida:ClientId_FundingStreamConfig" value="a8c17841-be75-4f80-97df-8006cceb438e" />
    <add key="ida:AppKey_FundingStreamConfig" value="" />
    <add key="ida:ResourceId_FundingStreamConfig" value="http://fcsazuresfabisgov.onmicrosoft.com/FundingStreamConfigDomain" />
    <add key="ida:AADInstance_FundingStreamConfig" value="https://login.microsoftonline.com/{0}" />
  </appSettings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
    <contexts>
      <context type="SFA.FCT.AllocationDeliveryDomain.Common.DataStore.MonitoringDeliverablesDbContext, AllocationDeliveryDomain.Common" disableDatabaseInitialization="true" />
      <context type="PaymentGenerationDomain.Integration.DataStore.PaymentGenerationDbContext, PaymentGenerationDomain.Integration.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.PaymentManagementDomain.PolicyCache.DataStore.PaymentManagementPolicyContext, PaymentManagementDomain.PolicyCache.DataStore" disableDatabaseInitialization="true" />
    </contexts>
  </entityFramework>
