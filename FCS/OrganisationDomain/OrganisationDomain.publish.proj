<Project ToolsVersion="4.0"
         DefaultTargets="Build"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Choose>
    <When Condition="'$(BuildName)' == ''">
      <PropertyGroup>
        <BuildName>Manual</BuildName>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <BuildName>$(BuildNumber)</BuildName>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <PropertyGroup>
    <SolutionDir Condition=" '$(SolutionDir)'=='' ">$(MSBuildThisFileDirectory)</SolutionDir>
    <SolutionPath Condition=" '$(SolutionPath)'=='' ">$(MSBuildThisFileDirectory)OrganisationDomain.sln</SolutionPath>
    <OutDir Condition=" '$(OutDir)'=='' ">$(MSBuildThisFileDirectory)Output\Binaries\</OutDir>
    <PackageOutDir>$(MSBuildThisFileDirectory)Output\Packages\</PackageOutDir>
    <TargetCloudService>OrganisationDomain.Azure.Deploy</TargetCloudService>
  </PropertyGroup>

  <!--<Target Name="RestorePackages">
    <Message Text="Restoring nuget..."/>
    <Exec Command="&quot;$(SolutionDir).nuget\NuGet.exe&quot; restore &quot;$(SolutionPath)&quot;" />
  </Target>-->

  <Target Name="PackageCloud">
    <Message Text="Creating the $(TargetCloudService) package for cloud deployment ..."/>
    <MSBuild Projects="$(MSBuildThisFileDirectory)$(TargetCloudService)\$(TargetCloudService).ccproj"
             Properties="OutputPath=$(PackageOutDir)$(TargetCloudService)\;Configuration=$(Configuration);"
             Targets="Publish"/>
  </Target>

  <Target Name="Build"
          DependsOnTargets="PackageCloud">
    <Message Text="Deploying the $(TargetCloudService) package to the cloud service ..."/>
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)"
          Command="powershell.exe -ExecutionPolicy Unrestricted -f &quot;$(MSBuildThisFileDirectory)..\Scripts\Deploy\Deploy-CloudService2.ps1&quot; -ServiceName &quot;fct-orgservice-$(Configuration)&quot; -PackageLocation &quot;$(PackageOutDir)$(TargetCloudService)\app.publish\$(TargetCloudService).cspkg&quot; -ConfigurationLocation &quot;$(PackageOutDir)$(TargetCloudService)\app.publish&quot; -BuildNumber &quot;$(BuildName)&quot; -BuildConfiguration &quot;$(Configuration)&quot;"/>
  </Target>
</Project>