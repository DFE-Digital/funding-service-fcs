<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="ContractManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="StorageTableSuffix" value="AT" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ResourceId_CrmOnline" value="https://fcs-at.crm4.dynamics.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>