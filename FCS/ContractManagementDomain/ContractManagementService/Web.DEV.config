<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit http://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="PaymentGenerationDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="PaymentManagementPolicyContext" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="PaymentSchedulePolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="MonitoringDeliverablesDbContext" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
  </connectionStrings>
  <appSettings>
    <add key="StorageTableSuffix" value="DDEV" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
  </appSettings>

  <system.web>
    
  </system.web>
</configuration>