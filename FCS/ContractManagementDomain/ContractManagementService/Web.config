<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301879
  -->
<configuration>
	<configSections>
		<section name="MessageForwardingInCaseOfFaultConfig" type="NServiceBus.Config.MessageForwardingInCaseOfFaultConfig, NServiceBus.Core" />
		<section name="UnicastBusConfig" type="NServiceBus.Config.UnicastBusConfig, NServiceBus.Core" />
		<section name="AuditConfig" type="NServiceBus.Config.AuditConfig, NServiceBus.Core" />
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		<!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
	</configSections>
	<system.diagnostics>
		<sources>
			<source name="CMWebRole" switchName="CMWebSwitch" switchType="System.Diagnostics.SourceSwitch">
				<listeners>
					<clear />
					<add name="Default" type="System.Diagnostics.DefaultTraceListener" />
					<add name="AzureDiagnostics">
						<filter type="" />
					</add>
					<add name="myAppInsightsListener">
						<filter type="" />
					</add>
				</listeners>
			</source>
			<source name="AzureServiceBusQueueCreator" switchName="AzureServiceBusQueueCreatorSwitch" switchType="System.Diagnostics.SourceSwitch">
				<listeners>
					<clear />
					<add name="AzureDiagnostics" />
				</listeners>
			</source>
			<source name="AzureServiceBusTopicCreator" switchName="AzureServiceBusTopicCreatorSwitch" switchType="System.Diagnostics.SourceSwitch">
				<listeners>
					<clear />
					<add name="AzureDiagnostics" />
				</listeners>
			</source>
			<source name="StepRegistrationsCoordinator" switchName="StepRegistrationsCoordinatorSwitch" switchType="System.Diagnostics.SourceSwitch">
				<listeners>
					<clear />
					<add name="AzureDiagnostics" />
				</listeners>
			</source>
		</sources>
		<sharedListeners>
			<add type="Microsoft.WindowsAzure.Diagnostics.DiagnosticMonitorTraceListener, Microsoft.WindowsAzure.Diagnostics, Version=2.8.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="AzureDiagnostics">
				<filter type="" />
			</add>
			<add type="Microsoft.ApplicationInsights.TraceListener.ApplicationInsightsTraceListener, Microsoft.ApplicationInsights.TraceListener" name="myAppInsightsListener">
				<filter type="" />
			</add>
		</sharedListeners>
		<switches>
			<add name="CMWebSwitch" value="information" />
			<!-- these next three stop a lot of the NServiceBus verbosity about checking for queues etc -->
			<add name="AzureServiceBusQueueCreatorSwitch" value="error" />
			<add name="AzureServiceBusTopicCreatorSwitch" value="error" />
			<add name="StepRegistrationsCoordinatorSwitch" value="error" />
		</switches>
		<trace>
			<listeners>
				<add type="Microsoft.WindowsAzure.Diagnostics.DiagnosticMonitorTraceListener, Microsoft.WindowsAzure.Diagnostics, Version=2.8.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="AzureDiagnostics">
					<filter type="" />
				</add>
				<add type="Microsoft.ApplicationInsights.TraceListener.ApplicationInsightsTraceListener, Microsoft.ApplicationInsights.TraceListener" name="myAppInsightsListener">
					<filter type="" />
				</add>
			</listeners>
		</trace>
	</system.diagnostics>
	<!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.7.2" />
      </system.Web>
  -->
	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.5.1" enableVersionHeader="false" />
		<customErrors mode="Off" />
		<!-- TODO Remove this at a later time -->
		<httpModules>
			<add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" />
		</httpModules>
	</system.web>
