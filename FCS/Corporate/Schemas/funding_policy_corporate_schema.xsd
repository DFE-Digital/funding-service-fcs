<xs:schema xmlns:fcfg="urn:sfa:schemas:funding-policy" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:sfa:schemas:funding-policy" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2.00">

  <xs:element name="SettingValue" type="fcfg:SettingValueType"/>
  <xs:element name="FundingPeriod" type="fcfg:FundingPeriodType"/>
  <xs:element name="FundingStreamPeriodCode" type="fcfg:FundingStreamPeriodCodeType"/>
  <xs:element name="DeliverableCode" type="fcfg:DeliverableCodeType"/>

  <xs:attributeGroup name="SchemaVersionAttribute">
    <xs:attribute name="schemaVersion" use="required" fixed="2.00">
      <xs:annotation>
        <xs:documentation>Version of the schema in use</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:decimal">
          <xs:totalDigits value="3"/>
          <xs:fractionDigits value="2"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:simpleType name="FundingStreamPeriodCodeType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DeliverableCodeType">
    <xs:restriction base="xs:int">
    </xs:restriction>
  </xs:simpleType>

  <!--<xs:complexType name="FundingStreamPeriodType">
		<xs:annotation>
			<xs:documentation>
        A defined and widely used period of time within a Funding Stream. Such Funding Stream Periods are non-overlapping within a Funding Stream and the collection of all such Funding Stream Periods should cover the complete period of time that the Funding Stream is valid.
      </xs:documentation>
