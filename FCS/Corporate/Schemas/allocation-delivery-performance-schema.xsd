<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:adf="urn:sfa:schemas:allocation-delivery-performance"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:sfa:schemas:allocation-delivery-performance"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.01">

  <xs:attributeGroup name="SchemaVersionAttribute">
    <xs:attribute name="schemaVersion" use="required" fixed="1.01">
      <xs:annotation>
        <xs:documentation>Version of the schema in use</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:decimal">
          <xs:totalDigits value="3"/>
          <xs:fractionDigits value="2"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:simpleType name="PaymentTypeTYPE">
    <xs:restriction base="xs:string">
      <xs:length value="50"/>
      <xs:enumeration value="BUDGETING"/>
      <xs:enumeration value="PAYMENT"/>
      <xs:enumeration value="PROFILE"/>
      <xs:enumeration value="CAPPING"/>
      <xs:enumeration value="RECONCILIATION"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OrganisationIdentifierTYPE">
    <xs:restriction base="xs:string">
      <xs:length value="10"/>
      <xs:pattern value="ORG*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AmountTYPE">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="13"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="VolumeTYPE">
    <xs:restriction base="xs:int">
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SubnominalTYPE">
    <xs:restriction base="xs:string">
      <xs:maxLength value="8"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DeliverableCodeTYPE">
    <xs:restriction base="xs:int">
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="contractNumberTYPE">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="contractVersionNumberTYPE">
    <xs:restriction base="xs:int">
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="contractSubVersionNumberTYPE">
    <xs:restriction base="xs:int">
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="contractAllocationNumberTYPE">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="periodTypeCodeLIST">
    <xs:annotation>
      <xs:documentation>
        A code used to describe a type of period of time
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="AY"/>
      <xs:enumeration value="FY"/>
      <xs:enumeration value="CY"/>
      <xs:enumeration value="CM"/>
      <xs:enumeration value="CQ"/>
      <xs:enumeration value="ESF"/>
      <xs:enumeration value="EOF"/>
      <xs:enumeration value="EOP"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="UoPCodeTYPE">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="alternativeOrganisationIdentifierTYPE">
    <xs:sequence>
      <xs:element name="OrganisationIdentifier">
        <xs:annotation>
          <xs:documentation>An alternative identifier used to uniquely identify this Organisation</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="OrganisationIdentifierName">
        <xs:annotation>
          <xs:documentation>The commonly used name used to describe what the Organisation Identifier is</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
            <xs:enumeration value="UK PROVIDER REFERENCE NUMBER"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="organisationReferenceTYPE">
    <xs:annotation>
      <xs:documentation>Models a reference to an organisation</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="organisationIdentifier" type="adf:OrganisationIdentifierTYPE"/>
      <xs:element name="alternativeOrganisationIdentifiers" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="AlternativeOrganisationIdentifier" type="adf:alternativeOrganisationIdentifierTYPE" minOccurs="0" maxOccurs="1"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="contractReferenceTYPE">
    <xs:annotation>
      <xs:documentation>Models a reference to a contract</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="contractNumber" type="adf:contractNumberTYPE" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            The unique identifier of a Contract (along with Contract Version Number)
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="contractVersionNumber" type="adf:contractVersionNumberTYPE" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            An identifier used to differentiate the different versions of a Contract.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="contractSubVersionNumber" type="adf:contractSubVersionNumberTYPE" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>An identifier used to allow a Contract Version to be amended without incrementing the Contract Version Number, for example, when updates are made to draft contracts.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  
  <xs:complexType name="ScheduledPaymentTYPE">
    <xs:sequence>
      <xs:element name="DeliverableCode" type="adf:DeliverableCodeTYPE" minOccurs="1" maxOccurs="1"/>
      <xs:element name="ProfilePayment" type="adf:AmountTYPE" minOccurs="0" maxOccurs="1"/>
      <xs:element name="BalancingPayment" type="adf:AmountTYPE" minOccurs="0" maxOccurs="1"/>
      <xs:element name="ReconciliationPayment" type="adf:AmountTYPE" minOccurs="0" maxOccurs="1"/>
      <xs:element name="CappingPayment" type="adf:AmountTYPE" minOccurs="0" maxOccurs="1"/>
      <xs:element name="NetPayment" type="adf:AmountTYPE" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ScheduledPaymentsPeriodTYPE">
    <xs:sequence>
      <xs:element name="Period" type="adf:PeriodTYPE"  minOccurs="1" maxOccurs="1"/>
      <xs:element name="ScheduledPayment" type="adf:ScheduledPaymentTYPE" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ActualTYPE">
    <xs:sequence>
      <xs:element name="DeliverableCode" type="adf:DeliverableCodeTYPE" minOccurs="1" maxOccurs="1"/>
      <xs:element name="ActualValue" type="adf:AmountTYPE"  minOccurs="1" maxOccurs="1"/>
      <xs:element name="ActualVolume" type="adf:VolumeTYPE"  minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ActualsPeriodTYPE">
    <xs:sequence>
      <xs:element name="Period" type="adf:PeriodTYPE"  minOccurs="1" maxOccurs="1"/>
      <xs:element name="Actual" type="adf:ActualTYPE" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AggregatedPaymentTYPE">
    <xs:sequence>
      <xs:element name="PaymentTYPE" type="adf:PaymentTypeTYPE"/>
      <xs:element name="SubnominalCode" type="adf:SubnominalTYPE"  minOccurs="1" maxOccurs="1"/>
      <xs:element name="AggregatedValue" type="adf:AmountTYPE"  minOccurs="1" maxOccurs="1"/>
      <xs:element name="Deliverables" minOccurs="1" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="DeliverableReference" type="adf:DeliverableCodeTYPE" minOccurs="1" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AggregatedPaymentPeriodTYPE">
    <xs:sequence>
      <xs:element name="Period" type="adf:PeriodTYPE"  minOccurs="1" maxOccurs="1"/>
      <xs:element name="PaymentPosted" type="xs:boolean"/>
      <xs:element name="AggregatedPayment" type="adf:AggregatedPaymentTYPE" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  
  <xs:simpleType name="PeriodTYPE">
    <xs:restriction base="xs:string">
      <xs:maxLength value="6"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="DeliverableTYPE">
    <xs:sequence>
      <xs:element name="DeliverableCode" type="adf:DeliverableCodeTYPE" minOccurs="1" maxOccurs="1"/>
      <xs:element name="isLegal" type="xs:boolean"/>
      <xs:element name="isMonitoring" type="xs:boolean"/>
      <xs:element name="DeliveryProfile" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>
            This element is optional because some deliverables are monitoring only and do not have a delivery profile. A delivery profile is only valid
            for legal deliverables.
          </xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="PlannedValue" type="adf:AmountTYPE"  minOccurs="0" maxOccurs="1"/>
            <xs:element name="PlannedVolume" type="adf:VolumeTYPE"  minOccurs="0" maxOccurs="1"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="ContractDeliverables" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ContractDeliverable" type="adf:DeliverableTYPE" minOccurs="1" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="AllocationDeliveryPerformance">
    <xs:complexType>
      <xs:sequence>

        <xs:element name="Contract" type="adf:contractReferenceTYPE" minOccurs="1" maxOccurs="1"/>

        <xs:element name="contractAllocationNumber" type="adf:contractAllocationNumberTYPE" minOccurs="1" maxOccurs="1">
          <xs:annotation>
            <xs:documentation>
              The unique identifier of a Contract Allocation (along with Contract Allocation Version Number)
            </xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="Contractor" type="adf:organisationReferenceTYPE" minOccurs="1" maxOccurs="1"/>

        <xs:element name="UoPCode" type="adf:UoPCodeTYPE" minOccurs="0" maxOccurs="1">
          <xs:annotation>
            <xs:documentation>This is an identifier of the OLASS unit of procurement to which has summarised actual belongs. In practice this is an attribute of the Procurement (which in turn should be identifible by a combination of Period (of the Funding Stream) and the OLASS unit of procurement plus any versioning that may be required).</xs:documentation>
          </xs:annotation>
        </xs:element>

          <xs:element name="FundingStreamPeriod" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="FundingStreamPeriodCode" type="xs:string" minOccurs="1" maxOccurs="1"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="ContractDeliverables" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ContractDeliverable" type="adf:DeliverableTYPE" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="AllocationPeriodTypeCode" type="adf:periodTypeCodeLIST" minOccurs="1" maxOccurs="1">
          <xs:annotation>
            <xs:documentation>The period type for the scheduled payments and the actuals.</xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="PaymentPeriodTypeCode" type="adf:periodTypeCodeLIST" minOccurs="0" maxOccurs="1" nillable="true">
          <xs:annotation>
            <xs:documentation>The period type used for payments (aggregated payments), as there are usually more payments than there are allocation periods.</xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="ScheduledPaymentPeriods" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ScheduledPaymentPeriod"  type="adf:ScheduledPaymentsPeriodTYPE" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="ActualsPeriods" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="CollectionReturnCode">
                <xs:annotation>
                  <xs:documentation>
                    An identifier of the Collection to which this Summarised Actual belongs (R01, R02, R03,….. R13, R14) {Rolled up from the Summarised Actuals}
                  </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="10"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ActualsPeriod" type="adf:ActualsPeriodTYPE" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="AggregatedPaymentPeriods"  minOccurs="0" maxOccurs="1">
          <xs:annotation>
            <xs:documentation>Only present if there are payable deliverables.</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="AggregatedPaymentPeriod" type="adf:AggregatedPaymentPeriodTYPE" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

      </xs:sequence>

      <xs:attributeGroup ref="adf:SchemaVersionAttribute"/>

    </xs:complexType>
  </xs:element>
</xs:schema>
