<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2015 sp2 (http://www.altova.com) by Dean Holmes (Ciber) -->
<xs:schema xmlns:org="urn:sfa:schemas:organisation" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" targetNamespace="urn:sfa:schemas:organisation" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.11">
	<xs:simpleType name="organisationId">
		<xs:annotation>
			<xs:documentation>The Identifier used to identify the Organisation as used in the Organisation entity
</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger"/>
	</xs:simpleType>
	<xs:simpleType name="alternativeOrganisationId">
		<xs:annotation>
			<xs:documentation>An alternative identifier used to uniquely identify this Organisation</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="50"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="organisationIdentifierType">
		<xs:annotation>
			<xs:documentation>The commonly used name used to describe what the Organisation Identifier is</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UPIN"/>
			<xs:enumeration value="UK PROVIDER REFERENCE NUMBER"/>
			<xs:enumeration value="UNIQUE REFERENCE NUMBER(EDUBASE)"/>
			<xs:enumeration value="DEPARTMENT FOR EDUCATION ESTABLISHMENT NUMBER"/>
			<xs:enumeration value="LOCAL EDUCATION AUTHORITY NUMBER"/>
			<xs:enumeration value="OFSTED NON EDUBASE PROVIDER URN"/>
			<xs:enumeration value="DENI NUMBER"/>
			<xs:enumeration value="SECTOR LEAD BODY"/>
			<xs:enumeration value="AWARDING ORGANISATION"/>
			<xs:enumeration value="ONS LOCAL AUTHORITY CODE"/>
			<xs:enumeration value="LA AND SCHOOL ESTABLISHMENT CODE (EDUBASE)"/>
			<xs:enumeration value="ISSUING AUTHORITY"/>
			<xs:enumeration value="OFSTED INSPECTION NUMBER"/>
			<xs:enumeration value="OFQUAL RECOGNITION NUMBER"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="addressType">
		<xs:annotation>
			<xs:documentation>Classifies addresses that have fundermentally different address structures</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UK"/>
			<xs:enumeration value="BFPO"/>
			<xs:enumeration value="INTERNATIONAL"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="organisationStatusSchemeType">
		<xs:annotation>
			<xs:documentation>Identifies the scheme that the Organisation Status is part of</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LEGAL"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="organisationTypeSchemeType">
		<xs:annotation>
			<xs:documentation>Identifies the scheme that the Organisation Type is part of</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="CORPORATE"/>
			<xs:enumeration value="CONTRACT"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="organisationRelationshipType">
		<xs:annotation>
			<xs:documentation>A relationship can exist between two Organisations for more than one reason and this attribute describes the nature of the relationship (eg ORGANISATION STRUCTURE, RESIDES WITHIN, CONTRACTOR, SIXTH FORM CONSORTIA, FUNDING, MULTIPLE UPIN)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AGENCY MANAGING"/>
			<xs:enumeration value="ORGANISATION STRUCTURE"/>
			<xs:enumeration value="RESIDES WITHIN"/>
			<xs:enumeration value="CONTRACTOR"/>
			<xs:enumeration value="SIXTH FORM CONSORTIA"/>
			<xs:enumeration value="FUNDING"/>
			<xs:enumeration value="MULTIPLE UPIN"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="parentOrChildRoleType">
		<xs:annotation>
			<xs:documentation>Explains the role a Parent or Child organisation would play in such a relationship. Without this clarification it would not, in all cases, be clear which organisation should be the parent and which should be the child.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="UK LEARNING PROVIDER"/>
			<xs:enumeration value="AGENCY TRAINING PROVIDER"/>
			<xs:enumeration value="FUNDING BODY"/>
			<xs:enumeration value="EDUCATION PROVIDER"/>
			<xs:enumeration value="LOCAL AUTHORITY"/>
			<xs:enumeration value="REGISTERED COMPANY"/>
			<xs:enumeration value="REGISTERED CHARITY"/>
			<xs:enumeration value="AUDITOR"/>
			<xs:enumeration value="AWARDING ORGANISATION"/>
			<xs:enumeration value="SECTOR LEAD BODY"/>
			<xs:enumeration value="REGULATOR"/>
			<xs:enumeration value="LEARNING ASSESSEE"/>
			<xs:enumeration value="ISSUING AUTHORITY"/>
			<xs:enumeration value="NORTHERN IRELAND ELB"/>
			<xs:enumeration value="NORTHERN IRELAND EDUCATION PROVIDER"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="organisationNameType">
		<xs:annotation>
			<xs:documentation>A controlled value that describes the type of name such as Legal, Trading</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LEGAL"/>
			<xs:enumeration value="TRADING"/>
			<xs:enumeration value="HISTORIC TRADING"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="addressPurposeType">
		<xs:annotation>
			<xs:documentation>Used to explain precisely the purpose and scope of each Organisation Address Purpose - in other words the purpose to which an Address can be put</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="PRIMARY"/>
			<xs:enumeration value="LEGAL"/>
			<xs:enumeration value="HEAD OFFICE"/>
			<xs:enumeration value="VENUE"/>
			<xs:enumeration value="FINANCIAL"/>
			<xs:enumeration value="PIMS LEGACY"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="locatorType">
		<xs:annotation>
			<xs:documentation>A controlled value used to determine the type of this Locator</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="EMAIL"/>
			<xs:enumeration value="TELEPHONE"/>
			<xs:enumeration value="FAX"/>
			<xs:enumeration value="URL"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="timeStamps">
		<xs:annotation>
			<xs:documentation>Attribute group to hold dateTimeCreated and dateTimeUpdated attributes</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="dateTimeCreated" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>The date and time the data in this element was created.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dateTimeUpdated" type="xs:dateTime">
				<xs:annotation>
					<xs:documentation>The date and time the data in this element was most recently updated.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="effectiveDateRange">
		<xs:annotation>
			<xs:documentation>Attribute group to hold effectiveTo and effectiveFrom attributes</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="effectiveFrom" type="xs:dateTime" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The date and time the data in this element is effective from.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="effectiveTo" type="xs:dateTime" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>
            The date and time the data in this element is effective to. Open ended if not specified.
          </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="organisation">
		<xs:annotation>
			<xs:documentation>An Organisation that is of interest to the Skills Funding Agency. This might be a stand alone organisation, a conglomerate or a department or subset of an organisation.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="organisationId" type="org:organisationId">
					<xs:annotation>
						<xs:documentation>This is the primary identifier for the Organisation</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="organisationIdentifiers" type="org:organisationIdentifiers" minOccurs="1" maxOccurs="1"/>
				<xs:element name="organisationNames" type="org:organisationNames" minOccurs="1" maxOccurs="1"/>
				<xs:element name="organisationAddresses" type="org:organisationAddresses" minOccurs="1" maxOccurs="1"/>
				<xs:element name="organisationContacts" type="org:organisationContacts" minOccurs="1" maxOccurs="1"/>
				<xs:element name="organisationTypeRelationships" type="org:organisationTypeRelationships" minOccurs="1" maxOccurs="1"/>
				<xs:element name="organisationStatusRelationships" type="org:organisationStatusRelationships" minOccurs="1" maxOccurs="1"/>
				<xs:element name="organisationRelationships" type="org:organisationRelationships" minOccurs="1" maxOccurs="1"/>
				<xs:element name="organisationLocators" type="org:organisationLocators" minOccurs="1" maxOccurs="1"/>
				<xs:element name="effectiveDateRange" type="org:effectiveDateRange"/>
				<xs:element name="timeStamps" type="org:timeStamps"/>
			</xs:sequence>
			<xs:attribute name="schemaVersion" use="required" fixed="1.11">
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:totalDigits value="3"/>
						<xs:fractionDigits value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="organisationIdentifiers">
		<xs:annotation>
			<xs:documentation>List of identifiers used by bodies to identify this Organisation.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisationIdentifier" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>An alternative identifier used by a body to identify this Organisation. The purpose of the identifier is given by the identifier name.</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="organisationIdentifier" type="org:alternativeOrganisationId">
							<xs:annotation>
								<xs:documentation>The alternative identifier used to identify this Organisation.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="organisationIdentifierType" type="org:organisationIdentifierType">
							<xs:annotation>
								<xs:documentation>The name of the identifier, identifies the purpose of the identifier.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="effectiveDateRange" type="org:effectiveDateRange"/>
						<xs:element name="timeStamps" type="org:timeStamps"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationAddresses">
		<xs:annotation>
			<xs:documentation>List of addresses used by this organisation</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisationAddress" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>An address associated to an Organisation</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="addressLine1" type="xs:string" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Line 1 in an address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="addressLine2" type="xs:string" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Line 2 in an address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="addressLine3" type="xs:string" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Line 3 in an address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="addressLine4" type="xs:string" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Line 4 in an address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="addressLine5" type="xs:string" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Line 5 in an address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="town" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Town of this address</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="30"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="postcode" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Postcode of this address</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="8"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="easting" type="xs:decimal" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Easting for this address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="northing" type="xs:decimal" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Northing for this address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="osGridReference" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>Ordnance Survey National Grid Reference for this address</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="12"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="bfpoNumber" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>British Forces Post Office number for this address</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="30"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="addressPurposes" type="org:addressPurposes">
							<xs:annotation>
								<xs:documentation>List of purposes for this address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="addressLocator" type="org:locator" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Locator for this address</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="addressType" type="org:addressType">
							<xs:annotation>
								<xs:documentation>Classifies addresses that have fundermentally different address structures</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="addressIdentifier" type="xs:int">
							<xs:annotation>
								<xs:documentation>An identifier of an Address. Without a meaningful and managable natural key of Address, it will be necessary to surface a unique identifier</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="effectiveDateRange" type="org:effectiveDateRange"/>
						<xs:element name="timeStamps" type="org:timeStamps"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationContacts">
		<xs:annotation>
			<xs:documentation>Lists of contacts for this organisation</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisationContact" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A contact  for this organisation</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="contactRoles" type="org:contactRoles">
							<xs:annotation>
								<xs:documentation>List of roles for this contact</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="contactLocator" type="org:locator" maxOccurs="unbounded">
							<xs:annotation>
								<xs:documentation>Locator for this contact</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="contactIdentifier" type="xs:int">
							<xs:annotation>
								<xs:documentation>An identifier of a Contact. Without a meaningful and managable natural key of Contact, it will be necessary to surface a unique identifier</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="title" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>A Title of the Contact, as supplied by the Organisation</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="255"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="initials" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>The initials of the forenames of the Contact, as supplied by the Organisation</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="30"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="firstName" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>The first name of the Contact, as supplied by the Organisation</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="255"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="lastName">
							<xs:annotation>
								<xs:documentation>The last name of the Contact, as supplied by the Organisation</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="255"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="positionInOrganisation" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>The position hled by the Contact witihn the Organisation, as supplied by the Organisation</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="255"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="effectiveDateRange" type="org:effectiveDateRange"/>
						<xs:element name="timeStamps" type="org:timeStamps"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationStatusRelationships">
		<xs:annotation>
			<xs:documentation>List of statuses for an organisation</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisationStatusRelationship" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>An Organisation Status Relationship for this organisation</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="organisationStatus">
							<xs:annotation>
								<xs:documentation>A value used to describe the status of Organisation.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="organisationStatusScheme" type="org:organisationStatusSchemeType">
										<xs:annotation>
											<xs:documentation>Identifies the scheme that the Organisation Status is part of</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="organisationStatus">
										<xs:annotation>
											<xs:documentation>A value used to describe the status of Organisation. This describes the status of organsation and is not a surrogate code to represent it.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="100"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="parentOrganisationStatus" minOccurs="0" maxOccurs="1">
										<xs:annotation>
											<xs:documentation>In the case where an Organisation status instance is multi-level, this attribute identifies the parent Organisation status Code - which must be part of the same Organisation status Scheme (so the Organisation status Scheme value is also required to retrieve the parent)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="100"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="effectiveDateRange" type="org:effectiveDateRange"/>
						<xs:element name="timeStamps" type="org:timeStamps"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationTypeRelationships">
		<xs:annotation>
			<xs:documentation>List of types for an organisation</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisationTypeRelationship" minOccurs="1" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>An organisation type relationship for this organisation</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="organisationType">
							<xs:annotation>
								<xs:documentation>A value used to describe the type of Organisation.</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="organisationTypeScheme" type="org:organisationTypeSchemeType">
										<xs:annotation>
											<xs:documentation>Identifies the scheme that the Organisation Type is part of</xs:documentation>
										</xs:annotation>
									</xs:element>
									<xs:element name="organisationType">
										<xs:annotation>
											<xs:documentation>A value used to describe the type of Organisation. This describes the type of organsation and is not a surrogate code to represent it.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="100"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="parentOrganisationType" minOccurs="0" maxOccurs="1">
										<xs:annotation>
											<xs:documentation>In the case where an Organisation Type instance is multi-level, this attribute identifies the parent Organisation Type - which must be part of the same Organisation Type Scheme (so the Organisation Type Scheme value is also required to retrieve the parent)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="100"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="effectiveDateRange" type="org:effectiveDateRange"/>
						<xs:element name="timeStamps" type="org:timeStamps"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationRelationships">
		<xs:annotation>
			<xs:documentation>List of relationships for an organisation</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisationRelationship" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A relationship for this organisation</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element ref="org:organisationRelationshipType">
							<xs:annotation>
								<xs:documentation>A relationship can exist between two Organisations for more than one reason and this attribute describes the nature of the relationship (eg ORGANISATION STRUCTURE, RESIDES WITHIN, CONTRACTOR, SIXTH FORM CONSORTIA, FUNDING, MULTIPLE UPIN)</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="organisationIdentifierParent" type="xs:int">
							<xs:annotation>
								<xs:documentation>Identifies the parent Organisation within a relationship. Precisely what 'parent' means depends on the Organisation Relationship Type can this is defined in the Organisation Relationship Type entity</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="organisationIdentifierChild" type="xs:int">
							<xs:annotation>
								<xs:documentation>Identifies the child Organisation within a relationship. Precisely what 'child' means depends on the Organisation Relationship Type can this is defined in the Organisation Relationship Type entity</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="purpose" minOccurs="0" maxOccurs="1">
							<xs:annotation>
								<xs:documentation>A verbose description of the purpose or purposes of the Organisation Relationship</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="500"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="effectiveDateRange" type="org:effectiveDateRange"/>
						<xs:element name="timeStamps" type="org:timeStamps"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:element name="organisationRelationshipType">
		<xs:annotation>
			<xs:documentation>Type of an organisation relationship</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="organisationRelationshipType" type="org:organisationRelationshipType">
					<xs:annotation>
						<xs:documentation>A relationship can exist between two Organisations for more than one reason and this attribute describes the nature of the relationship (eg ORGANISATION STRUCTURE, RESIDES WITHIN, CONTRACTOR, SIXTH FORM CONSORTIA, FUNDING, MULTIPLE UPIN)</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="parentRole" type="org:parentOrChildRoleType" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>Explains the role a Parent organisation would play in such a relationship. Without this clarification it would not, in all cases, be clear which organisation should be the parent and which should be the child.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="childRole" type="org:parentOrChildRoleType" minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation>Explains the role a Child organisation would play in such a relationship. Without this clarification it would not, in all cases, be clear which organisation should be the parent and which should be the child.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
