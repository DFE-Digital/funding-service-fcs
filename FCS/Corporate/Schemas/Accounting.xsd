<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ACC="urn:sfa:schemas:accounting" targetNamespace="urn:sfa:schemas:accounting" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2.00">
	<!-- definition of simple elements -->
<xs:simpleType name="SubnominalTypeTYPE">
	<xs:restriction base="xs:string">
		<xs:length value="50"/>
		<xs:enumeration value="BUDGETING"/>
		<xs:enumeration value="PAYMENT"/>
		<xs:enumeration value="PROFILE"/>
		<xs:enumeration value="CAPPING"/>
		<xs:enumeration value="RECONCILIATION"/>
	</xs:restriction>
</xs:simpleType>
	<!-- definition of complex types (mainly CVLs - data that is unlikely to be surfaced on its own)  -->
	<!-- definition of complex elements without any references to anything -->
	<xs:element name="Subnominal">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Subnominalcode" >
				      <xs:simpleType>
					   <xs:restriction base="xs:string">
					   <xs:maxLength value="8"/>
					  </xs:restriction>
					  </xs:simpleType>
				  </xs:element>
				  	<xs:element name="Description" >
				      <xs:simpleType>
					   <xs:restriction base="xs:string">
					   <xs:maxLength value="50"/>
					  </xs:restriction>
					  </xs:simpleType>
				  </xs:element>
				  <xs:element name="ShortDescription" minOccurs="0">
				      <xs:simpleType>
					   <xs:restriction base="xs:string">
					   <xs:maxLength value="20"/>
					  </xs:restriction>
					  </xs:simpleType>
				  </xs:element>
				  <xs:element name="SubnominalType" type="ACC:SubnominalTypeTYPE"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
