  <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 --></configSections>
  <TransportConfig MaximumConcurrencyLevel="1" MaxRetries="0" />
  <SecondLevelRetriesConfig Enabled="false" />
  <MessageForwardingInCaseOfFaultConfig ErrorQueue="error" />
  <AuditConfig QueueName="audit" />
  <UnicastBusConfig>
    <MessageEndpointMappings>
      <add Assembly="CrossDomain.Integration.Messages" Type="SFA.FCT.CrossDomain.Integration.Messages.Commands.DocumentGenerationCommand" Endpoint="DocumentsDomain.GenerateDocument-LUK-R900D4HT" />
      <add Assembly="OrganisationDomain.Integration.Messages" Namespace="OrganisationDomain.Integration.Messages.Commands" Endpoint="OrgService.Main" />
      <add Assembly="ContractManagementService.Common" Namespace="SFA.FCT.ContractManagementService.Common.Messages" Endpoint="contractmanagementdomain.contractapproved" />
    </MessageEndpointMappings>
  </UnicastBusConfig>
