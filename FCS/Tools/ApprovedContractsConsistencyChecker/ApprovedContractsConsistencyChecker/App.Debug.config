<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="CrmConnectionString" connectionString=""
         xdt:Transform="SetAttributes(connectionString)" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="ContractManagementServiceUrl" value="http://localhost:45109" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractManagementService:Tenant" value="fcsazuresfabisgov.onmicrosoft.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractManagementService:ClientId" value="8ce1a821-9d0e-474b-84ed-19c6d982720e" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractManagementService:AppKey" value="" xdt:TContractManagementServiceransform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractManagementService:ResourceId" value="http://fcsazuresfabisgov.onmicrosoft.com/FCS-DEV-ContractManagementService" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractManagementService:AADInstance" value="https://login.microsoftonline.com/{0}" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>