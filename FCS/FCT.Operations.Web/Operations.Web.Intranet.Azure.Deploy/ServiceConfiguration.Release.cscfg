<ServiceConfiguration serviceName="Operations.Web.Intranet.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="Operations.Web">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="" />
      <Setting name="APPINSIGHTS_INSTRUMENTATIONKEY" value="" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="SSLCertificate" thumbprint="870dad554483bfd8a3aca255e1bfccc795ca0de2" thumbprintAlgorithm="sha1" />
      <Certificate name="CPDSAuth" thumbprint="1D41AE063B34F3D53762C7E55B4B01823ABF1D04" thumbprintAlgorithm="sha1" />
      <Certificate name="DedsAuth" thumbprint="26B8F09E3535FF89826F2AFA0BB0CEB7EC183FDC" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="fcsprod-vnet" />
    <AddressAssignments>
      <InstanceAddress roleName="Operations.Web">
        <Subnets>
          <Subnet name="Operations" />
        </Subnets>
      </InstanceAddress>
    </AddressAssignments>
    <LoadBalancers>
      <LoadBalancer name="fcs-opsweb-ilb">
        <FrontendIPConfiguration type="private" subnet="Operations" staticVirtualNetworkIPAddress="10.78.101.110" />
      </LoadBalancer>
    </LoadBalancers>
  </NetworkConfiguration>
</ServiceConfiguration>