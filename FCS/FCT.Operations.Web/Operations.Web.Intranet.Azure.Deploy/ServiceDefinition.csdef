<?xml version="1.0" encoding="utf-8"?>
<ServiceDefinition name="Operations.Web.Intranet.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceDefinition" schemaVersion="2015-04.2.6">
  <WebRole name="Operations.Web" vmsize="Small">
    <Sites>
      <Site name="Web">
        <Bindings>
          <Binding name="OpsWebEndpoint" endpointName="OpsWebEndpoint" />
        </Bindings>
      </Site>
    </Sites>
    <Certificates>
      <Certificate name="SSLCertificate" storeLocation="LocalMachine" storeName="CA" />
      <Certificate name="CPDSAuth" storeLocation="LocalMachine" storeName="My" />
      <Certificate name="DedsAuth" storeLocation="LocalMachine" storeName="My" />
    </Certificates>
    <Endpoints>
      <InputEndpoint name="OpsWebEndpoint" protocol="https" localPort="443" port="443" certificate="SSLCertificate" loadBalancer="fcs-opsweb-ilb" />
    </Endpoints>
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" />
      <Setting name="APPINSIGHTS_INSTRUMENTATIONKEY" />
    </ConfigurationSettings>
  </WebRole>
</ServiceDefinition>