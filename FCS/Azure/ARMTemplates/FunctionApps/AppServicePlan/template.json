{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentTag": {
      "type": "string"
    },
    "parentBusinessTag": {
      "type": "string"
    },
    "portfolioTag": {
      "type": "string"
    },
    "productTag": {
      "type": "string"
    },
    "serviceLineTag": {
      "type": "string"
    },
    "aspLocation": {
      "type": "string"
    },
    "sharedAppServicePlanSKU": {
      "defaultValue": {
        "tier": "Basic",
        "size": "1",
        "instances": 1
      },
      "type": "object",
      "metadata": {
        "description": "An object representing the SKU of the App Service plan."
      },
      "deploymentUrlBase": {
      "type": "string",
      "metadata": {
        "description": "The root url which holds all of the linked templates used by this template, a parameter to ease testing."
      }
    }
    }
  },
  "variables": {
    "subscriptionShortCode": "[split(resourceGroup().name, '-')[1]]",
    "appServicePlanName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-plan-fa')]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2019-05-01",
      "name": "Deploy_shared_app_service_plan_for_function_apps",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'app-service-plan.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "aspLocation": {
            "value": "[parameters('aspLocation')]"
          },
          "appServicePlanName": {
            "value": "[variables('appServicePlanName')]"
          },
          "aspSize": {
            "value": "[parameters('sharedAppServicePlanSKU').size]"
          },
          "aspInstances": {
            "value": "[parameters('sharedAppServicePlanSKU').instances]"
          },
          "nonASETier": {
            "value": "[parameters('sharedAppServicePlanSKU').tier]"
          }
        }
      }
    }
  ]
}