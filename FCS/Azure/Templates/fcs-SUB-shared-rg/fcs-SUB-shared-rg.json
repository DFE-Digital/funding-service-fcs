/*
  AIM: to create the shared infrastructure that will support individual environments created by other templates
*/

{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentTag": {
      "type": "string"
    },
    "parentBusinessTag": {
      "type": "string"
    },
    "portfolioTag": {
      "type": "string"
    },
    "productTag": {
      "type": "string"
    },
    "serviceLineTag": {
      "type": "string"
    },
    "sharedAppServicePlanSku": {
      "defaultValue": {
        "tier": "PremiumV2",
        "size": "2",
        "instances": 2
      },
      "type": "Object",
      "metadata": {
        "description": "An object representing the sku of the app service plan."
      }
    },
    "certificateDeployment": {
      "type": "bool",
      "metadata": {
        "description": "Only set to true when deploying Certificates during initial deployment or subsequent update"
      },
      "defaultValue": false
    },
    "CertificatesToImport": {
      "type": "secureString",
      "metadata": {
        "description": "a string containing an array of objects each with a name and certificate base64 encoded, eg: [{\"name\":\"cert1\",\"certificate\":\"base64encodedcert\"}]"
      },
      "defaultValue": "[[]"
    },
    "emailAddress": {
      "type": "string",
      "metadata": {
        "description": "Action Group Email Address"
      }
    },
    "accessPolicies": {
      "type": "array",
      "metadata": {
        "description": "KeyVault Access Policies"
      }
    },
    "existingAccessPolicies": {
      "type": "object",
      "metadata": {
        "description": "Existing Access Policies"
      }
    },
      "deploymentUrlBase": {
      "type": "string",
      "metadata": {
        "description": "The root url which holds all of the linked templates used by this template, a parameter to ease testing."
      }
    }
  },
  "variables": {
    "subscriptionShortCode": "[split(resourceGroup().name, '-')[1]]",
    "keyVaultName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-kv')]",
    "logAnalyticsName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-la')]",
    "actionGroupName": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-ag')]",
    "actionGroupShortName": "[concat('fcs', variables('subscriptionShortCode'), '-sh-ag')]",
    "emailActionName": "[concat('fcs', variables('subscriptionShortCode'), 'email-action')]",
    "toDisplayName": {
      "northeurope": "North Europe",
      "westeurope": "West Europe"
    },
    "certs": "[json(parameters('CertificatesToImport'))]"
  },
  "resources": [
    {
      "name": "Deploy_Action_Group",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2019-10-01",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'action-group.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "actionGroupName": {
            "value": "[variables('actionGroupName')]"
          },
          "actionGroupShortName": {
            "value": "[variables('actionGroupShortName')]"
          },
          "emailActionName": {
            "value": "[variables('emailActionName')]"
          },
          "emailAddress": {
            "value": "[parameters('emailAddress')]"
          }
        }
      }
    },
    {
      /* 
        This key vault holds the certificates used by the environment APPs and FUNCs
        Environment specific secrets are not held in this key vault
      */
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2019-05-01",
      "name": "Deploy_Shared_KeyVault",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'keyvault.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "keyVaultName": {
            "value": "[variables('keyVaultName')]"
          },
          "enableSoftDelete": {
            "value": true
          },
          "enablePurgeProtection": {
            "value": true
          },
          "keyVaultAccessPolicies": {
            "value": "[parameters('existingAccessPolicies').list]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2019-05-01",
      "name": "[concat('Deploy_Certifiate_', copyIndex(),'_To_Plan')]",
      "condition": "[and(greater(length(variables('certs')),0),parameters('certificateDeployment'))]",
      "dependsOn": [
        "[concat('Microsoft.Resources/deployments/', 'Deploy_KeyVault_Policy')]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'app-service-certificate.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "keyVaultCertificateName": {
            "value": "[variables('certs')[copyIndex()].name]"
          },
          "keyVaultName": {
            "value": "[variables('keyVaultName')]"
          },
          "keyVaultResourceGroup": {
            "value": "[resourceGroup().name]"
          }
        }
      },
      "copy": {
        "name": "certsToPlanCopy",
        "count": "[if (greater(length(variables('certs')),0), length(variables('certs')), 1)]"
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2019-05-01",
      "name": "Deploy_KeyVault_Policy",
      "dependsOn": [
        "[concat('Microsoft.Resources/deployments/', 'Deploy_Shared_KeyVault')]"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'keyvault-accesspolicies.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "keyVaultName": {
            "value": "[variables('keyVaultName')]"
          },
          "accessPolicies": {
            "value": "[parameters('accessPolicies')]"
          }
        }
      }
    },
    {
      /*
        All APPs and FUNCs within the environments hosted within the SUB are hosted on this app service plan
      */
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2019-05-01",
      "name": "Shared-app-service-plan",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'app-service-plan.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "aspLocation": {
            "value": "[variables('toDisplayName')[resourceGroup().location]]"
          },
          "appServicePlanName": {
            "value": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-plan-win-01')]"
          },
          "aspSize": {
            "value": "[parameters('sharedAppServicePlanSku').size]"
          },
          "aspInstances": {
            "value": "[parameters('sharedAppServicePlanSku').instances]"
          },
          "nonASETier": {
            "value": "[parameters('sharedAppServicePlanSku').tier]"
          }
        }
      }
    },
    {
      /*
        This virtual network exists to allow ipSecurityRestrictions to use SNET resource ids rather than using
        IP addresses.  This reduces the complexity of the rules and the templates required to implement them.
      */
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2017-05-10",
      "name": "Shared-virtual-network",
      "dependsOn": [],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'virtual-network.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "armVnetName": {
            "value": "[concat('fcs-', variables('subscriptionShortCode'), '-shared-vnet-01')]"
          },
          "armVnetAddressSpaceCIDR": {
            /* as the VNET is isolated we can choose the IP address range we want to use */
            "value": "10.100.0.0/16"
          },
          "subnetConfiguration": {
            "value": [
              {
                /* 
                  this SNET is intended to be the target for APP/FUNC VNET Integration so that we can 
                  use it for firewall rules in other resources such as storage and SQL DB.
                */
                "name": "appServiceVNetIntegration",
                "properties": {
                  "addressPrefix": "10.100.0.0/24",
                  "serviceEndpoints": [
                    {
                      "service": "Microsoft.AzureActiveDirectory"
                    },
                    {
                      "service": "Microsoft.KeyVault"
                    },
                    {
                      "service": "Microsoft.ServiceBus"
                    },
                    {
                      "service": "Microsoft.Sql"
                    },
                    {
                      "service": "Microsoft.Storage"
                    },
                    {
                      "service": "Microsoft.Web"
                    }
                  ],
                  "delegations": [
                    {
                      "name": "d5f10390350c4bc7a079895c334b7ad9",
                      "properties": {
                        "serviceName": "Microsoft.Web/serverFarms"
                      }
                    }
                  ],
                  "privateEndpointNetworkPolicies": "Enabled",
                  "privateLinkServiceNetworkPolicies": "Enabled"
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "Deploy_LogAnalytics",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2017-05-10",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "uri": "[concat(parameters('deploymentUrlBase'),'log-analytics.json')]",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "environmentTag": {
            "value": "[parameters('environmentTag')]"
          },
          "parentBusinessTag": {
            "value": "[parameters('parentBusinessTag')]"
          },
          "portfolioTag": {
            "value": "[parameters('portfolioTag')]"
          },
          "productTag": {
            "value": "[parameters('productTag')]"
          },
          "serviceLineTag": {
            "value": "[parameters('serviceLineTag')]"
          },
          "logAnalyticsName": {
            "value": "[variables('logAnalyticsName')]"
          },
          "logAnalyticsLocation": {
            "value": "[variables('toDisplayName')[resourceGroup().location]]"
          }
        }
      }
    }
  ]
}
