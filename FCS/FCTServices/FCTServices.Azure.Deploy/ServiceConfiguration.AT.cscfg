<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="FCTServices.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="ContractManagementService">
    <Instances count="2" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="DefaultEndpointsProtocol=https;AccountName=fcsappstoragedev;AccountKey=" />
      <Setting name="Microsoft.WindowsAzure.Plugins.RemoteForwarder.Enabled" value="true" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="SSLCertificate" thumbprint="F96341234ED529C5426035B9D2D08FF47454F263" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="Group fcs-env-shared-rg fcs-env-shared-asm-vnet-01" />
    <AddressAssignments>
      <InstanceAddress roleName="ContractManagementService">
        <Subnets>
          <Subnet name="default" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <!--137.135.205.239-->
        <ReservedIP name="fct-services-at-rip" />
      </ReservedIPs>
    </AddressAssignments>
  </NetworkConfiguration>
</ServiceConfiguration>