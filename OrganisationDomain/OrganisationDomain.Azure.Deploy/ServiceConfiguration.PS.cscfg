<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="OrganisationDomain.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="OrganisationDomain.Web">
    <Instances count="2" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="DefaultEndpointsProtocol=https;AccountName=fcsopsupappstorage;AccountKey=" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="SSLCertificate" thumbprint="6AB801B08143043CF4CBDFCF33B25616A7757D6C" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="OpSup-VNet" />
    <AddressAssignments>
      <InstanceAddress roleName="OrganisationDomain.Web">
        <Subnets>
          <Subnet name="Contract" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <ReservedIP name="fct-orgservice-ps-rip" />
      </ReservedIPs>
    </AddressAssignments>
    <AccessControls>
      <AccessControl name="subnetonly">
        <Rule action="permit" description="fsc" order="50" remoteSubnet="23.97.220.108/32" />
        <Rule action="permit" description="orgservice" order="51" remoteSubnet="23.97.172.27/32" />
        <Rule action="permit" description="servicebus" order="52" remoteSubnet="23.97.173.11/32" />
        <Rule action="permit" description="contractservice" order="53" remoteSubnet="137.117.164.30/32" />
        <Rule action="permit" description="mysubnet" order="100" remoteSubnet="10.78.113.64/28" />
        <Rule action="deny" description="denyall" order="200" remoteSubnet="0.0.0.0/0" />
      </AccessControl>
    </AccessControls>
    <EndpointAcls>
      <EndpointAcl role="OrganisationDomain.Web" endPoint="Endpoint1" accessControl="subnetonly" />
    </EndpointAcls>
  </NetworkConfiguration>
</ServiceConfiguration>