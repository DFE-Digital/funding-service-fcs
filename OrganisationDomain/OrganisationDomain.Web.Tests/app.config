        <bindingRedirect oldVersion="0.0.0.0-1.2.0.5639" newVersion="1.2.0.5639" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <appSettings>
    <add key="GetOrgAsyncWaitTimeInSeconds" value="30" />
    <add key="ida:Tenant_OrgService" value="fcsazuresfabisgov.onmicrosoft.com" />
    <add key="ida:ClientId_OrgService" value="abe3ee50-8cf5-42ac-aae1-3f161ff6eb71" />
    <add key="ida:AppKey_OrgService" value="" /> <!-- client secret -->
    <add key="ida:ResourceId_OrgService" value="http://fcsazuresfabisgov.onmicrosoft.com/FCS-DEV-OrgServiceService" />
    <add key="ida:AADInstance_OrgService" value="https://login.microsoftonline.com/{0}" />
  </appSettings>
  <connectionStrings>
    <add name="organisationDomainDatabase" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
    <contexts>
      <context type="OrganisationDomain.Integration.DataStore.OrganisationDomainDbContext, OrganisationDomain.Integration.DataStore" disableDatabaseInitialization="true" />
    </contexts>
  </entityFramework>
