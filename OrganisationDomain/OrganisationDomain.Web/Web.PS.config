<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="NServiceBus/Transport"
         connectionString=""
         xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
  </connectionStrings>

  <appSettings>
    <add key="GetOrgAsyncWaitTimeInSeconds"
         value="60"
         xdt:Transform="Replace" xdt:Locator="Match(key)"/>
  </appSettings>

  <system.web>
    
  </system.web>
  <appSettings>
    <add key="GetOrgAsyncWaitTimeInSeconds" value="60" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="iKey" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>