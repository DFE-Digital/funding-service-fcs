<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="Operations.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="Operations.Worker">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="" />
      <Setting name="Microsoft.WindowsAzure.Plugins.RemoteForwarder.Enabled" value="false" />
    </ConfigurationSettings>
    <Certificates>
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="FCSProd-VNet" />
    <AddressAssignments>
      <InstanceAddress roleName="Operations.Worker">
        <Subnets>
          <Subnet name="Operations" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <ReservedIP name="fct-operations-release-rip" />
      </ReservedIPs>
    </AddressAssignments>
  </NetworkConfiguration>
</ServiceConfiguration>