<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="ContractManagementDomain.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="4" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="ContractManagementService">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.RemoteForwarder.Enabled" value="true" />
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="Microsoft.WindowsAzure.Plugins.RemoteAccess.PasswordEncryption" thumbprint="630ACF9857AC6DBD79ED146191A5751EDDD9F45B" thumbprintAlgorithm="sha1" />
      <Certificate name="SSLCertificate" thumbprint="40FBF11C2A136D4869141C5B965B7B45CDB3320A" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="FCSProd-VNet" />
    <AddressAssignments>
      <InstanceAddress roleName="ContractManagementService">
        <Subnets>
          <Subnet name="Contract" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <ReservedIP name="fct-contractservice-release-rip" />
      </ReservedIPs>
    </AddressAssignments>
