<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="ContractManagementDomain.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="4" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="ContractManagementService">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.RemoteForwarder.Enabled" value="true" />
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="DefaultEndpointsProtocol=https;AccountName=fcsopsupappstorage;AccountKey=" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="Microsoft.WindowsAzure.Plugins.RemoteAccess.PasswordEncryption" thumbprint="630ACF9857AC6DBD79ED146191A5751EDDD9F45B" thumbprintAlgorithm="sha1" />
      <Certificate name="SSLCertificate" thumbprint="ADD7FA747D8B39A4A291BA32015ED80CC294BB2C" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="OpSup-VNet" />
    <AddressAssignments>
      <InstanceAddress roleName="ContractManagementService">
        <Subnets>
          <Subnet name="Contract" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <ReservedIP name="fct-contractservice-ps-rip" />
      </ReservedIPs>
    </AddressAssignments>
    <EndpointAcls>
      <EndpointAcl role="ContractManagementService" endPoint="Endpoint1" accessControl="subnetonly" />
    </EndpointAcls>
  </NetworkConfiguration>
</ServiceConfiguration>