<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="FCTServices.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="ContractManagementService">
    <Instances count="2" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="DefaultEndpointsProtocol=https;AccountName=fctappstorageoat;AccountKey=" />
      <Setting name="Microsoft.WindowsAzure.Plugins.RemoteForwarder.Enabled" value="true" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="SSLCertificate" thumbprint="CF13E1B540D7D9946928EB4AA1A31ED21E02C90B" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="FCSPreProd-VNet" />
    <AddressAssignments>
      <InstanceAddress roleName="ContractManagementService">
        <Subnets>
          <Subnet name="Contract" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <ReservedIP name="fct-services-doat-rip" />
      </ReservedIPs>
    </AddressAssignments>
