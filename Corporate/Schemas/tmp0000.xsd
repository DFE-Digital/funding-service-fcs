<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2015 sp2 (x64) (http://www.altova.com) by Joe Ingledew (N/A) -->
<xs:schema xmlns:ctr="contract" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" targetNamespace="contract" elementFormDefault="qualified" attributeFormDefault="unqualified" version="0.02" vc:minVersion="1.1">
	<xs:element name="contract">
		<xs:annotation>
			<xs:documentation>
        Higher level contracts that suuport the legalisation of allocations
      </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="contracts">
					<xs:complexType>
						<xs:sequence minOccurs="0" maxOccurs="unbounded">
							<xs:element ref="ctr:contract"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="fundingType" type="ctr:fundingType" minOccurs="0"/>
				<xs:element name="period" type="ctr:period" minOccurs="0"/>
				<xs:element name="fundingStream" type="ctr:fundingStream" minOccurs="0"/>
				<xs:element name="contractAllocations" type="ctr:contractAllocations" minOccurs="0"/>
				<xs:element name="contractDimensionRelationships" type="ctr:contractDimensionRelationships" minOccurs="0"/>
				<xs:element name="contractOrganisationRelationships" type="ctr:contractOrganisationRelationships" minOccurs="0"/>
				<xs:element name="contractNumber">
					<xs:annotation>
						<xs:documentation>
              The unique identifier of a Contract (along with Contract Version Number)
            </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="20"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="contractVersionNumber" type="xs:int">
					<xs:annotation>
						<xs:documentation>
              An identifier used to differentiate the different versions of a Contract.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="description" type="ctr:description" minOccurs="0"/>
				<xs:element name="contractor" type="ctr:contractor"/>
				<xs:element name="hierarchyType" type="ctr:hierarchyType">
					<xs:annotation>
						<xs:documentation>
              Contract is a resursive entity and each level needs to be identified and this attribute does this. It is a controlled list of possible values.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="contractType" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              A classfication of Contract used to determine the template and Terms/Conditions to be added to the Contract
            </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="CONDITIONS OF FUNDING (GRANT)"/>
							<xs:enumeration value="FINANCIAL MEMORANDUM"/>
							<xs:enumeration value="FINANCIAL MEMORANDUM (S6F)"/>
							<xs:enumeration value="CONTRACT FOR SERVICES"/>
							<xs:enumeration value="CONDITIONS OF FUNDING (LARGE EMPLOYERS)"/>
							<xs:enumeration value="CONDITIONS OF FUNDING (LARGE EMPLOYERS - OUTCOME PILOT)"/>
							<xs:enumeration value="24+ ADVANCED LEARNING LOAN EOI"/>
							<xs:enumeration value="24+ ADVANCED LEARNING LOAN FACILITY CONDITIONS"/>
							<xs:enumeration value="CONDITIONS OF FUNDING (GRANT) EMPLOYER"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="startDate" type="xs:date" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              The date from which the Contract is valid. It is probable that the Contract Start and End Dates can be deduced from the earliest start date of Contract Allocations and latest end date of Contract Allocations respectively.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="endDate" type="xs:date" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              The date after which the Contract is no longer valid. It is probable that the Contract Start and End Dates can be deduced from the earliest start date of Contract Allocations and latest end date of Contract Allocations respectively.
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="contractStatus" type="ctr:contractStatusType">
					<xs:annotation>
						<xs:documentation>
              A reference of possible Contract related statuses
            </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="contractValue" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              The value of funding associated with this Contract
            </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:decimal">
							<xs:totalDigits value="15"/>
							<xs:fractionDigits value="2"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="parentContractNumber" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              The Contract Number of the parent Contract (if any)
            </xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:maxLength value="20"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="parentContractVersionNumber" type="xs:int" minOccurs="0">
					<xs:annotation>
						<xs:documentation>
              The Version Number of the parent Contract (if any)
            </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="schemaVersion" use="required" fixed="6.01">
				<xs:annotation>
					<xs:documentation>Version of schema in use. First digit refers to Major version of Data Model the schema conforms to, second digit refers to minor version of the Data Model, and the third digit is for the version of the schema for this version of the data model</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:decimal">
						<xs:totalDigits value="3"/>
						<xs:fractionDigits value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="periodTypeCodeType">
		<xs:annotation>
			<xs:documentation>
        A code used to describe a type of period of time
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="AY"/>
			<xs:enumeration value="FY"/>
			<xs:enumeration value="CY"/>
			<xs:enumeration value="CM"/>
			<xs:enumeration value="CQ"/>
			<xs:enumeration value="ESF"/>
			<xs:enumeration value="EOF"/>
			<xs:enumeration value="EOP"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="periodTypeNameType">
		<xs:annotation>
			<xs:documentation>
        A name used to describe a type of period of time
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACADEMIC YEAR"/>
			<xs:enumeration value="FINANCIAL YEAR"/>
			<xs:enumeration value="CALENDAR YEAR"/>
			<xs:enumeration value="CALENDAR MONTH"/>
			<xs:enumeration value="CALENDAR QUARTER"/>
			<xs:enumeration value="EUROPEAN SOCIAL FUND"/>
			<xs:enumeration value="EMPLOYER OWNERSHIP FUND"/>
			<xs:enumeration value="EMPLOYER OWNERSHIP PILOT"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="description">
		<xs:annotation>
			<xs:documentation>The description or title of the Contract/Contract Allocation</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:maxLength value="255"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="organisationRelationshipType">
		<xs:annotation>
			<xs:documentation>
        The nature of the relationship between a Contract or Contract Allocation and an Organisation
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="LEP"/>
			<xs:enumeration value="FUNDING ORGANISATION"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="hierarchyType">
		<xs:annotation>
			<xs:documentation>
        A reference of possible Contract levels
      </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:enumeration value="MASTER CONTRACT"/>
			<xs:enumeration value="CONTRACT"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="periodTypeType">
		<xs:annotation>
			<xs:documentation>
        A reference of possible types of Period.
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="periodTypeCode" type="ctr:periodTypeCodeType"/>
			<xs:element name="periodTypeName" type="ctr:periodTypeNameType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="fundingType">
		<xs:annotation>
			<xs:documentation>
        A grouping of Funding Streams used to determine Contract related behaviour
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="fundingStream" type="ctr:fundingStream" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="fundingTypeCode">
				<xs:annotation>
					<xs:documentation>
            This is the abbreviation of the Funding Type Name
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="fundingTypeName">
				<xs:annotation>
					<xs:documentation>
            The name of the Funding Type. Funding Type is a collector of Funding Streams (used to control Contract behaviour)
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="period">
		<xs:annotation>
			<xs:documentation>
        A reference list of possible reusable periods of time
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="periodType" type="ctr:periodTypeType"/>
			<xs:element name="fundingStreamPeriods" type="ctr:fundingStreamPeriods"/>
			<xs:element name="period">
				<xs:annotation>
					<xs:documentation>
            A code used to describe the period of time
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:length value="4"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="startDate" type="xs:date">
				<xs:annotation>
					<xs:documentation>
            The first date of the Period
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="endDate" type="xs:date">
				<xs:annotation>
					<xs:documentation>
            The last date of the Period
          </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="fundingStream">
		<xs:annotation>
			<xs:documentation>
        A business construct used to channel funding to providers in support of policy
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="fundingStreamCode">
				<xs:annotation>
					<xs:documentation>
            The code used to identify a Funding Stream
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="fundingStreamName">
				<xs:annotation>
					<xs:documentation>
            The name usually applied to this Funding Stream
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="fundingTypeCode">
				<xs:annotation>
					<xs:documentation>
            The Funding Type of this Funding Stream
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="fundingStreamShortCode">
				<xs:annotation>
					<xs:documentation>
            The code used to identify a Funding Stream (the same or shorter in length than the Funding Stream Code). Exists to support the key used to identifer a Contract Allocation
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="6"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="fundingStreamPeriods">
		<xs:annotation>
			<xs:documentation>
        A list of funding stream periods
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="fundingStreamPeriod" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
            A cross reference realtionship between a Funding Stream and a Period
          </xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="fundingStreamPeriodCode">
							<xs:annotation>
								<xs:documentation>
                  The code used to identify a Funding Stream Period
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="20"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractAllocations">
		<xs:annotation>
			<xs:documentation>
        A list of contract allocations
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="contractAllocation" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
            An allocation within the Contract domain
          </xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="contractAllocations" type="ctr:contractAllocations" minOccurs="0"/>
						<xs:element name="period" type="ctr:period" minOccurs="0"/>
						<xs:element name="fundingStream" type="ctr:fundingStream" minOccurs="0"/>
						<xs:element name="allocationDimensionRelationships" type="ctr:allocationDimensionRelationships" minOccurs="0"/>
						<xs:element name="allocationOrganisationRelationships" type="ctr:allocationOrganisationRelationships" minOccurs="0"/>
						<xs:element name="contractDeliverables" type="ctr:contractDeliverablesType" minOccurs="0"/>
						<xs:element name="contractAllocationNumber">
							<xs:annotation>
								<xs:documentation>
                  The unique identifier of a Contract Allocation (along with Contract Allocation Version Number)
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="20"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="contractAllocationVersionNumber" type="xs:int">
							<xs:annotation>
								<xs:documentation>
                  An identifier used to differentiate the different versions of a Contract Allocation.
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="description" type="ctr:description" minOccurs="0"/>
						<xs:element name="hierarchyType">
							<xs:annotation>
								<xs:documentation>
                  Contract Allocation is a resursive entity and each level needs to be identified and this element does this. It is a controlled list of possible values.
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="CONTRACT ALLOCATION"/>
									<xs:enumeration value="SUB ALLOCATION"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="startDate" type="xs:date" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  The date from which the Contract Allocation is valid.Although in most cases the start and end date will be defined in the Contract (Hierarchy Type = 'CONTRACT'), there remains the possibility that in some circumstances it will need to be recorded at this level.
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="endDate" type="xs:date" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  The date after which the Contract Allocation is no longer valid
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="status">
							<xs:annotation>
								<xs:documentation>
                  A term used to describe the position of the Contract Allocation in its lifecycle
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="100"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="maximumContractValue" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  An upper limit to the value of the Contract Allocation
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:totalDigits value="13"/>
									<xs:fractionDigits value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractDimensionRelationships">
		<xs:annotation>
			<xs:documentation>A list of Contract Dimension Relationships</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="contractDimensionRelationship" type="ctr:dimensionRelationshipType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
            The entity holds the dimensions that apply to a Contract.
          </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="allocationDimensionRelationships">
		<xs:annotation>
			<xs:documentation>List of Allocation Dimension Relationships</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="allocationDimensionRelationship" type="ctr:dimensionRelationshipType" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
            The entity holds the dimensions that apply to a Contract Allocation.
          </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractOrganisationRelationships">
		<xs:annotation>
			<xs:documentation>List of Contract Organisation Relationships</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="contractOrganisationRelationship" type="ctr:organisationRelationship" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
            The organisations that have a relationship with a Contract
          </xs:documentation>
				</xs:annotation>
				<!--<xs:complexType>
          <xs:sequence>
            <xs:element name="organisationId">
              <xs:annotation>
                <xs:documentation>
                  Organisation Identifier
                </xs:documentation>
              </xs:annotation>
              <xs:simpleType>
                <xs:restriction base="xs:int">
                  <xs:minInclusive value="1"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="contractOrganisationRelationshipType" type="ctr:contractOrganisationRelationshipType"/>
          </xs:sequence>
        </xs:complexType>-->
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="allocationOrganisationRelationships">
		<xs:annotation>
			<xs:documentation>List of Allocation Organisation Relationships</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="allocationOrganisationRelationship" type="ctr:organisationRelationship" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>
            The organisations that have a relationship with a Contract Allocation
          </xs:documentation>
				</xs:annotation>
				<!--<xs:complexType>
          <xs:sequence>
            <xs:element name="organisationId">
              <xs:annotation>
                <xs:documentation>
                  Organisation Identifier
                </xs:documentation>
              </xs:annotation>
              <xs:simpleType>
                <xs:restriction base="xs:int">
                  <xs:minInclusive value="1"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
            <xs:element name="contractOrganisationRelationshipType" type="ctr:contractOrganisationRelationshipType"/>
          </xs:sequence>
        </xs:complexType>-->
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="allocationDimension">
		<xs:annotation>
			<xs:documentation>
        Attributes that naturally define a Contract or Contract Allocation (beyond Funding Stream, Period and Provider)
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="allocationDimensionName">
				<xs:annotation>
					<xs:documentation>
            An attribute that can be used to define the Contract Allocation
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="allocationDimensionValue">
				<xs:annotation>
					<xs:documentation>
            The value of the Allocation Dimension
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractor">
		<xs:annotation>
			<xs:documentation>
        The organisation with whom the Agency is contracting
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="organisationIdentifier" type="xs:int">
				<xs:annotation>
					<xs:documentation>
            The Organisation Identifier of the Contractor (an entity that agrees to furnish certain number or quantity of goods, material, equipment, personnel, and/or services that meet or exceed stated requirements or specifications, at a mutually agreed upon price and within a specified timeframe to another independent entity called contractee)
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ukprn" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
            The UK Provider Reference Number of the Contractor
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="legalName">
				<xs:annotation>
					<xs:documentation>
            The legal name of the Contractor as used on the Contract
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="255"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="registeredCompanyNumber" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
            The Company Number, issued by Companies House, of the Contractor as has been recorded on this Contract
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="8"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="organisationAddressIdentifier" type="xs:int" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
            The Address Identifier (as provided by the Organisation Service) of the legal address of the Contractor, that has been used on this Contract
          </xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="addressLine1" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
            The first line of the legal address (as provided by the Organisation Service) of the Contractor, that has been used on this Contract
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="80"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="addressLine2" minOccurs="0">
