	<xs:complexType name="deliverableType">
		<xs:annotation>
			<xs:documentation>A reference list of each deliverable</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="fundingStreamCode">
				<xs:simpleType>
					<xs:annotation>
						<xs:documentation>
              A code that identifies the Funding Stream to which this Deliverable belongs
            </xs:documentation>
					</xs:annotation>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="deliverableCode" type="xs:int"/>
			<xs:element name="businessCode" minOccurs="0">
				<xs:simpleType>
					<xs:annotation>
						<xs:documentation>
              A code used by the business to give more meaning to the Deliverable
            </xs:documentation>
					</xs:annotation>
					<xs:restriction base="xs:string">
						<xs:maxLength value="10"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="deliverableName">
				<xs:simpleType>
					<xs:annotation>
						<xs:documentation>
              A description or name of the Deliverable
            </xs:documentation>
					</xs:annotation>
					<xs:restriction base="xs:string">
						<xs:maxLength value="120"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractDeliverablesType">
		<xs:annotation>
			<xs:documentation>
        Essentially an intersection between a Contract and Deliverables - so the Deliverables that apply to the Contract.
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="contractDeliverable" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="deliverable" type="ctr:deliverableType"/>
						<xs:element name="contractDeliverablePeriods" type="ctr:contractDeliverablePeriodsType" minOccurs="0"/>
						<xs:element name="deliverableOrganisationRelationships" type="ctr:deliverableOrganisationRelationships" minOccurs="0"/>
						<xs:element name="deliverableDimensionRelationships" type="ctr:deliverableDimensionRelationships" minOccurs="0"/>
						<xs:element name="deliverableDescription" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  The description of the Deliverable as entered by the business in relation to this Contract. This may differ from the description found in Funding Stream Configuration.
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="255"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="unitCost" minOccurs="0">
							<xs:annotation>
								<xs:documentation>The unit cost of the deliverable</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:totalDigits value="13"/>
									<xs:fractionDigits value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="plannedVolume" type="xs:int" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  The volume of the Deliverable that has to be delivered. This is not a summary, rather it enables a single volume to be allocated across all periods.
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="plannedValue" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  The planned value (equals Unit Cost x Planned Volume if both are populated) of what has to be delivered.  This is not a summary, rather it enables a single value to be allocated across all periods.
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:totalDigits value="13"/>
									<xs:fractionDigits value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractDeliverablePeriodsType">
		<xs:annotation>
			<xs:documentation>
        The planned delivery against periods of time
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="contractDeliverablePeriod" maxOccurs="unbounded">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="year" type="xs:int">
							<xs:annotation>
								<xs:documentation>The Year of the period</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="period" type="xs:int">
							<xs:annotation>
								<xs:documentation>
                  The period (eg a calendar month, a calendar quarter, a calendar year but usually calendar month) of the Period
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="periodType" type="ctr:periodTypeType"/>
						<xs:element name="unitCost" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  The unit cost of the Delvierable in £££.pp
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:totalDigits value="13"/>
									<xs:fractionDigits value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="plannedVolume" type="xs:int" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  The volume of the Deliverable that has to be delivered. This is not a summary, rather it enables a single volume to be allocated across all periods.
                </xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="plannedValue" minOccurs="0">
							<xs:annotation>
								<xs:documentation>
                  The planned value (equals Unit Cost x Planned Volume if both are populated) of what has to be delivered.  This is not a summary, rather it enables a single value to be allocated across all periods.
                </xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:decimal">
									<xs:totalDigits value="13"/>
									<xs:fractionDigits value="2"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="organisationRelationship">
		<xs:sequence>
			<xs:element name="organisationRelationshipType" type="ctr:organisationRelationshipType"/>
			<xs:element name="organisationIdentifier">
				<xs:annotation>
					<xs:documentation>
            Organisation Identifier
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:int">
						<xs:minInclusive value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="dimensionRelationshipType">
		<xs:annotation>
			<xs:documentation>
        Attributes that naturally define a Contract or Contract Allocation (beyond Funding Stream, Period and Provider)
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="dimensionName">
				<xs:annotation>
					<xs:documentation>
            An attribute that can be used to define the Contract, Allocation or Deliverable
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="dimensionValue">
				<xs:annotation>
					<xs:documentation>
            The value of the Dimension
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="deliverableOrganisationRelationships">
		<xs:annotation>
			<xs:documentation>
        A list of entities that record any organisations related to a Contract Deliverable.
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="deliverableOrganisationRelationship" type="ctr:organisationRelationship">
				<xs:annotation>
					<xs:documentation>
            An entity that records any organisations related to a Contract Deliverable.
          </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="deliverableDimensionRelationships">
		<xs:annotation>
			<xs:documentation>
        A list of entities that hold the dimensions that apply to a Contract Deliverable
      </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="deliverableDimensionRelationship" type="ctr:dimensionRelationshipType">
				<xs:annotation>
					<xs:documentation>
            The entity holds the dimensions that apply to a Contract Deliverable
          </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="contractStatusType">
		<xs:sequence>
			<xs:element name="status">
				<xs:annotation>
					<xs:documentation>
            A term used to describe the position of the Contract in its lifecycle
          </xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="parentStatus">
				<xs:annotation>
					<xs:documentation>A higher level classification of a status</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="100"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
