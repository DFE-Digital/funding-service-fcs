<?xml version="1.0" encoding="utf-8"?>
<!-- edited with XMLSpy v2011 rel. 3 (http://www.altova.com) by Joe Ingledew (Skills Funding Agency) -->
<xs:schema xmlns:api="urn:sfa:apis:funding-policy" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:sfa:apis:funding-policy" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.00">

  <xs:simpleType name="FundingStreamPeriodCodeType">
    <xs:restriction base="xs:string">
      <xs:maxLength value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DeliverableCodeType">
    <xs:restriction base="xs:int">
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="FundingPeriodType">
    <xs:annotation>
      <xs:documentation>A defined (and usually well re-used) period of time which has significance within the funding business.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Period">
        <xs:annotation>
          <xs:documentation>A code used to describe the period of time.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="StartDate" type="xs:date"/>
      <xs:element name="EndDate" type="xs:date"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SettingValueType">
    <xs:sequence>
      <xs:element name="Setting" type="api:SettingType"/>
      <xs:element name="Value">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SettingType">
    <xs:annotation>
      <xs:documentation>A Setting is an attribute that can be applied to a Deliverable.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="SettingName">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="FundingStreamPeriodSettingConfiguration">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FundingStreamPeriodCode" type="api:FundingStreamPeriodCodeType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="FundingPeriod" type="api:FundingPeriodType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="SettingValue" type="api:SettingValueType"  minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:attributeGroup ref="api:SchemaVersionAttribute"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="FundingStreamPeriodConfiguration">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FundingStreamPeriodCode" type="api:FundingStreamPeriodCodeType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="FundingPeriod" type="api:FundingPeriodType" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:attributeGroup ref="api:SchemaVersionAttribute"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="DeliverableSettingConfiguration">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FundingStreamPeriodCode" type="api:FundingStreamPeriodCodeType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="DeliverableCode" type="api:DeliverableCodeType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="SettingValue" type="api:SettingValueType"  minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:attributeGroup ref="api:SchemaVersionAttribute"/>
    </xs:complexType>
  </xs:element>

  <xs:attributeGroup name="SchemaVersionAttribute">
    <xs:attribute name="schemaVersion" use="required" fixed="1.00">
      <xs:annotation>
        <xs:documentation>Version of the schema in use</xs:documentation>
      </xs:annotation>
      <xs:simpleType>
        <xs:restriction base="xs:decimal">
          <xs:totalDigits value="3"/>
          <xs:fractionDigits value="2"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>
</xs:schema>