    <add key="CFS:AADInstance" value="https://login.microsoftonline.com/{0}" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="CFS:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="CFS:ClientId" value="6596bb35-78f9-45b7-9f90-814d29d409ed" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="CFS:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="CFS:Scope" value="https://calculatefundingserviceapi/.default" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="CFS:RootUrl" value="https://api-calculate-funding.education.gov.uk" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
	<add key="StorageTableSuffix" value="Release"  xdt:Transform="Replace" xdt:Locator="Match(key)"  />
	<add key="DasEngagements.SubscriptionKey" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
  <system.serviceModel>

    <client>
      <endpoint address="https://exsil.des.fasst.org.uk/RoutingService.svc/ReqRes/DedsSearchService/"
              binding="wsHttpBinding"
              bindingConfiguration="WsClientCertificateTransportSecurity"
              contract="DedsSearchService.IDedsSearchService"
              name="BasicHttpBinding_IDedsSearchService"
              behaviorConfiguration="DedsCertificateCredential"
              xdt:Transform="Replace"
              xdt:Locator="Match(contract)"/>
    </client>

    <bindings>
      <basicHttpBinding>
        <binding name="ClientCertificateTransportSecurity" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="Match(name)"  >
          <security mode="Transport" >
            <transport clientCredentialType="Certificate" />
          </security>
        </binding>
      </basicHttpBinding>
      <wsHttpBinding>
        <binding name="WsClientCertificateTransportSecurity" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="Match(name)">
          <security mode="Transport">
            <transport clientCredentialType="Certificate" />
          </security>
        </binding>
        <binding name="wsHttpEndpoint" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="XPath(/configuration/system.serviceModel/bindings/wsHttpBinding)" >
          <security mode="TransportWithMessageCredential" >
            <message clientCredentialType="Certificate" />
            <transport clientCredentialType="None"/>
          </security>
        </binding>
      </wsHttpBinding>
    </bindings>

    <behaviors xdt:Transform="Insert" >
      <endpointBehaviors>
	      <behavior name="DedsCertificateCredential">
          <clientCredentials>
            <clientCertificate
              findValue="26B8F09E3535FF89826F2AFA0BB0CEB7EC183FDC"
              storeName="My"
              storeLocation="LocalMachine"
        x509FindType="FindByThumbprint" />
          </clientCredentials>
        </behavior>
      </endpointBehaviors>
    </behaviors>

  </system.serviceModel>

</configuration>