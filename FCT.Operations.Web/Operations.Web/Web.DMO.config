    <add name="CommonStorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentGenDBContext" connectionString="" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    
  </system.web>
  <appSettings>
    <add key="ContractManagementServiceUrl" value="https://services-dmo.fct-sfa.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FundingPolicyServiceUrl" value="https://services-dmo.fct-sfa.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
