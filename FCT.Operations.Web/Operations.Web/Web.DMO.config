  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="OperationsDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
