<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="OperationsDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="ContractManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
	  <add name="CommonStorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
	  <add name="PaymentGenDBContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
  <system.web>
    
  </system.web>
  <appSettings>
    <add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct-dci/" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
	  <add key="UploadDocumentFunUrl" value="https://fcs-dev-dmo-fcsworker-fa.azurewebsites.net/api/UploadDocumentFun" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	  <add key="Sharepoint:Oauth:ClientSecret" value="" />
	  <add key="Sharepoint:Oauth:ClientId" value="4ee738f3-518a-49dc-8f12-7b2e2ce32b6e" />
	  <add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" />
	  <add key="Sharepoint:Oauth:Principle" value="00000003-0000-0ff1-ce00-000000000000" />
    <add key="OrgService:BaseUrl" value="https://fct-orgservice-dci.fct-sfa.com/" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="ida:ResourceId_CrmOnline" value="https://fcs-dev-ci.crm4.dynamics.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DCT:Url" value="https://dcol-tst-integrationapi-weu.tst.ase.dct.fasst.org.uk" xdt:Transform="Replace" xdt:Locator="Match(key)" /> <!-- requires mapping to 137.117.198.127 in hosts file -->
