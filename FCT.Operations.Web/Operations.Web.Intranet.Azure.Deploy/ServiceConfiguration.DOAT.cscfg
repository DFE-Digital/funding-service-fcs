<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="Operations.Web.Intranet.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="Operations.Web">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="DefaultEndpointsProtocol=https;AccountName=fctappstorageoat;AccountKey=" />
      <Setting name="APPINSIGHTS_INSTRUMENTATIONKEY" value="f757a8c2-7c25-4e5f-8531-058339104f0e" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="SSLCertificate" thumbprint="5954cc43034d53fc10d875c9d8f9724dc5bd8f03" thumbprintAlgorithm="sha1" />
      <Certificate name="CPDSAuth" thumbprint="1D41AE063B34F3D53762C7E55B4B01823ABF1D04" thumbprintAlgorithm="sha1" />
      <Certificate name="DedsAuth" thumbprint="E65CAABA15453F5BF22D30CFBA33A2F539CFB65F" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="fcspreprod-vnet" />
    <AddressAssignments>
      <InstanceAddress roleName="Operations.Web">
        <Subnets>
          <Subnet name="Operations" />
        </Subnets>
      </InstanceAddress>
    </AddressAssignments>
    <LoadBalancers>
      <LoadBalancer name="fcs-opsweb-ilb">
        <FrontendIPConfiguration type="private" subnet="Operations" staticVirtualNetworkIPAddress="10.78.105.110" />
      </LoadBalancer>
    </LoadBalancers>
  </NetworkConfiguration>
</ServiceConfiguration>