    <LoadBalancers>
      <LoadBalancer name="fcs-opsweb-ilb">
        <FrontendIPConfiguration type="private" subnet="opsweb" staticVirtualNetworkIPAddress="10.0.1.153" />
      </LoadBalancer>
    </LoadBalancers>
  </NetworkConfiguration>
</ServiceConfiguration>