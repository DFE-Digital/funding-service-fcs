<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="FundingStreamConfigDomain.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="4" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="FundingStreamConfigDomain.Web">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.RemoteForwarder.Enabled" value="true" />
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="DefaultEndpointsProtocol=https;AccountName=fcsappstoragedev;AccountKey=" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="Microsoft.WindowsAzure.Plugins.RemoteAccess.PasswordEncryption" thumbprint="630ACF9857AC6DBD79ED146191A5751EDDD9F45B" thumbprintAlgorithm="sha1" />
      <Certificate name="SSLCertificate" thumbprint="2D2B8BB026353E4BE6D1CDAC70C73191F02E60FA" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="Group fcs-env-shared-rg fcs-env-shared-asm-vnet-01" />
    <AddressAssignments>
      <InstanceAddress roleName="FundingStreamConfigDomain.Web">
        <Subnets>
          <Subnet name="default" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <ReservedIP name="fct-fsc-mo-rip" />
      </ReservedIPs>
    </AddressAssignments>
  </NetworkConfiguration>
</ServiceConfiguration>