<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="FundingStreamConfigDomain.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="4" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="FundingStreamConfigDomain.Web">
    <Instances count="2" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.RemoteForwarder.Enabled" value="false" />
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="DefaultEndpointsProtocol=https;AccountName=fcsopsupappstorage;AccountKey=" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="Microsoft.WindowsAzure.Plugins.RemoteAccess.PasswordEncryption" thumbprint="630ACF9857AC6DBD79ED146191A5751EDDD9F45B" thumbprintAlgorithm="sha1" />
      <Certificate name="SSLCertificate" thumbprint="6457D4B949D2EB841D45EEF9C2F15E07AE537CB5" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="OpSup-VNet" />
    <AddressAssignments>
      <InstanceAddress roleName="FundingStreamConfigDomain.Web">
        <Subnets>
          <Subnet name="Contract" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <ReservedIP name="fct-fsc-ps-rip" />
      </ReservedIPs>
    </AddressAssignments>
  </NetworkConfiguration>
</ServiceConfiguration>