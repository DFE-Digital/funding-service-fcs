<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using web.config transformation visit http://go.microsoft.com/fwlink/?LinkId=125889 -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="FundingPolicyUrl" value="https://services-dat.fct-sfa.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="StorageTableSuffix" value="DAT" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:Tenant" value="fcsazuresfabisgov.onmicrosoft.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ClientId" value="a8c17841-be75-4f80-97df-8006cceb438e" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:AppKey" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:AADInstance" value="https://login.microsoftonline.com/{0}" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ResourceId_CrmOnline" value="https://fcs-dev-at.api.crm4.dynamics.com/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>