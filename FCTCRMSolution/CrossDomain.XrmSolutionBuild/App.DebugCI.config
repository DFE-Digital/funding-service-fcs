<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="ConfigurationUserDataPath" value="ConfigData.xml" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ManagedSolution" value="Unmanaged" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentServiceUrl" value="http://fct-ci-crm-01.fctdev.local/xrmdeployment/2011/deployment.svc" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqlServerName" value="fct-ci-crm-01.fctdev.local" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SrsUrl" value="http://fct-ci-crm-01/reportserver" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqmIsEnabled" value="False" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationUniqueName" value="ContinuousIntegrationDevR2" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationFriendlyName" value="Continuous Integration" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseCurrencyCode" value="GBP" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseCurrencyName" value="Pound Sterling" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseCurrencyPrecision" value="2" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseCurrencySymbol" value="£" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqlUsername" value="ci-crmdeployment" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqlPassword" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentAdminUsername" value="ci-crmdeployment" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentAdminPassword" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="CrmUrl" value="http://fct-ci-crm-01.fctdev.local" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqlCollation" value="Latin1_General_CI_AI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="PackageFilename" value="FCTCrmConfig.ConfigPackage.dll" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseLanguageCode" value="1033" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentAdminDomain" value="FCTDEV" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="CrmPort" value="80" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DropSolution" value="Yes" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
  </appSettings>
</configuration>