<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configdatastorage xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform"
installsampledata="false"
                     waitforsampledatatoinstall="false"
                     agentdesktopzipfile=""
                     agentdesktopexename=""
                     crmmigdataimportfile="">
  <solutions xdt:Transform="Replace" xdt:Locator="XPath(/configdatastorage/solutions)">
    <configsolutionfile solutionpackagefilename="Solutions\CIBERSFAFCTSolution.zip" />
  </solutions>
  <filestoimport xdt:Transform="Replace" xdt:Locator="XPath(/configdatastorage/filestoimport)">
    <configimportfile filename="Data\Providers.csv" filetype="CSV" associatedmap="Provider" importtoentity="account" datadelimiter="doublequotes" fielddelimiter="comma" enableduplicatedetection="true" isfirstrowheader="true"  isrecordownerateam="false" owneruser="" waitforimporttocomplete="true"/>
    <configimportfile filename="Data\Caseloads.csv" filetype="CSV" associatedmap="Caseload" importtoentity="sfa_caseload" datadelimiter="doublequotes" fielddelimiter="comma" enableduplicatedetection="true" isfirstrowheader="true"  isrecordownerateam="false" owneruser="" waitforimporttocomplete="true"/>
    <configimportfile filename="Data\LEPs.csv" filetype="CSV" associatedmap="LEP" importtoentity="account" datadelimiter="doublequotes" fielddelimiter="comma" enableduplicatedetection="true" isfirstrowheader="true"  isrecordownerateam="false" owneruser="" waitforimporttocomplete="true"/>
    <configimportfile filename="Data\UoPs.csv" filetype="CSV" associatedmap="UoP" importtoentity="sfa_unitofprocurement" datadelimiter="doublequotes" fielddelimiter="comma" enableduplicatedetection="true" isfirstrowheader="true"  isrecordownerateam="false" owneruser="" waitforimporttocomplete="true"/>
    <configimportfile filename="Data\ContractNumbers.csv" filetype="CSV" associatedmap="ContractNumber" importtoentity="sfa_contractnumber" datadelimiter="doublequotes" fielddelimiter="comma" enableduplicatedetection="true" isfirstrowheader="true"  isrecordownerateam="false" owneruser="" waitforimporttocomplete="true"/>
    <configimportfile filename="Data\WebServiceResources-CI.csv" filetype="CSV" associatedmap="WebServiceResource" importtoentity="sfa_webserviceresource" datadelimiter="doublequotes" fielddelimiter="comma" enableduplicatedetection="true" isfirstrowheader="true"  isrecordownerateam="false" owneruser="" waitforimporttocomplete="true"/>
  </filestoimport>
  <filesmapstoimport xdt:Transform="Replace" xdt:Locator="XPath(/configdatastorage/filesmapstoimport)">
    <configimportmapfile filename="Maps\Provider.xml" />
    <configimportmapfile filename="Maps\Caseload.xml" />
    <configimportmapfile filename="Maps\LEP.xml" />
    <configimportmapfile filename="Maps\UoP.xml" />
    <configimportmapfile filename="Maps\ContractNumber.xml" />
    <configimportmapfile filename="Maps\WebServiceResource.xml" />
  </filesmapstoimport>
</configdatastorage>