<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="ConfigurationUserDataPath" value="ConfigData.xml" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ManagedSolution" value="Managed" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentServiceUrl" value="https://fcs-op-crmw.opsupazure.sfa.bis.gov.uk/XRMDeployment/2011/deployment.svc" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqlServerName" value="fcs-prd-sql-01.opsupazure.sfa.bis.gov.uk" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SrsUrl" value="https://fcs-op-ssrs.opsupazure.sfa.bis.gov.uk:8085/ReportServer" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqmIsEnabled" value="False" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationUniqueName" value="SkillsFundingAgency" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationFriendlyName" value="Skills Funding Agency" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseCurrencyCode" value="GBP" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseCurrencyName" value="Pound Sterling" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseCurrencyPrecision" value="2" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseCurrencySymbol" value="£" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqlUsername" value="#FCSProd\CRMDeploy" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqlPassword" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentAdminUsername" value="FCSCrmDeploy" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentAdminPassword" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="CrmUrl" value="https://fcs-op-crmw.opsupazure.sfa.bis.gov.uk" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="SqlCollation" value="Latin1_General_CI_AI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="PackageFilename" value="FCTCrmConfig.ConfigPackage.dll" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganizationBaseLanguageCode" value="1033" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentAdminDomain" value="opsupazure" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="CrmPort" value="443" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DropSolution" value="No" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>