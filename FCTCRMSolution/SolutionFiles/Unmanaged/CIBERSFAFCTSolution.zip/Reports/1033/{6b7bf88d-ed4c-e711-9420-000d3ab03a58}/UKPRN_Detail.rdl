ourceName>CRMDataSource</DataSourceName><QueryParameters><QueryParameter Name="@CensusDatePicker"><Value>=Format(Parameters!CensusDatePicker.Value,"yyyy-MM-dd")</Value></QueryParameter><QueryParameter Name="@DistinctPeriods"><Value>=Parameters!DistinctPeriods.Value</Value></QueryParameter></QueryParameters><CommandText>&lt;fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false"&gt;
  &lt;entity name="sfa_paymenttimetable"&gt;
    &lt;attribute name="sfa_fundingstreamperiod" /&gt;
    &lt;filter type="and"&gt;
      &lt;condition attribute="statecode" operator="eq" value="0" /&gt;
      &lt;condition attribute="sfa_censusenddate" operator="on" value="@CensusDatePicker" /&gt;
      &lt;condition attribute="sfa_period" operator="eq" value="@DistinctPeriods" /&gt;
    &lt;/filter&gt;
  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText></Query><Fields><Field Name="sfa_fundingstreamperiod"><DataField>sfa_fundingstreamperiod</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="sfa_fundingstreamperiodValue"><DataField>sfa_fundingstreamperiodValue</DataField><rd:TypeName>System.Guid</rd:TypeName></Field><Field Name="sfa_fundingstreamperiodEntityName"><DataField>sfa_fundingstreamperiodEntityName</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet><DataSet Name="SubnominalFilteredUKPRNDataSet"><Query><DataSourceName>CRMDataSource</DataSourceName><QueryParameters><QueryParameter Name="@DistinctPeriods"><Value>=Parameters!DistinctPeriods.Value</Value></QueryParameter><QueryParameter Name="@CensusFilteredFSP"><Value>=Parameters!CensusFilteredFSP.Value</Value></QueryParameter></QueryParameters><CommandText>&lt;fetch aggregate="true" &gt;
  &lt;entity name="sfa_subnominalaggregation" &gt;
    &lt;attribute name="sfa_aggregatedvalue" alias="AV" aggregate="sum" /&gt;
    &lt;attribute name="sfa_paymenttype" alias="PT" groupby="true" /&gt;
    &lt;attribute name="sfa_period" alias="PD" groupby="true" /&gt;
    &lt;attribute name="sfa_fundingstreamperiod" alias="FSP" groupby="true" /&gt;
    &lt;filter type="and" &gt;
      &lt;condition attribute="sfa_period" operator="eq" value="@DistinctPeriods" /&gt;
      &lt;condition attribute="sfa_fundingstreamperiodname" operator="in" value="@CensusFilteredFSP" /&gt;
      &lt;condition attribute="sfa_aggregatedvalue" operator="neq" value="0" /&gt;
    &lt;/filter&gt;
    &lt;link-entity name="sfa_fundingstreamperiod" from="sfa_fundingstreamperiodid" to="sfa_fundingstreamperiod" &gt;
      &lt;attribute name="sfa_fundingstreamperiodname" alias="FSPName" groupby="true" /&gt;
    &lt;/link-entity&gt;
	&lt;link-entity name="account" from="accountid" to="sfa_provider" &gt;
      &lt;attribute name="sfa_ukprn" alias="UKPRN" groupby="true" /&gt;
      &lt;attribute name="name" alias="ProviderName" groupby="true" /&gt;
    &lt;/link-entity&gt;
  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText></Query><Fields><Field Name="AV"><DataField>AV</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="AVValue"><DataField>AVValue</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="PT"><DataField>PT</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="PTValue"><DataField>PTValue</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="PD"><DataField>PD</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="FSP"><DataField>FSP</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="FSPValue"><DataField>FSPValue</DataField><rd:TypeName>System.Guid</rd:TypeName></Field><Field Name="FSPName"><DataField>FSPName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="FSPEntityName"><DataField>FSPEntityName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="UKPRN"><DataField>UKPRN</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ProviderName"><DataField>ProviderName</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="SortOrder"><Value>=switch(Fields!PT.Value="Profile","A",Fields!PT.Value="Reconciliation","B",Fields!PT.Value="Capping","C")</Value></Field></Fields></DataSet><DataSet Name="DistinctPeriodsForCensus"><Query><DataSourceName>CRMDataSource</DataSourceName><QueryParameters><QueryParameter Name="@CensusDatePicker"><Value>=Format(Parameters!CensusDatePicker.Value,"yyyy-MM-dd")</Value></QueryParameter></QueryParameters><CommandText>&lt;fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="true" &gt;
  &lt;entity name="sfa_paymenttimetable" &gt;
    &lt;attribute name="sfa_period" /&gt;
    &lt;order attribute="sfa_period" descending="true" /&gt;
    &lt;filter type="and" &gt;
      &lt;condition attribute="sfa_censusenddate" operator="on" value="@CensusDatePicker" /&gt;
    &lt;/filter&gt;
  &lt;/entity&gt;
&lt;/fetch&gt;</CommandText></Query><Fields><Field Name="sfa_period"><DataField>sfa_period</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields></DataSet></DataSets><ReportParameters><ReportParameter Name="Today"><DataType>String</DataType><DefaultValue><Values><Value>=Format(Globals!ExecutionTime,"yyyy-MM-dd")</Value></Values></DefaultValue><Prompt>Today</Prompt><Hidden>true</Hidden></ReportParameter><ReportParameter Name="CensusDatePicker"><DataType>DateTime</DataType><DefaultValue><Values><Value>=CDate("2015-08-05")</Value></Values></DefaultValue><Prompt>Payment Census Date</Prompt><Hidden>true</Hidden></ReportParameter><ReportParameter Name="DistinctPeriods"><DataType>String</DataType><DefaultValue><DataSetReference><DataSetName>DistinctPeriodsForCensus</DataSetName><ValueField>sfa_period</ValueField></DataSetReference></DefaultValue><Prompt>Payment Period</Prompt><Hidden>true</Hidden><ValidValues><DataSetReference><DataSetName>DistinctPeriodsForCensus</DataSetName><ValueField>sfa_period</ValueField><LabelField>sfa_period</LabelField></DataSetReference></ValidValues><UsedInQuery>True</UsedInQuery></ReportParameter><ReportParameter Name="CensusFilteredFSP"><DataType>String</DataType><DefaultValue><DataSetReference><DataSetName>CensusDateFilteredFSPDataSet</DataSetName><ValueField>sfa_fundingstreamperiod</ValueField></DataSetReference></DefaultValue><Prompt>Funding Stream Period</Prompt><Hidden>true</Hidden><ValidValues><DataSetReference><DataSetName>CensusDateFilteredFSPDataSet</DataSetName><ValueField>sfa_fundingstreamperiod</ValueField><LabelField>sfa_fundingstreamperiod</LabelField></DataSetReference></ValidValues><UsedInQuery>True</UsedInQuery></ReportParameter><ReportParameter Name="CRM_URL"><DataType>String</DataType><Nullable>true</Nullable><AllowBlank>true</AllowBlank><Prompt>CRM_URL</Prompt><Hidden>true</Hidden></ReportParameter><ReportParameter Name="FundingStreamPeriodName"><DataType>String</DataType><Nullable>true</Nullable><DefaultValu