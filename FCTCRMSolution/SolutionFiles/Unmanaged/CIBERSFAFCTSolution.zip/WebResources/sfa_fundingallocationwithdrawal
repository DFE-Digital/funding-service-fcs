<html><head>
<script type="text/javascript">  
var inpData;

function getDataParam() {  
   //Get the any query string parameters and load them  
   //into the vals array  
   var vals = new Array();  
   if (location.search != "") {  
    vals = location.search.substr(1).split("&");  
    for (var i in vals) {  
     vals[i] = vals[i].replace(/\+/g, " ").split("=");  
    }  
    //look for the parameter named 'data'  
    var found = false;  
    for (var i in vals) {  
     if (vals[i][0].toLowerCase() == "data") {  
      inpData = decodeURIComponent(vals[i][1]);
      found = true;  
      break;  
     }  
    }
  }  
 
}

function CascadeWithdrawal(inputComments, inpIds) {

    ////using action
    var req = {};
	req.inputComments = inputComments;
	req.inputIDs = inpIds;

	req.getMetadata = function () {
        return {
            parameterTypes: {
				"inputComments": { typeName: "Edm.String", structuralProperty: 1 },
				"inputIDs": { typeName: "Edm.String", structuralProperty: 1 },
            },
            operationType: 0,
            operationName: "sfa_FundingAllocationWithdraw"
        };
    };
    parent.Xrm.Utility.showProgressIndicator("Processing");
    parent.Xrm.WebApi.online.execute(req).then( 
        function (result) { 
            if (result.ok) { 
	       parent.Xrm.Utility.closeProgressIndicator();
               var lookupOptions = { entityType: "sfa_fundingallocation" };
               parent.Xrm.Utility.refreshParentGrid(lookupOptions);

               window.open('','_parent','');
               window.close();
            } 
        },
        function (error) { 
           var errMsg = error.message; 
               parent.Xrm.Utility.closeProgressIndicator();
	       parent.Xrm.Navigation.openAlertDialog({text: "error:"+errMsg});
        }
    );
}

function doWithdrawal() {

    var inputComments = document.getElementById('inputComments').value.trim();
    CascadeWithdrawal(inputComments, inpData);

}

</script>
<meta><meta></head>
<body onload="getDataParam()" onfocusout="parent.setEmailRange();" style="overflow-wrap: break-word;"><br>


 <form>

	<label for="inputComments">Please provide a reason for withdrawing the selected Funding Allocation(s).<br>This action cannot be undone:</label><br>
	<textarea id="inputComments" name="inputComments" value="" rows="3" cols="40" required=""></textarea>
	<br><br>
	<button onclick="doWithdrawal();return false;" style="width:125px;" type="submit">Withdraw</button>
	&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
	<button type="button" onclick="window.open('', '_self', ''); window.close();">Cancel</button>
</form>


</body></html>