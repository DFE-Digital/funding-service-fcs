    <add key="ContractManagementService:ClientId" value="25f8e9f5-a7ab-4857-9c19-0add94785f6f" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractManagementService:AppKey" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
