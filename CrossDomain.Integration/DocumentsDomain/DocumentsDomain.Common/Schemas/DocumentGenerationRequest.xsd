<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:fctns="http://sfa.bis.gov.uk/fct" targetNamespace="http://sfa.bis.gov.uk/fct" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="DocumentGenerationRequest">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TemplateContainer" type="xs:string"/>
				<xs:element name="TemplateFilename" type="xs:string"/>
				<xs:element name="GroupId" type="xs:string"/>
				<xs:element name="MergeData">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="MergeFields">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="MergeField" type="fctns:MergeFieldType" minOccurs="0" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="RepeatingSections" minOccurs="0">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="RepeatingSection" type="fctns:RepeatingSectionType" maxOccurs="unbounded"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="MergeFieldType">
		<xs:sequence>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="Value" type="xs:string"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RepeatingSectionType">
		<xs:sequence>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="Rows">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Row" type="fctns:RowType" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="RowType">
		<xs:sequence>
			<xs:element name="MergeFields">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="MergeField" type="fctns:MergeFieldType" maxOccurs="unbounded"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="RepeatingSection" type="fctns:RepeatingSectionType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
