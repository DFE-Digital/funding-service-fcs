<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<configuration>
  <configSections>
    <section name="MessageForwardingInCaseOfFaultConfig" type="NServiceBus.Config.MessageForwardingInCaseOfFaultConfig, NServiceBus.Core" />
    <section name="UnicastBusConfig" type="NServiceBus.Config.UnicastBusConfig, NServiceBus.Core" />
    <section name="AuditConfig" type="NServiceBus.Config.AuditConfig, NServiceBus.Core" />
    <section name="SecondLevelRetriesConfig" type="NServiceBus.Config.SecondLevelRetriesConfig, NServiceBus.Core" />
    <section name="TransportConfig" type="NServiceBus.Config.TransportConfig, NServiceBus.Core" />
    <section name="Logging" type="NServiceBus.Config.Logging, NServiceBus.Core" />
    <section name="AzureDataBusConfig" type="NServiceBus.Config.AzureDataBusConfig, NServiceBus.Azure" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
  </configSections>
  <Logging Threshold="Info" />
  <TransportConfig MaximumConcurrencyLevel="1" MaxRetries="0" />
  <SecondLevelRetriesConfig Enabled="false" />
  <MessageForwardingInCaseOfFaultConfig ErrorQueue="error" />
  <AzureDataBusConfig />
  <AuditConfig QueueName="audit" />
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <clear />
    <!-- <add name="StorageConnectionString" connectionString="" />  -->
    <add name="StorageConnectionString" connectionString="UseDevelopmentStorage=true;" />
    <add name="NServiceBus/Transport" connectionString="" />
    <add name="CrmConnectionString" connectionString="" />
  </connectionStrings>
  <appSettings>
    <add key="DocumentGeneration.TargetContainer" value="document-io-dev" />
    <add key="DocumentGeneration.TemplateContainer" value="document-template-dev" />
    <add key="DocumentGeneration.DocumentSaverType" value="AzureBlobStorage" />
    <add key="DocumentGeneration.UnitCostFormat" value="{0:£#,0}" />
    <add key="DocumentGeneration.TotalFundingDeliverableCode" value="0" />
    <add key="ida:TenantID" value="eadfe063-8622-4d8a-a23d-379e25f91341" />
    <add key="ida:ClientID" value="e67db973-9c36-45db-9e27-8a9ec73e3a80" />
    <add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct-dci/" />
	  <add key="Sharepoint:Oauth:ClientSecret" value="" />
	  <add key="Sharepoint:Oauth:ClientId" value="4ee738f3-518a-49dc-8f12-7b2e2ce32b6e" />
	  <add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" />
	  <add key="Sharepoint:Oauth:Principle" value="00000003-0000-0ff1-ce00-000000000000" />
	  <add key="Graph:Scope" value="https://graph.microsoft.com/.default" />

	  <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-11.0.0.0" newVersion="11.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.WindowsAzure.Storage" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.1.0.1" newVersion="3.1.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.Services.Client" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.6.4.0" newVersion="5.6.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.Edm" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.6.4.0" newVersion="5.6.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Data.OData" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.6.4.0" newVersion="5.6.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.ServiceBus" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.0.0" newVersion="2.6.0.0" />
