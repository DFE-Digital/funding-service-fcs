<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 --></configSections>
  <appSettings>
    <add key="DocumentGeneration.TemplateContainer" value="document-template-dev" />
    <add key="DocumentGeneration.TargetContainer" value="document-io-dev" />
    <add key="StorageConnectionString" value="UseDevelopmentStorage=true;" />
    <add key="DocumentGeneration.UnitCostFormat" value="{0}{1}(Unit cost {2:£#,0})" />
    <add key="ContractDocumentation.ContractAppendicesFolderO365" value="{FundingType}-{Period}-Input-Appendices" />
    <add key="ContractDocumentation.ContractTermsAndConditionsFolderO365" value="{FundingType}-{Period}-Input-Terms And Conditions" />
    <add key="ContractDocumentation.ContractMergedDocumentFolderO365" value="{FundingType}-{Period}-Output-Merged Document" />
    <add key="ContractDocumentation.ContractPublishedDocumentFolderO365" value="{FundingType}-{Period}-Output-Documents for Publication" />
	  <add key="ida:Resource" value="" />
	  <add key="FileWatcher.DownloadBufferSize" value="200000" />
	  <add key="Sharepoint:Oauth:ClientSecret" value="" />
	  <add key="Sharepoint:Oauth:ClientId" value="4ee738f3-518a-49dc-8f12-7b2e2ce32b6e" />
	  <add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" />
	  <add key="Sharepoint:Oauth:Principle" value="00000003-0000-0ff1-ce00-000000000000" />
	  <add key="Graph:Scope" value="https://graph.microsoft.com/.default" />
  </appSettings>
