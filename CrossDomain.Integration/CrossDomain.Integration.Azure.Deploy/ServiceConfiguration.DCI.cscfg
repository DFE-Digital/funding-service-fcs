<?xml version="1.0" encoding="utf-8"?>
<ServiceConfiguration serviceName="NSBMultipleHosts.Azure.Deploy" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="6" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="XDomain.Worker">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="" />
      <Setting name="Microsoft.WindowsAzure.Plugins.RemoteForwarder.Enabled" value="true" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="CPDSAuth" thumbprint="1499DEC921EA07682A9D23AB093E80AB1F6209B2" thumbprintAlgorithm="sha1" />
      <Certificate name="DedsAuth" thumbprint="50fd3accced0dedaf9a387a951115b9e0e6db0d3" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
  <NetworkConfiguration>
    <VirtualNetworkSite name="Group fcs-env-shared-rg fcs-env-shared-asm-vnet-01" />
    <AddressAssignments>
      <InstanceAddress roleName="XDomain.Worker">
        <Subnets>
          <Subnet name="default" />
        </Subnets>
      </InstanceAddress>
      <ReservedIPs>
        <ReservedIP name="fct-servicebus-dci-rip" />
      </ReservedIPs>
    </AddressAssignments>
  </NetworkConfiguration>
</ServiceConfiguration>