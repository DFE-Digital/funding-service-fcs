    <ProjectReference Include="..\PaymentManagement.Calculation\PaymentManagement.Calculation.csproj" />
    <ProjectReference Include="..\PaymentManagementDomain.Integration.DataStore\PMD.PolicyCache.DataStore.csproj" />
