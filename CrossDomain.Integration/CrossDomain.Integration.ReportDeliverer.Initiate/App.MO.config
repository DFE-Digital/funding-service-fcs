<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
  </connectionStrings>
  <appSettings>
    <add key="ReportDelivery.FundingTypes" value="[MAIN],AGE1516|[Age],AGE1617|[EOP],EOP1517|[All 24+ Loans],24+ALLB1516,24+ALLBC1516,24+ALLF1516" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="ReportDelivery.ReportName" value="CDAExtract" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>