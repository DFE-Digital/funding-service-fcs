<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="ContractManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentManagementPolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
  </connectionStrings>
  <appSettings>
    <add key="FscEnrichmentUrl" value="https://services-dat.fct-sfa.com/rest/referencedatalookup" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct-dat/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	  <add key="Sharepoint:Oauth:ClientSecret" value="" />
	  <add key="Sharepoint:Oauth:ClientId" value="0c4ab820-e860-4553-ba41-f4cd11f7ad77" />
	  <add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" />
	  <add key="Sharepoint:Oauth:Principle" value="00000003-0000-0ff1-ce00-000000000000" />
    <add key="OrgServiceUrl" value="http://fct-orgservice-dat.fctdev.local/api/v1/organisations/ukprn/" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="ida:ResourceId_CrmOnline" value="https://fcs-dev-at.api.crm4.dynamics.com/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>