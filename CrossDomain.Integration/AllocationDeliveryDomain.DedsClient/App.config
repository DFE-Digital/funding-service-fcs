<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.1" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_IDedsSearchService" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:2659/DedsSearchService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDedsSearchService"
                contract="DedsSearchService.IDedsSearchService" name="BasicHttpBinding_IDedsSearchService" />
        </client>
    </system.serviceModel>

  <appSettings>
    <add key="SearchEndpointConfigurationName" value="BasicHttpBinding_IDedsSearchService"/>
    <add key="SummarisedActualsDataSetCode"  value="SummarisedActuals"/>
    <add key="DateLastRun" value="2014-01-01"/>
    <add key="AcademicYear" value="1415"  />
  </appSettings>
  
</configuration>