<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<connectionStrings>
		<add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="NServiceBus/Persistence" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="PaymentGenerationDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="PaymentManagementPolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="PaymentSchedulePolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="OverrideDateDBContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="MonitoringDeliverablesDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="AllocationDeliveryDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="AllocationDeliveryMonitoringDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="ContractManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="PerformanceManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="ContractCreateDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="ContractRequestDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
		<add name="DocumentsDomainDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
	</connectionStrings>
	<appSettings>
		<add key="FileWatcher.ProcessedFolder" xdt:Transform="Remove" xdt:Locator="Match(key)" />
		<add key="FileWatcher.DropFolder" xdt:Transform="Remove" xdt:Locator="Match(key)" />
		<add key="FileWatcher.FileSearchInterval" value="30" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="BulkUpdate.ContractProcessingTimeoutMins" value="10" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="BulkUpdate.ContractProcessingTimeoutMinimumMins" value="60" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="BulkUpdate.ContractProcessingTimeoutPer100Mins" value="0" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Opa.OutputContainer" value="fct-ops-dci" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="DocumentGeneration.TemplateContainer" value="document-template-dci" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="DocumentGeneration.TargetContainer" xdt:Transform="Remove" xdt:Locator="Match(key)" />
		<add key="FscEnrichmentUrl" value="https://services-dci.fct-sfa.com/rest/referencedatalookup" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct-dci/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Sharepoint:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Sharepoint:Oauth:ClientId" value="4ee738f3-518a-49dc-8f12-7b2e2ce32b6e" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Sharepoint:Oauth:Principle" value="00000003-0000-0ff1-ce00-000000000000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="UseAzureStorageForDocuments" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="UseAzureStorageBulkUpload" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="UpdateOrgSagaTimeoutInMinutes" value="240" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="FileWatcher.ProcessingTable" value="FileWatcherProcessingDCI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="FileWatcher.ProcessedTable" value="FileWatcherProcessedDCI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="BulkUpdate.ProcessingTable" value="BulkUpdateProcessingDCI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="BulkUpdate.LocationMappingTable" value="BulkUpdateLocationMappingDCI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="StorageTableSuffix" value="DCI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="BypassSeedPaymentGenerationReferenceData" value="True" xdt:Transform="Insert" />
		<add key="ReportDelivery.CdaO365Folder" value="CDA Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="ReportDelivery.Username" value="FCTDEV\reportsuser" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="ReportDelivery.Password" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="UseRealDate" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="DeploymentId" value="fct-cdi-dci" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	</appSettings>
	<applicationSettings>
		<SFA.FCT.CrossDomain.Integration.Common.Properties.Settings>
			<setting name="CrossDomain_Integration_Common_ReportExecution2005_ReportExecutionService" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
				<value>http://fct-ci-crm-01.fctdev.local:80/ReportServer/ReportExecution2005.asmx</value>
			</setting>
		</SFA.FCT.CrossDomain.Integration.Common.Properties.Settings>
	</applicationSettings>
	<system.diagnostics>
		<sources>
			<source>
				<listeners>
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='ADMonitoringDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='AllocationDeliveryDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='ContractManagementDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='DocumentsDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='CrossDomain.Integration.Common']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PaymentGenerationDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='CodaAdapterDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='ContractCreateDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='WorkerRole']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='FileWatcher']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='BulkUpload']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='XrmService']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PaymentManagementDomainStartup']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PaymentManagementDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
					<add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PerformanceManagementDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
				</listeners>
			</source>
		</sources>
	</system.diagnostics>
</configuration>