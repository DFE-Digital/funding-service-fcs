    <add key="ReportDelivery.CdaO365Folder" value="CDA Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ReportDelivery.Username" value="FCTDEV\fctmega" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ReportDelivery.Password" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseRealDate" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
  <applicationSettings>
    <SFA.FCT.CrossDomain.Integration.Common.Properties.Settings>
      <setting name="CrossDomain_Integration_Common_ReportExecution2005_ReportExecutionService" serializeAs="String">
