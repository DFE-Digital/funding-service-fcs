    <add key="UpdateOrgSagaTimeoutInMinutes" value="240" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractOperationSagaTimeoutInMinutes" value="60" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FileWatcher.DownloadBufferSize" value="200000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct-dci/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:ClientSecret" value="" />
    <add key="Sharepoint:Oauth:ClientId" value="4ee738f3-518a-49dc-8f12-7b2e2ce32b6e" />
