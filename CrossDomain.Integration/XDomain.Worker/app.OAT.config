<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="NServiceBus/Persistence" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentGenerationDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentManagementPolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentSchedulePolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="OverrideDateDBContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="MonitoringDeliverablesDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="AllocationDeliveryDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="AllocationDeliveryMonitoringDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PerformanceManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractCreateDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractRequestDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="DocumentsDomainDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
  <AzureProfileConfig Profiles="NServiceBus.Development" xdt:Transform="SetAttributes(Profiles)" />
  <AuditConfig QueueName="audit" xdt:Transform="SetAttributes(QueueName)" />
  <MessageForwardingInCaseOfFaultConfig ErrorQueue="error" xdt:Transform="SetAttributes(ErrorQueue)" />
  <RijndaelEncryptionServiceConfig Key="" xdt:Transform="SetAttributes(Profiles)" />
  <AzureServiceBusQueueConfig LockDuration="300000" xdt:Transform="SetAttributes(LockDuration)" />
  <appSettings>
    <add key="DisableNSBLogger" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <!-- FileWatcher / Bulkimport -->
    <!-- Azure File/Folder settings - should not be used in OAT 
    <add key="FileWatcher.ProcessedFolder" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="FileWatcher.DropFolder" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/> -->
    <add key="FileWatcher.DownloadBufferSize" value="200000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FileWatcher.FileSearchInterval" value="30" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FileWatcher.InputFolderO365" value="Input" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FileWatcher.ProcessingFolderO365" value="Processing" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FileWatcher.ProcessedFolderO365" value="Processed" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FileWatcher.ReportsFolderO365" value="Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUpdate.ContractProcessingTimeoutMins" value="10" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUpdate.ContractProcessingTimeoutMinimumMins" value="60" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUpdate.ContractProcessingTimeoutPer100Mins" value="15" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseAzureStorageBulkUpload" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FileWatcher.ProcessingTable" value="FileWatcherProcessing" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FileWatcher.ProcessedTable" value="FileWatcherProcessed" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUpdate.ProcessingTable" value="BulkUpdateProcessing" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUpdate.LocationMappingTable" value="BulkUpdateLocationMapping" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="StorageTableSuffix" value="OAT" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <!-- FSC Service -->
    <add key="FscEnrichmentUrl" value="https://oat-api-services-fcs.education.gov.uk/rest/referencedatalookup" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	  <add key="ida:ClientId_FundingStreamConfig" value="25f8e9f5-a7ab-4857-9c19-0add94785f6f" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	  <add key="ida:AppKey_FundingStreamConfig" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />

	  <add key="ClientSettingsProvider.ServiceUri" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ResourceId_FundingStreamConfig" value="https://fcsazuresfabisgov.onmicrosoft.com/FCS-OAT-contractmanagemenservice" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="ida:ClientId_FundingStreamConfig" value="25f8e9f5-a7ab-4857-9c19-0add94785f6f" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="ida:AppKey_FundingStreamConfig" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />

	  <!-- Document Generation Service -->
    <add key="DocumentGeneration.TemplateContainer" value="document-template-oat" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <!-- Azure File/Folder settings - should not be used in OAT 
    <add key="DocumentGeneration.TargetContainer" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/>-->
    <add key="UseAzureStorageForDocuments" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <!-- Organisation Service -->
    <add key="UpdateOrgSagaTimeoutInMinutes" value="240" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <!-- Team Site -->
    <add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct/fcsoat" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:ClientId" value="4dfd9f55-74cb-49ff-90ac-41e3195edc32" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <!-- Reports -->
    <add key="ReportDelivery.CdaO365Folder" value="CDA Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ReportDelivery.Username" value="FCSPREPROD\SQLReporting" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ReportDelivery.Password" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <!-- DateTime Setting -->
    <add key="UseRealDate" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="RulesEngine.OpaLogPath" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DasEngagements.BaseUrl" value="https://pp-gateway.apprenticeships.education.gov.uk/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DasEngagements.UseStub" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="DasEngagements.SubscriptionKey" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="CPDS:UseStub" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DeploymentId" value="fct-cdi-oat" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseRealDate" value="true" xdt:Transform="Replace" xdt:Locator="Match(key)" />
   <!-- UKRLP values -->
	<add key="UkrlpService:Url" value="https://pp-api.education.gov.uk/preprod-ukrlp-extapi-test1" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:Subscription" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:ClientId" value="1792f928-ec4b-4bf0-a0e1-61e5b395d8e8" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:Scope" value="api://preprod-ukrlp-extapi-test1-1-live_24f37eae-d01f-4aab-98af-b1005e54df87/.default" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:Tenant" value="cc0e4d98-b9f9-4d58-821f-973eb69f19b7" xdt:Transform="Replace" xdt:Locator="Match(key)" />

  </appSettings>
  <system.serviceModel>
    <client>
      <!-- Test Azure CPDS Gateway URL-->
      <endpoint address="https://cpdspp.education.gov.uk/LSC.CPDS.Gateway.Webservice/GatewayService.svc" binding="basicHttpBinding" bindingConfiguration="ClientCertificateTransportSecurity" contract="GatewayServiceContract" name="DefaultEndpoint" behaviorConfiguration="ClientCertificateCredential" xdt:Transform="Replace" xdt:Locator="Match(contract)" />
      <!--<endpoint address="https://cpdspp.education.gov.uk/LSC.CPDS.Gateway.Webservice/GatewayService.svc"
               binding="basicHttpBinding"
               bindingConfiguration="ClientCertificateTransportSecurity"
               contract="GatewayServiceContract"
               name="DefaultEndpoint"
               behaviorConfiguration="ClientCertificateCredential"
               xdt:Transform="Replace"
               xdt:Locator="Match(contract)"/>-->
      <endpoint address="https://exsil.preproddes.fasst.org.uk/RoutingService.svc/ReqRes/DedsSearchService/" binding="wsHttpBinding" bindingConfiguration="WsClientCertificateTransportSecurity" contract="DedsSearchService.IDedsSearchService" name="BasicHttpBinding_IDedsSearchService" behaviorConfiguration="DedsCertificateCredential" xdt:Transform="Replace" xdt:Locator="Match(contract)" />
    </client>
    <bindings>
      <basicHttpBinding>
        <binding name="ClientCertificateTransportSecurity" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="Match(name)">
          <security mode="Transport">
            <transport clientCredentialType="Certificate" />
          </security>
        </binding>
      </basicHttpBinding>
      <wsHttpBinding>
        <binding name="WsClientCertificateTransportSecurity" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="Match(name)">
          <security mode="Transport">
            <transport clientCredentialType="Certificate" />
          </security>
        </binding>
        <binding name="wsHttpEndpoint" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="XPath(/configuration/system.serviceModel/bindings/wsHttpBinding)">
          <security mode="TransportWithMessageCredential">
            <message clientCredentialType="Certificate" />
            <transport clientCredentialType="None" />
          </security>
        </binding>
      </wsHttpBinding>
    </bindings>
    <behaviors xdt:Transform="Insert">
      <endpointBehaviors>
        <behavior name="ClientCertificateCredential">
          <clientCredentials>
			  <clientCertificate findValue="$(fcscpdscertthumbprint)" xdt:Transform="SetAttributes(findValue)" storeName="My" storeLocation="CurrentUser" x509FindType="FindByThumbprint" />
          </clientCredentials>
        </behavior>
        <behavior name="CustomBehavior">
          <clientCredentials>
            <clientCertificate findValue="6585bdec014c12f953e9f365f380ca5bdb96613d" storeName="TrustedPeople" storeLocation="LocalMachine" x509FindType="FindByThumbprint" />
            <serviceCertificate>
              <authentication certificateValidationMode="PeerTrust" />
            </serviceCertificate>
          </clientCredentials>
        </behavior>
        <behavior name="DedsCertificateCredential">
          <clientCredentials>
            <clientCertificate findValue="E65CAABA15453F5BF22D30CFBA33A2F539CFB65F" storeName="My" storeLocation="LocalMachine" x509FindType="FindByThumbprint" />
          </clientCredentials>
        </behavior>
      </endpointBehaviors>
    </behaviors>
  </system.serviceModel>
  <system.diagnostics>
    <sources>
      <source>
        <listeners>
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='ADMonitoringDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='AllocationDeliveryDomain']/listeners/add[@name='DevFabricListener'])" xdt:Transform="Remove" />
