	<ItemGroup>
		<ProjectReference Include="..\..\Common\Tests\Tests.Common\UnitTests.Common.csproj" />
		<ProjectReference Include="..\CrossDomain.Integration.Common\CrossDomain.Integration.Common.csproj" />
		<ProjectReference Include="..\CrossDomain.Integration.Entities\CrossDomain.Integration.Entities.csproj" />
		<ProjectReference Include="..\PerformanceManagementDomain.DataStore\PerformanceManagementDomain.DataStore.csproj" />
		<PackageReference Include="EntityFramework" Version="6.5.1" />
		<PackageReference Include="Moq" Version="4.20.72" />
