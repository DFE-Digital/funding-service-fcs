<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<configSections>
		<sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
			<section name="SFA.FCT.CrossDomain.Integration.Common.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<connectionStrings>
		<add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
	</connectionStrings>
	<appSettings>
		<add key="ReportDelivery.CdaO365Folder" value="CDA Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct-at/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Sharepoint:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Sharepoint:Oauth:ClientId" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="Sharepoint:Oauth:Principle" value="00000003-0000-0ff1-ce00-000000000000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
		<add key="ReportDelivery.Username" value="fctdev\reportsuser" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
		<add key="ReportDelivery.Password" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
	</appSettings>
	<applicationSettings>
		<SFA.FCT.CrossDomain.Integration.Common.Properties.Settings>
			<setting name="CrossDomain_Integration_Common_ReportExecution2005_ReportExecutionService" serializeAs="String" xdt:Transform="Replace"
					 xdt:Locator="Match(name)">
				<value>http://fct-at-crm-01.fctdev.local:80/ReportServer/ReportExecution2005.asmx</value>
			</setting>
		</SFA.FCT.CrossDomain.Integration.Common.Properties.Settings>
	</applicationSettings>
</configuration>