<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <VisualStudioVersion Condition=" '$(VisualStudioVersion)'=='' ">14.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectsToBuild Include="$(MSBuildThisFileDirectory)\CrossDomain.Integration.Azure.WebJobsHostSite\CrossDomain.Integration.Azure.WebJobsHostSite.csproj">
      <AdditionalProperties>
        VisualStudioVersion=$(VisualStudioVersion);
        Configuration=$(Configuration);
        Platform=$(Platform);
        DeployOnBuild=true;
        DeployTarget=WebPublish;
        CreatePackageOnPublish=True;
        PublishProfile=$(MSBuildThisFileDirectory)\CrossDomain.Integration.Azure.WebJobsHostSite\Properties\PublishProfiles\fct-webjobs-$(Configuration).pubxml
      </AdditionalProperties>
    </ProjectsToBuild>
  </ItemGroup>

  <Target Name="Build">
    <MSBuild Projects="@(ProjectsToBuild)" />
  </Target>
</Project>