<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Library</OutputType>

		<IsTestProject>true</IsTestProject>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<AssemblyTitle>OrganisationDomain.Integration.DataStore.Tests</AssemblyTitle>
		<Product>OrganisationDomain.Integration.DataStore.Tests</Product>

		<Configurations>
			Debug;Release;AT;CI;DAT;DCI;DebugCI;DEV;DMO;DOAT;MO;OAT;PP-OAT;PS;PUB
		</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='DCI|AnyCPU'">
		<OutputPath>bin\DCI\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='CI|AnyCPU'">
		<OutputPath>bin\CI\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='MO|AnyCPU'">
		<OutputPath>bin\MO\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.2.1" />
		<PackageReference Include="MSTest.TestFramework" Version="4.2.1" />

		<PackageReference Include="EntityFramework" Version="6.5.2" />
		<PackageReference Include="MoreLinq" Version="4.4.0" />
		<PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />

		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="FluentAssertions" Version="8.8.0" />

		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\OrganisationDomain.Implementation\OrganisationDomain.Implementation.csproj" />
		<ProjectReference Include="..\OrganisationDomain.Integration.DataStore\OrganisationDomain.Integration.DataStore.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="App.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Update="App.CI.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Update="App.DCI.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<None Update="App.Debug.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
