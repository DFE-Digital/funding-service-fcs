<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
  </connectionStrings>
  <appSettings>
    <add key="ShouldSendInitiateRoatpUpdateCommand" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
  </appSettings>
</configuration>