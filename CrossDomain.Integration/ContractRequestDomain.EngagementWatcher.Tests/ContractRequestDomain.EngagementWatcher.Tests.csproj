    <AssemblyTitle>ContractRequestDomain.EngagementWatcher.Tests</AssemblyTitle>
    <Company>Capgemini</Company>
    <Product>ContractRequestDomain.EngagementWatcher.Tests</Product>
    <Copyright>Copyright © Capgemini 2016</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'CI|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\CI\</OutputPath>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'AT|AnyCPU'">
    <OutputPath>bin\AT\</OutputPath>
    <Optimize>true</Optimize>
