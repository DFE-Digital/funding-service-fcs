<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="StorageTableSuffix" value="DCI" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
  <connectionStrings>
    <add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="MonitoringDeliverablesDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="NServiceBus/Persistence" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="OverrideDateDBContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentSchedulePolicyContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentManagementPolicyContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="AllocationDeliveryDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
  <system.serviceModel>
    <client>
      <endpoint address="https://fct-mocks-dci.fct-sfa.com/DedsSearchService.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDedsSearchService" contract="DedsSearchService.IDedsSearchService" name="BasicHttpBinding_IDedsSearchService" xdt:Transform="Replace" xdt:Locator="Match(contract)" />
    </client>
  </system.serviceModel>
</configuration>