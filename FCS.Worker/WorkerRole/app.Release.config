<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="StorageTableSuffix" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="UseRealDate" value="true" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ResourceId_FundingStreamConfig" value="https://fcsazuresfabisgovuk.onmicrosoft.com/FCS-PROD-contractmanagementservice" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="FscEnrichmentUrl" value="https://api-services-fcs.education.gov.uk/rest/referencedatalookup" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
	<add key="ida:ClientId_FundingStreamConfig" value="72448303-8df1-4979-8ddf-a49bc0ff03b3" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="ida:AppKey_FundingStreamConfig" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />

	  <add key="OrgServiceUrl" value="https://api-org-fcs.education.gov.uk/api/v1/organisations/ukprn/" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="ida:ClientId_OrgService" value="692d5b66-e56a-43f4-9d8a-e6b624467b74" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="ida:AppKey_OrgService" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/> <!-- client secret -->
    <add key="ida:ResourceId_OrgService" value="https://fcsazuresfabisgov.onmicrosoft.com/FCS-PROD-OrgServiceService" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="CPDS:UseStub" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />

	  <!-- UkrlpService:Url and credential should be set to Production as its set as of now as preprod https://api.ukrlp.co.uk/preprod-ukrlp-extapi-test1 -->
	<add key="UkrlpService:Url" value="https://api.education.gov.uk/ukrlp" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:Subscription" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:ClientId" value="69f8c922-c6d8-477b-8638-c241aca977b5" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:Scope" value="api://ukrlp-1-live_d34faf29-8151-4d69-9174-503edc1fd0e7/.default" xdt:Transform="Replace" xdt:Locator="Match(key)" />
	<add key="UkrlpApi:Tenant" value="459e2362-5f23-45bc-a0c0-4c4211bbdc0d" xdt:Transform="Replace" xdt:Locator="Match(key)" />

	  <add key="ida:Resource" value="https://educationgovuk.sharepoint.com/sites/fct/FCS" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Sharepoint:Oauth:Tenant" value="fad277c9-c60a-4da1-b5f3-b3b8b34a82f9" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="Sharepoint:Oauth:ClientId" value="36b10969-f5c2-4aef-8a22-da71016b416f" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="Sharepoint:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="SlackError:ShouldSend" value="true" xdt:Transform="Replace" xdt:Locator="Match(key)" />

    <add key="ida:ClientId_CrmOnline" value="63025c8f-22ad-4655-bb24-1b43731bb796" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="ida:AppKey_CrmOnline" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="ida:ResourceId_CrmOnline" value="https://fcs.api.crm4.dynamics.com" xdt:Transform="Replace" xdt:Locator="Match(key)"/>

    <add key="DCT:UseStub" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DCT:PageSize" value="10000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DCT:Url" value="https://api-summarisedactuals.submitlearnerdatabeta.fasst.org.uk" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="DCT:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="DCT:Oauth:ClientId" value="4ffd25c2-e3ff-4ecd-ad9c-26f0124cb608" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="DCT:Oauth:Scope" value="api://8c27edec-aaa9-49dc-8957-b89bc4d8ae5d/.default" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
    <add key="DCT:Oauth:Tenant" value="3aacc835-4b83-483d-841d-cd787f6f1486" xdt:Transform="Replace" xdt:Locator="Match(key)"/>

    <add key="DCT:FundingClaims:UseStub" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DCT:FundingClaims:Url" value="https://api-fundingclaims.submitlearnerdatabeta.fasst.org.uk" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DCT:FundingClaims:Oauth:ClientId" value="dff80a63-6f3c-4246-a13b-973a84d909cd" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DCT:FundingClaims:Oauth:Scope" value="api://75006943-a8b7-45b0-9000-db4c42e9763c/.default" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DCT:FundingClaims:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DCT:FundingClaims:Oauth:Tenant" value="3aacc835-4b83-483d-841d-cd787f6f1486" xdt:Transform="Replace" xdt:Locator="Match(key)" />

    <add key="DeploymentId" value="fcs-worker-release" xdt:Transform="Replace" xdt:Locator="Match(key)"/>
  </appSettings>
  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="NServiceBus/Persistence" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="PaymentGenerationDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="PaymentManagementPolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="PaymentSchedulePolicyContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)"/>
    <add name="OverrideDateDBContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="MonitoringDeliverablesDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="AllocationDeliveryDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="AllocationDeliveryMonitoringDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PerformanceManagementDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractCreateDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="ContractRequestDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="DocumentsDomainDbContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
	<system.serviceModel>

		<client>
			<endpoint address="https://cpds.education.gov.uk/LSC.CPDS.Gateway.Webservice/GatewayService.svc"
					  binding="basicHttpBinding"
					  bindingConfiguration="ClientCertificateTransportSecurity"
					  contract="GatewayServiceContract"
					  name="DefaultEndpoint"
					  behaviorConfiguration="ClientCertificateCredential"
					  xdt:Transform="Replace"
					  xdt:Locator="Match(contract)"/>
		</client>

		<bindings>
			<basicHttpBinding>
				<binding name="ClientCertificateTransportSecurity" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="Match(name)"  >
					<security mode="Transport" >
						<transport clientCredentialType="Certificate" />
					</security>
				</binding>
			</basicHttpBinding>
			<wsHttpBinding>
				<binding name="WsClientCertificateTransportSecurity" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="Match(name)">
					<security mode="Transport">
						<transport clientCredentialType="Certificate" />
					</security>
				</binding>
				<binding name="wsHttpEndpoint" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" xdt:Transform="Insert" xdt:Locator="XPath(/configuration/system.serviceModel/bindings/wsHttpBinding)" >
					<security mode="TransportWithMessageCredential" >
						<message clientCredentialType="Certificate" />
						<transport clientCredentialType="None"/>
					</security>
				</binding>
			</wsHttpBinding>
		</bindings>

		<behaviors xdt:Transform="Insert" >
			<endpointBehaviors>
				<behavior name="ClientCertificateCredential" >
					<clientCredentials>
						<clientCertificate findValue="$(fcscpdscertthumbprint)" xdt:Transform="SetAttributes(findValue)" storeName="My" storeLocation="CurrentUser" x509FindType="FindByThumbprint" />
					</clientCredentials>
				</behavior>
				<behavior name="CustomBehavior">
					<clientCredentials>
						<clientCertificate findValue="6585bdec014c12f953e9f365f380ca5bdb96613d" storeName="TrustedPeople"
							x509FindType="FindByThumbprint" />
						<serviceCertificate>
							<authentication certificateValidationMode="PeerTrust" />
						</serviceCertificate>
					</clientCredentials>
				</behavior>
			</endpointBehaviors>
		</behaviors>

	</system.serviceModel>
  <system.diagnostics>
    <sources>
      <source>
        <listeners>
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='WorkerRole']/listeners/add[@name='DevFabricListener'])"
               xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='AllocationDeliveryDomain']/listeners/add[@name='DevFabricListener'])"
               xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PaymentGenerationDomain']/listeners/add[@name='DevFabricListener'])"
               xdt:Transform="Remove" />
          <add xdt:Locator="XPath(/configuration/system.diagnostics/sources/source[@name='PaymentManagementDomain']/listeners/add[@name='DevFabricListener'])"
               xdt:Transform="Remove" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
</configuration>