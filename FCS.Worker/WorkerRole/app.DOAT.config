	<add key="DCT:FundingClaims:Oauth:Scope" value="api://d5c2ca13-7d37-4886-92ea-c6dc61855cc3/.default" xdt:Transform="Replace" xdt:Locator="Match(key)" />  
	<add key="DCT:FundingClaims:Oauth:ClientSecret" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />  
