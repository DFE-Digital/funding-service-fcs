		<IsTestProject>true</IsTestProject>

		<RootNamespace>ContractManagementDomain.Endpoint.Xrm.Tests</RootNamespace>
		<AssemblyName>ContractManagementDomain.Endpoint.Xrm.Tests</AssemblyName>

		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<Configurations>Debug;Release;AT;CI;DAT;DCI;DMO;DOAT;MO</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
