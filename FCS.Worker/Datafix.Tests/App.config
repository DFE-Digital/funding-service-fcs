<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <section name="AzureServiceBusQueueConfig" type="NServiceBus.Config.AzureServiceBusQueueConfig, NServiceBus.Azure.Transports.WindowsAzureServiceBus" />
    <section name="MessageForwardingInCaseOfFaultConfig" type="NServiceBus.Config.MessageForwardingInCaseOfFaultConfig, NServiceBus.Core" />
  </configSections>
  <AzureServiceBusQueueConfig ConnectivityMode="Http" />
  <MessageForwardingInCaseOfFaultConfig ErrorQueue="error" />
  <connectionStrings>
    <add name="NServiceBus/Transport" connectionString="" />
    <add name="NServiceBus/Persistence" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <!-- this is the Azure blob storage connection needed by DocumentsDomain.DocumentGeneration as the storage location for templates and documents -->
    <add name="StorageConnectionString" connectionString="UseDevelopmentStorage=true;" />
    <add name="organisationDomainDatabaseOld" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="organisationDomainDatabase" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PaymentGenerationDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PaymentManagementPolicyContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PaymentSchedulePolicyContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="OverrideDateDBContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="MonitoringDeliverablesDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="AllocationDeliveryDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="AllocationDeliveryMonitoringDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="ContractManagementDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="PerformanceManagementDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="ContractRequestDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="DocumentsDomainDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="CrmDatabaseConnectionString" connectionString="" providerName="System.Data.SqlClient" />
    <add name="OperationsDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
    <contexts>
      <context type="PaymentGenerationDomain.Integration.DataStore.PaymentGenerationDbContext, PaymentGenerationDomain.Integration.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.PaymentManagementDomain.PolicyCache.DataStore.PaymentManagementPolicyContext, PaymentManagementDomain.PolicyCache.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.PaymentManagementDomain.PaymentSchedule.DataStore.PaymentSchedulePolicyContext, PaymentManagementDomain.PaymentSchedule.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.CrossDomain.Integration.OverrideDate.OverrideDateDBContext, CrossDomain.Integration.OverrideDate.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.AllocationDeliveryDomain.Common.DataStore.MonitoringDeliverablesDbContext, AllocationDeliveryDomain.Common" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.AllocationDelivery.DataStore.AllocationDeliveryDbContext, AllocationDelivery.DataStore" disableDatabaseInitialization="true" />
      <context type="ADMonitoringDomain.DataStore.AllocationDeliveryMonitoringDbContext, ADMonitoringDomain.DataStore" disableDatabaseInitialization="true" />
      <context type="ContractManagement.DataStore.ContractManagementDbContext, ContractManagement.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.PerformanceManagementDomain.DataStore.PerformanceManagementDbContext, PerformanceManagementDomain.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.ContractRequestDomain.DataStore.ContractRequestDbContext, ContractRequestDomain.DataStore" disableDatabaseInitialization="true" />
      <context type="SFA.FCT.DocumentsDomain.DataStore.DocumentsDomainDbContext, DocumentsDomain.DataStore" disableDatabaseInitialization="true" />
      <context type="OrganisationDomain.Integration.DataStore.OrganisationDomainDbContext, OrganisationDomain.Integration.DataStore" disableDatabaseInitialization="true" />
    </contexts>
  </entityFramework>
