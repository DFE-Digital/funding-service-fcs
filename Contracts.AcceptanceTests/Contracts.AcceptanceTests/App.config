  <Logging Threshold="Error" />
  <TransportConfig MaximumConcurrencyLevel="1" MaxRetries="0" />
  <SecondLevelRetriesConfig Enabled="false" />
  <MessageForwardingInCaseOfFaultConfig ErrorQueue="error" />
