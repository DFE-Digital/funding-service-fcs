<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="Microsoft.ServiceBus.ConnectionString" value="Endpoint=sb://nservicebus-dev.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:TenantID" value="dhays" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:ClientID" value="e866b286-cec8-4b20-ac52-7cb7204cbcfe" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:UserName" value="FCT-DEV-SVC@SkillsFundingAgency.onmicrosoft.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:UserPassword" value="" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ida:Resource" value="https://skillsfundingagency.sharepoint.com/sites/partners/sfafcsdevelopment/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DocumentGeneration.TargetContainer" value="document-io-dev" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="NServiceBus.UseTransport" value="AzureServiceBus" xdt:Transform="Insert" />
    <add key="FileWatcher.DownloadBufferSize" value="200000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseAzureStorageForDocuments" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseAzureStorageBulkUpload" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FscEnrichmentUrl" value="https://fsc-at.fct-sfa.com/rest/referencedatalookup" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="RolesMappingDoc" value="ConfigurationFiles\RoleMapping.xml" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrgServiceFileShare" value="\\server\share" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUploadFolder" value="bulkupload-in-dev" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUploadOutputFolder" value="bulkupload-out-dev" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganisationServiceUri" value="http://fct-orgservice-at.cloudapp.net/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DownloadSolution" value="true" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="InitOrganisationUpdateQueue" value="OrgService.Main" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Office365BulkUploadFolder" value="Input" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Office365BulkUploadOutputFolder" value="Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="PaymentGateway.FileSharePath" value="c:\" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="PaymentGateway.CsvDelimiter" value="," />
    <add key="ReportViewerUrl" value="http://fct-crm-dev-01.cloudapp.net/ReportServer/Pages/ReportViewer.aspx?" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="CdaReportFileSharePath" value="C:\Temp\" xdt:Transform="Replace" xdt:Locator="Match(key)" />
  </appSettings>
  <connectionStrings>
    <add name="StorageConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Insert" />
  </connectionStrings>
  <TransportConfig xdt:Transform="Remove" match="XPath(/configuration/TransportConfig)" />
  <SecondLevelRetriesConfig xdt:Transform="Remove" match="XPath(/configuration/SecondLevelRetriesConfig)" />
  <UnicastBusConfig>
    <MessageEndpointMappings>
      <add Assembly="CrossDomain.Integration.Messages" Type="SFA.FCT.CrossDomain.Integration.Messages.Commands.DocumentGenerationCommand" Endpoint="DocumentsDomain.GenerateDocument" xdt:Transform="Replace" xdt:Locator="Match(Type)" />
    </MessageEndpointMappings>
  </UnicastBusConfig>
</configuration>