  <TransportConfig xdt:Transform="Remove" match="XPath(/configuration/TransportConfig)" />
  <SecondLevelRetriesConfig xdt:Transform="Remove" match="XPath(/configuration/SecondLevelRetriesConfig)" />
  <UnicastBusConfig>
    <MessageEndpointMappings>
      <add Assembly="CrossDomain.Integration.Messages" Type="SFA.FCT.CrossDomain.Integration.Messages.Commands.DocumentGenerationCommand" Endpoint="DocumentsDomain.GenerateDocument" xdt:Transform="Replace" xdt:Locator="Match(Type)" />
