    <add name="CrmConnectionString_HelenBose" connectionString="Url=http://fct-at-crm-01.fctdev.local/AcceptancetestDev; Timeout=00:10:00; Domain=fctdev; Username=BoseH; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="CrmConnectionString_GregoryShaw" connectionString="Url=http://fct-at-crm-01.fctdev.local/AcceptancetestDev; Timeout=00:10:00; Domain=fctdev; Username=ShawG; Password=" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="NServiceBus/Transport" connectionString="" xdt:Transform="Insert" />
    <add name="organisationDomainDatabase" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentGenerationDbContext" providerName="System.Data.SqlClient" connectionString="" xdt:Transform="Replace" xdt:Locator="Match(name)" />
    <add name="PaymentSchedulePolicyContext" connectionString="" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
