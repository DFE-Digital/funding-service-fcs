    <add key="ida:Resource" value="https://skillsfundingagency.sharepoint.com/sites/partners/sfafcsdat/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DocumentGeneration.TargetContainer" xdt:Transform="Remove" xdt:Locator="Match(key)" />
    <add key="NServiceBus.UseTransport" value="AzureServiceBus" xdt:Transform="Insert" />
    <add key="FileWatcher.DownloadBufferSize" value="200000" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseAzureStorageForDocuments" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="UseAzureStorageBulkUpload" value="false" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FscEnrichmentUrl" value="https://services-dat.fct-sfa.com/rest/referencedatalookup" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="RolesMappingDoc" value="ConfigurationFiles\RoleMapping.xml" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrgServiceFileShare" value="\\server\share" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUploadFolder" value="bulkupload-in-at" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BulkUploadOutputFolder" value="bulkupload-out-at" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="OrganisationServiceUri" value="http://fct-orgservice-dat.fctdev.local/" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="DownloadSolution" value="True" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="InitOrganisationUpdateQueue" value="OrgService.Main" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Office365BulkUploadFolder" value="Input" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="Office365BulkUploadOutputFolder" value="Reports" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="PaymentGateway.FileSharePath" value="\\10.1.1.40\PTSShare\DAT\" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ContractManagementServiceUrl" value="https://services-dat.fct-sfa.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="BypassSeedPaymentGenerationReferenceData" value="True" xdt:Transform="Insert" />
    <add key="StorageTableSuffix" value="DAT" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="FscAtomFeedHost" value="https://services-dat.fct-sfa.com" xdt:Transform="Replace" xdt:Locator="Match(key)" />
    <add key="ReportViewerUrl" value="http://fct-at-crm-01.fctdev.local/ReportServer/Pages/ReportViewer.aspx?" xdt:Transform="Replace" xdt:Locator="Match(key)" />
