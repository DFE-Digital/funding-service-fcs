<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
  <section name="specFlow" type="TechTalk.SpecFlow.Configuration.ConfigurationSectionHandler, TechTalk.SpecFlow"/></configSections>
  <connectionStrings>
    <add name="MonitoringDeliverablesDbContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=true" providerName="System.Data.SqlClient"/>
    <add name="PerformanceManagementDbContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient"/>
    <add name="PaymentSchedulePolicyContext" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient"/>
    <add name="PaymentManagementPolicyContext" connectionString="Data Source=(localdb)\mssqllocaldb;Initial Catalog=fct-database;Integrated Security=True;" providerName="System.Data.SqlClient"/>
    <add name="OverrideDateDBContext" connectionString="Data Source=localhost;Initial Catalog=fct-database-debug;Integrated Security=True;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="UseRealDate" value="false"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.LocalDbConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="mssqllocaldb"/>
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer"/>
    </providers>
    <contexts>
      <context type="SFA.FCT.AllocationDeliveryDomain.Common.DataStore.MonitoringDeliverablesDbContext, AllocationDeliveryDomain.Common" disableDatabaseInitialization="true"/>
      <context type="SFA.FCT.PaymentManagementDomain.PaymentSchedule.DataStore.PaymentSchedulePolicyContext, PaymentManagementDomain.PaymentSchedule.DataStore" disableDatabaseInitialization="true"/>
      <context type="SFA.FCT.PaymentManagementDomain.PolicyCache.DataStore.PaymentManagementPolicyContext, PaymentManagementDomain.PolicyCache.DataStore" disableDatabaseInitialization="true"/>
      <context type="SFA.FCT.CrossDomain.Integration.OverrideDate.OverrideDateDBContext, CrossDomain.Integration.OverrideDate.DataStore" disableDatabaseInitialization="true"/>
    </contexts>
  </entityFramework>
  <runtime>
