  <appSettings>
    <!---<add key="ContractManagementServiceUrl" value="http://?todo?.cloudapp.net" />-->
    <add key="ContractManagementServiceUrl" value="http://localhost:45109" />
    
    <!-- Azure AD Settings -->
    <add key="ida:Tenant" value="fcsazuresfabisgov.onmicrosoft.com" />
    <add key="ida:ClientId" value="8ce1a821-9d0e-474b-84ed-19c6d982720e" />
    <add key="ida:AppKey" value="" />
