<?xml version="1.0" encoding="utf-8" ?>
<!-- For more information on using transformations 
     see the web.config examples at http://go.microsoft.com/fwlink/?LinkId=214134. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <applicationSettings>
    <FCTCrmConfig.AcceptanceTests.Properties.Settings>
      <setting name="SolutionExportPackagePath" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value>C:\temp</value>
      </setting>
      <setting name="CrmAcceptanceTestConnectionString" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value></value>
      </setting>
      <setting name="CrmUnitTestConnectionString" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value></value>
      </setting>
      <setting name="DownloadSolution" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value>True</value>
      </setting>
      <setting name="CrmAcceptanceTestConnectionString_ContractAdviser"
          serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value></value>
      </setting>
      <setting name="RolesMappingDoc" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value>RoleMapping.xml</value>
      </setting>
      <setting name="SolutionPackagePath" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value>c:\temp\default</value>
      </setting>
      <setting name="AcceptanceTestMode" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value>False</value>
      </setting>
      <setting name="DownloadSolution" serializeAs="String" xdt:Transform="Replace" xdt:Locator="Match(name)">
        <value>False</value>
      </setting>
    </FCTCrmConfig.AcceptanceTests.Properties.Settings>
  </applicationSettings>
</configuration>